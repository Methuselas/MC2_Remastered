      "asset_class": "building",
      "source": {
        "ase": "A:/Games/mc2-opengl-src/mc2srcdata/tgl/quonset.ase",
        "ini": "A:/Games/mc2-opengl-src/mc2srcdata/tgl/quonset.ini"
      },
      "params": {"subdiv": 1, "crease_angle": 40.0},
      "out": {"kind": "tgl_ini", "dir": "out/quonset", "source_name": "QuonsetHD"}
