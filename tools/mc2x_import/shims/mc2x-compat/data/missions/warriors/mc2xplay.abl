function Init;

    	code
        		#include_ "UBInit.abi"

If (wmxid == 4713) then
		 FreeWillMode = STOPPED;
else
		FreeWillMode = NORMAL;
endif;
		PlayerTarget = 0;
        
		IdentifySensorContactsOFF;
		MoveToEngageOFF;
		SetCurrentTargetMod(3.0);
		SetConcentrateFireMod(1.5);
		SetEngageRadius(400.0);			//wolfman(R37)
		SetDisengageRadius(400.0);	//wolfman(R37)
		SetGuardMod(50.0);	// 10
		SetSpeed(RUN);
		SetNotTargetingMod(0.0);

		KludgeHandleGuard = FALSE;
		KludgePlayerTarget = FALSE;
		StopCounter = 0;
		StopTime = 0.0;
		lastHelpRequestTime = -100.0;
		returnState = RETURN_STATE_FALSE;
		returnPosition[0] = 0.0;
		returnPosition[1] = 0.0;
		
