//==================================================================

function handlePlayerOrder;

	var

		integer			numTriggers;
		IntList			triggers;
		integer			ObjClass;
		position		dapoint;

	code

		//assert(false,86,"HandlePlayerOrder");
		numTriggers = getAlarmTriggers(triggers);
		CurTacCode = triggers[0];
		print("Got Order");
		Print(CurTacCode);
		Me = GetId;

		setIntegerMemory(I_MOVE_STATUS,NOT_MOVING);

	If (wmxid == 4713) then
		 FreeWillMode = STOPPED;
	else
		FreeWillMode = NORMAL;
	endif;
//		KludgePlayerTarget = FALSE;
		KludgeHandleGuard = FALSE;

		returnState = RETURN_STATE_FALSE;

		switch (CurTacCode)

		case TACTICAL_ORDER_ATTACK_OBJECT :

				KludgePlayerTarget = TRUE;
				
		endcase;
				

		case TACTICAL_ORDER_GUARD :

				KludgeHandleGuard = TRUE;
				PlayerTarget = 0;

				if (StopCounter > 5) then
					dapoint[0] = 0.0;
					dapoint[1] = 0.0;
					dapoint[2] = 0.0;
					setRevealed(objectside(Me),10000.0,dapoint);
					StopCounter = 0;
				endif;

		endcase;

		case TACTICAL_ORDER_STOP :

			
			If (wmxid == 4713) then
				 FreeWillMode = STOPPED;
			else
				FreeWillMode = NORMAL;
			endif;

				SetTarget(Me,0);
				PlayerTarget = 0;
				if (gettime - 1.0 < StopTime) then
					print("Got it.");
					print(StopCounter);
					StopCounter = StopCounter + 1;
				else
					StopCounter = 1;
					StopTime = gettime;
				endif;


		endcase;

		case TACTICAL_ORDER_HOLD_FIRE :

			If (wmxid == 4713) then
				 FreeWillMode = STOPPED;
			else
				FreeWillMode = NORMAL;
			endif;

				SetTarget(Me,0);
				PlayerTarget = 0;
				print("HoldFire");
				if (gettime - 1.0 < StopTime) then
					print("Got it.");
					print(StopCounter);
					StopCounter = StopCounter + 1;
				else
					StopCounter = 1;
					StopTime = gettime;
				endif;


		endcase;

		endswitch;

		if (CurTacCode <> TACTICAL_ORDER_GUARD) then
			SetEngageRadius(400.0);			//wolfman(R37)
			SetDisengageRadius(400.0);	//wolfman(R37)
			SetNotTargetingMod(0.0);
			SetSpeed(WALK);
		endif;

		// if I get an order from the player, assume the player is happy with my target selection
		if ((CurTacCode <> TACTICAL_ORDER_ATTACK_OBJECT) AND (getTarget(CUR_OBJECT_ID) > 0)) then
			PlayerTarget = getTarget(Me);
		endif;

endfunction;

//==================================================================
// Main Code
//==================================================================

	code

   		  initOrders;

		debugS = "retPos: (";
		concat(debugS, returnPosition[0]);
		concat(debugS, ",");
		concat(debugS, returnPosition[1]);
		concat(debugS, ") ");
		if (returnState == RETURN_STATE_FALSE) then
			concat(debugS, "--");
		else
			if (returnState == RETURN_STATE_TRUE) then
				concat(debugS, "TR ");
			else
				concat(debugS, "!! ");
			endif;
			distanceToReturnPosition = distanceToPosition(-1, returnPosition);
			concat (debugS, distanceToReturnPosition);
		endif;
		setDebugString(-1, 4, debugS);

//====================================================================	
if ((wmxid == 4712) OR (wmxid ==4717)) then
	getObjectPosition(-1, curryPosition);
	if (curryposition[2]< -200) then
		playWave("data\sound\systemalert.WAV",-1);	
		curTime = getTime;
		PUpTime 	= True;
		if ((PUpTime) and (PUDelay == -1)) then
			PUDelay = getTime + rwPUStartWait;
		endif;
		if (PUDelay > 0) and (getTime > PUDelay) then
			coreEject;	
		//	corePower(false);				
		endif;
	endif;
	if (curryposition[2]> -200) then
		PUpTime 	= False;
		PUDelay = -1;
	endif;	
endif;
//====================================================================	
if (wmxid == 4720) then
	myBR = getCurrentBRValue(CUR_OBJECT_ID);
	if (myBR < 9999) then
		getObjectPosition(-1, curryPosition);
		if (curryposition[2]< 250) then
			playWave("data\sound\systemalert.WAV",-1);	
			curTime = getTime;
			PUpTime 	= True;
			if ((PUpTime) and (PUDelay == -1)) then
				PUDelay = getTime + rwPUStartWait;
			endif;
			if (PUDelay > 0) and (getTime > PUDelay) then
				coreEject;	
			//	corePower(false);				
			endif;
		endif;
		if (curryposition[2]> 250) then
			PUpTime 	= False;
			PUDelay = -1;
		endif;
	endif;		
endif;
//====================================================================	
if (wmxid == 4719) then
	getObjectPosition(-1, curryPosition);
	if (curryposition[2]<=0) then
		playWave("data\sound\systemalert.WAV",-1);	
		curTime = getTime;
		PUpTime 	= True;
		if ((PUpTime) and (PUDelay == -1)) then
			PUDelay = getTime + rwPUStartWait;
		endif;
		if (PUDelay > 0) and (getTime > PUDelay) then
			coreEject;	
		//	corePower(false);				
		endif;
	endif;
	if (curryposition[2]>0) then
		PUpTime 	= False;
		PUDelay = -1;
	endif;	
endif;
//====================================================================	
if (wmxid == 4721) then
	if ((distancetoObject(Me,BobjectID) < 20.0) AND waitover AND (objectside(BobjectID) == PLAYER_FORCE) AND (getobjectdamage(BobjectID) < 100) AND (getobjectdamage(BgenID) < 100) AND (objectside(CobjectID) == PLAYER_FORCE) AND (getobjectdamage(CobjectID) < 100) AND (getobjectdamage(CgenID) < 100)) then
		OrderWait(0.0,TRUE);
		teleporttopoint(Me, CSpot);
		playWave("data\sound\teleport.WAV",-1);	
		waitover = FALSE;
	endif;

	if ((distancetoObject(Me,AobjectID) < 20.0) AND waitover AND (objectside(AobjectID) == PLAYER_FORCE) AND (getobjectdamage(AobjectID) < 100) AND (getobjectdamage(AgenID) < 100) AND (objectside(DobjectID) == PLAYER_FORCE) AND (getobjectdamage(DobjectID) < 100) AND (getobjectdamage(DgenID) < 100)) then
		OrderWait(0.0,TRUE);
		teleporttopoint(Me, DSpot);
		playWave("data\sound\teleport.WAV",-1);	
		waitover = FALSE;
	endif;

		if ((distancetoObject(Me,DobjectID) < 20.0) AND waitover AND (objectside(DobjectID) == PLAYER_FORCE) AND (getobjectdamage(DobjectID) < 100) AND (getobjectdamage(DgenID) < 100) AND (objectside(AobjectID) == PLAYER_FORCE) AND (getobjectdamage(AobjectID) < 100) AND (getobjectdamage(AgenID) < 100)) then
		OrderWait(0.0,TRUE);
		teleporttopoint(Me, ASpot);
		playWave("data\sound\teleport.WAV",-1);	
		waitover = FALSE;
	endif;

	if ((distancetoObject(Me,CobjectID) < 20.0) AND waitover AND (objectside(CobjectID) == PLAYER_FORCE) AND (getobjectdamage(CobjectID) < 100) AND (getobjectdamage(CgenID) < 100) AND (objectside(BobjectID) == PLAYER_FORCE)  AND (getobjectdamage(BobjectID) < 100) AND (getobjectdamage(BgenID) < 100)) then
		OrderWait(0.0,TRUE);
		teleporttopoint(Me, BSpot);
		playWave("data\sound\teleport.WAV",-1);	
		waitover = FALSE;
	endif;

	if ((distancetoObject(Me,EobjectID) < 20.0) AND waitover AND (objectside(EobjectID) == PLAYER_FORCE) AND (getobjectdamage(EobjectID) < 100) AND (getobjectdamage(EgenID) < 100) AND (objectside(FobjectID) == PLAYER_FORCE)  AND (getobjectdamage(FobjectID) < 100) AND (getobjectdamage(FgenID) < 100)) then
		OrderWait(0.0,TRUE);
		teleporttopoint(Me, FSpot);
		playWave("data\sound\teleport.WAV",-1);	
		waitover = FALSE;
	endif;
	if ((distancetoObject(Me,FobjectID) < 20.0) AND waitover AND (objectside(FobjectID) == PLAYER_FORCE) AND (getobjectdamage(FobjectID) < 100) AND (getobjectdamage(FgenID) < 100) AND (objectside(EobjectID) == PLAYER_FORCE)  AND (getobjectdamage(EobjectID) < 100) AND (getobjectdamage(EgenID) < 100)) then
		OrderWait(0.0,TRUE);
		teleporttopoint(Me, ESpot);
		playWave("data\sound\teleport.WAV",-1);	
		waitover = FALSE;
	endif;	

	
	if(waitover == FALSE) then	
		curTime = getTime;
		PUpTime 	= True;
		if ((PUpTime) and (PUDelay == -1)) then
				PUDelay = getTime + rwPUStartWait;
		endif;
		if (PUDelay > 0) and (getTime > PUDelay) then
			waitover = TRUE;
			PUpTime 	= False;
			PUDelay = -1;
		endif;
	endif;
	
	If  (objectside(AobjectID) == PLAYER_FORCE) AND (objectside(DobjectID) == CLAN_FORCE) then
		objectchangesides(DobjectID, 0);
	endif;
	If  (objectside(BobjectID) == PLAYER_FORCE) AND (objectside(CobjectID) == CLAN_FORCE) then
		objectchangesides(CobjectID, 0);	
	endif;
	If  (objectside(CobjectID) == PLAYER_FORCE) AND (objectside(BobjectID) == CLAN_FORCE) then
		objectchangesides(BobjectID, 0);	
	endif;
	If  (objectside(DobjectID) == PLAYER_FORCE) AND (objectside(AobjectID) == CLAN_FORCE) then
	objectchangesides(AobjectID, 0);
	endif;
		If  (objectside(EobjectID) == PLAYER_FORCE) AND (objectside(FobjectID) == CLAN_FORCE) then
		objectchangesides(FobjectID, 0);	
	endif;
	If  (objectside(FobjectID) == PLAYER_FORCE) AND (objectside(EobjectID) == CLAN_FORCE) then
	objectchangesides(EobjectID, 0);
	endif;		
	
endif;
//====================================================================	

//====================================================================	
if (wmxid == 4722) then
	if ((distancetoObject(Me,BobjectID) < 20.0) AND waitover AND (objectside(BobjectID) == PLAYER_FORCE) AND (getobjectdamage(BobjectID) < 100) AND (getobjectdamage(BgenID) < 100) AND (objectside(AobjectID) == PLAYER_FORCE) AND (getobjectdamage(AobjectID) < 100) AND (getobjectdamage(AgenID) < 100)) then
		OrderWait(0.0,TRUE);
		teleporttopoint(Me, ASpot);
		playWave("data\sound\teleport.WAV",-1);	
		waitover = FALSE;
	endif;


	if ((distancetoObject(Me,AobjectID) < 20.0) AND waitover AND (objectside(AobjectID) == PLAYER_FORCE) AND (getobjectdamage(AobjectID) < 100) AND (getobjectdamage(AgenID) < 100) AND (objectside(BobjectID) == PLAYER_FORCE)  AND (getobjectdamage(BobjectID) < 100) AND (getobjectdamage(BgenID) < 100)) then
		OrderWait(0.0,TRUE);
		teleporttopoint(Me, BSpot);
		playWave("data\sound\teleport.WAV",-1);	
		waitover = FALSE;
	endif;

	
	if(waitover == FALSE) then	
		curTime = getTime;
		PUpTime 	= True;
		if ((PUpTime) and (PUDelay == -1)) then
				PUDelay = getTime + rwPUStartWait;
		endif;
		if (PUDelay > 0) and (getTime > PUDelay) then
			waitover = TRUE;
			PUpTime 	= False;
			PUDelay = -1;
		endif;
	endif;
	
	If  (objectside(AobjectID) == PLAYER_FORCE) AND (objectside(BobjectID) == CLAN_FORCE) then
		objectchangesides(BobjectID, 0);
	endif;
	If  (objectside(BobjectID) == PLAYER_FORCE) AND (objectside(AobjectID) == CLAN_FORCE) then
		objectchangesides(AobjectID, 0);	
	endif;

endif;
//====================================================================	

//====================================================================	
if (wmxid == 4723) then

if(distancetoposition(Me, reactorPosition) > 2100) then
		radiationstormwarning =  FALSE;
		radiationstormwarning2 = FALSE;
	endif;
if((distancetoposition(Me, reactorPosition) <= 2050)  AND (objectstatus(Me) == 0) AND (radiationstormwarning == False) )  then
			playWave("radiation1",1);
			radiationstormwarning = TRUE;
endif;			

if((distancetoposition(Me, reactorPosition) <= 2000) AND (distancetoposition(Me, reactorPosition) > 1200) AND (objectstatus(Me) == 0))  then
						playWave("lowdosis",1);
						radiationDamage=1;
						if (radiationMax < radiationDamage) then
						radiationMax = radiationDamage;
						endif;
						 setpilotwounds(Me,radiationMax);
	endif;
	
	if((distancetoposition(Me, reactorPosition) <= 1200) AND (distancetoposition(Me, reactorPosition) > 900) AND (objectstatus(Me) == 0))  then
						playWave("lowdosis",1);
						radiationDamage=2;
						if (radiationMax < radiationDamage) then
						radiationMax = radiationDamage;
						endif; 
						setpilotwounds(Me,radiationMax);
	endif;
			
	if((distancetoposition(Me, reactorPosition) <= 900) AND (distancetoposition(Me, reactorPosition) > 600) AND (objectstatus(Me) == 0)) then
					
						playWave("mediumdosis",1);
						radiationDamage=3;
						if (radiationMax < radiationDamage) then
						radiationMax = radiationDamage;
						endif; 
						setpilotwounds(Me,radiationMax);
	endif;
		
if((distancetoposition(Me, reactorPosition) <= 650)  AND (objectstatus(Me) == 0) AND (radiationstormwarning2 == False) )  then
			playWave("radiation2",1);
			radiationstormwarning2 = TRUE;
endif;
	
if((distancetoposition(Me, reactorPosition) <= 600) AND (distancetoposition(Me, reactorPosition) > 300)AND (objectstatus(Me) == 0)) then
		
						playWave("highdosis",1);
						radiationDamage=4;
						if (radiationMax < radiationDamage) then
						radiationMax = radiationDamage;
						endif; 
						setpilotwounds(Me,radiationMax);
						PUDelay					= -1;
						PUpTime					= false;
	endif;
	
	if ((distancetoposition(Me, reactorPosition) <= 300) AND (objectstatus(Me) == 0)) then
				
						playWave("deadlydosis",1);
						
						If( PUpTime 	==  FALSE) then;
						   radiationDamage=5;
						if (radiationMax < radiationDamage) then
						radiationMax = radiationDamage;
						endif; 
						setpilotwounds(Me,radiationMax);
						endif;
						
						curTime = getTime;
						PUpTime 	= TRUE;
						
						if ((PUpTime) and (PUDelay == -1)) then
							PUDelay = getTime + rwPUStartWait;
						endif;
						
						if (PUDelay > 0) and (getTime > PUDelay) then
							corePower(FALSE);
							setpilotwounds(Me,6);
							coreEject;
					
						endif;
	endif;
endif;
//====================================================================	

	
		//assert(false,86,"below initOrders");	
		if (KludgePlayerTarget) then
			PlayerTarget = getTarget(CUR_OBJECT_ID);
			KludgePlayerTarget = FALSE;
		endif;
	
		if (KludgeHandleGuard) then
	
			If (wmxid == 4713) then
		 SetEngageRadius(100.0);
	else
		SetEngageRadius(400.0);	//wolfman(R37)
	endif;

	
			SetDisengageRadius(450.0);	//wolfman(R37)
	    SetNotTargetingMod(0.5);
			//--------------
			// until Run can issued with gaurd order
			SetSpeed(RUN);
	
			CurTacCode = getTacORder(-1, time, tacOrderParams);
	
			//-----------------
			// if run can ever be issued with guard order
			//if (tacOrderParams[7] == 1) then
			//	SetSpeed(RUN);
			//else
			//	SetSpeed(WALK);
			//endif;
	
			if (tacOrderParams[3] == 0) then								
				FreeWillMode = GUARD_POINT;
				Sentry(tacOrderParams[9],tacOrderParams[10]);
				KludgeHandleGuard = FALSE;
				return(1);
			else
				ObjClass = ObjectClass(tacOrderParams[3]);
				if ((ObjClass == MECH_CLASS) OR (ObjClass == VEHICLE_CLASS) OR (ObjClass == ELEMENTAL_CLASS)) then
					FreeWillMode = GUARD_MOVER;
					initOrders;
					MyObject = tacOrderParams[3];
	
					SelectContact(1,MyObject);
					getContactRelativePosition(MyRange, MyAngle);
					print("MyAngle");
					print(MyAngle);
	
					Guard(MyObject);
					//Escort(MyObject,MyAngle);
	
					KludgeHandleGuard = FALSE;
					return(1);
				else
					FreeWillMode = GUARD_OBJECT;
					initOrders;
					MyObject = tacOrderParams[3];
					Guard(MyObject);
					KludgeHandleGuard = FALSE;
					return(1);
				endif;
			endif;
					
			KludgeHandleGuard = FALSE;
		endif;
//=======================================================		

//=======================================================
	if (wmxid == 4714) then

	//	if ((checkObjectiveStatus(objectiveToTrigger) == 1) AND (objectiveToggled == false) AND (Me == 2050)) then 
		if ((checkObjectiveStatus(objectiveToTrigger) == 1) AND (objectiveToggled == false) AND (Me == 512)) then 
			
			If (count<=20) then
				corepower(false);
				count = count+1;
			else
				coreeject;
				objectiveToggled = TRUE;
			endif;		
		endif;
	endif;
//=======================================================

//=======================================================
	if (wmxid == 4715) then
		getobjectposition(Me,Meposition);

	if (distanceToPosition(Me,shutdowncenterA) < 360) then
			shutdownA = true;
		else
			shutdownA = false;
		endif;
		if (distanceToPosition(Me,shutdowncenterB) < 310) then
			shutdownB = true;
		else
			shutdownB = false;
		endif;
					
		if ((checkObjectiveStatus(objectiveToTrigger) == 0) AND (objectiveToggled == false)  AND ((shutdownA == true) OR (shutdownB == true))) then 
			corepower(false);
		endif;
				
		if ((checkObjectiveStatus(objectiveToTrigger) == 1) AND (objectiveToggled == false)) then
			corepower(true);
			objectiveToggled = true;
		endif;	
	endif;
//=======================================================

//=======================================================
if (wmxid == 4718) then

	if ((checkObjectiveStatus(objectiveToTrigger) == 1) AND (objectiveToggled == false)) then
		objectiveToggled = TRUE;
	endif;
		if ((checkObjectiveStatus(objective2ToTrigger) == 1) AND (objective2Toggled == false)) then
		objective2Toggled = TRUE;
	endif;		

	getobjectposition(Me, Meposition);
	if ((distanceToPosition(Me,shutdowncenterC) < 150) AND (objective2Toggled == FALSE) AND (objectiveToggled == FALSE)) then
			shutdownC = TRUE;
	endif;
	if ((distanceToPosition(Me,shutdowncenterC) < 400) AND (objective2Toggled == TRUE) AND (objectiveToggled == FALSE)) then
			shutdownC = TRUE;
	endif;
	if (objectiveToggled == TRUE) then
			shutdownC = FALSE;
	endif;

					
	if (shutdownC == TRUE) then 
			corepower(false);
	else
			corepower(true);
	endif;
endif;
//=======================================================
	

	
	//	if (objectSide(getTarget(CUR_OBJECT_ID)) == objectSide(Me)) then
	//		setTarget(Me,0);
	//		PlayerTarget = 0;
	//	endif;
	
		if (returnState == RETURN_STATE_TRUE) then
			if (distanceToPosition(-1, returnPosition) > 275.0) then
				//------------------------------------------
				// return, because we've gone too far out...
				returnState = RETURN_STATE_NOW;
			else
				if (getTarget(-1) == 0) then
					returnState = RETURN_STATE_NOW;
				endif;
			endif;
		endif;
		if (returnState == RETURN_STATE_NOW) then
			orderMoveTo(returnPosition, RUN);
			distanceToReturnPosition = distanceToPosition(-1, returnPosition);
			if (distanceToReturnPosition > 100.0) then
				return(1);
			endif;
			if (distanceToReturnPosition < 20.0) then
				returnState = RETURN_STATE_FALSE;
			endif;
		endif;
	
		switch (FreeWillMode)
	
			case NORMAL :
				
			// curTacCode = getTacOrder(-1, time, tacOrderParams);

			if (getTarget(CUR_OBJECT_ID) == 0) then
				PlayerTarget = 0;
			endif;

			if (PlayerTarget > 0) then
				if (isDead(PlayerTarget)) then
					PlayerTarget = 0;
				endif;
			endif;

			if (PlayerTarget == 0) then
				FireAtWill; // FireAtWill;
			endif;
			//=====================================	
			//wolfman(by magic)(start)(R37)
			//=====================================
			if (autoscan) then	 //(open useAutoscan loop)
			
			if (NOT isselected) then

		
			if (isrefit) then
				SetSpeed(RUN);
				autorepairwithinradius(-1,500.0);
				automedicalwithinradius(-1,500.0);
			endif;
	


			if (PlayerTarget == 0) then
			
			if (((ObjectClass(Me) == MECH_CLASS)  OR (ObjectClass(Me) == VEHICLE_CLASS) ) AND (numenemieswithinradius(-1,700.0) == 0)) then

				if (areaNotScaned) then
 					if (scanareacapture(400) == 0) then
						areaNotScaned = FALSE;
					endif;
				else
					if (needsrefit) then
						scanarearepair(400.0);
					else	
						FireAtWill; // FireAtWill;
					endif;
				endif;

			else
				FireAtWill; // FireAtWill;
			endif;
			endif;

	else
			if (PlayerTarget == 0) then
				FireAtWill; // FireAtWill;
			endif;
		endif;
	endif;	//(close useAutoscan loop)
	//===============================
	//wolfman(by magic)(end)(R37)
	//===============================
	
			endcase;
	
			case GUARD_POINT :
	
				GuardStatus = Sentry(MyX,MyY);
				if (GuardStatus <> INCOMPLETE) then
					FreeWillMode = NORMAL;
					if (PlayerTarget == 0) then
						FireAtWill; // FireAtWill;
					endif;
				endif;
	
				endcase;
	
			case GUARD_OBJECT :
	
				GuardStatus = Guard(MyObject);
				if (GuardStatus <> INCOMPLETE) then
					FreeWillMode = NORMAL;
					if (PlayerTarget == 0) then
						FireAtWill; // FireAtWill;
					endif;
				endif;
	
				endcase;
	
			case GUARD_MOVER :
	
				// GuardStatus = Escort(MyObject,MyAngle);
				GuardStatus = Guard(MyObject);
				if (GuardStatus <> INCOMPLETE) then
					FreeWillMode = NORMAL;
					if (PlayerTarget == 0) then
						FireAtWill; // FireAtWill;
					endif;
				endif;
				
				endcase;
	
			case STOPPED :
	
				Print("Stopped.");
				SetTarget(CUR_OBJECT_ID,0);
	
				endcase;
	
		endswitch;

		//wolfman(by magic)(start)(R37)
	
	if (hasorderfromplayer) then		
			areaNotScaned = TRUE; 
		endif;

	//wolfman(by magic)(end)(R37)
		
		
		

		//==================================
		If (fuelcode == TRUE) then
			If (fueloff == TRUE) then
				corePower(FALSE);
			endif;

			If (fueloff == FALSE) then
				corePower(TRUE);
			endif;
		endif;
		//==================================
	
		//==================================
		If (repaircode == TRUE) then
			setIntegerMemory(I_PERMIT_REPAIR, 1);
			Repair(-1, 500.0);
			setIntegerMemory(I_HITS,0); 
		endif;
		//==================================
			
		debugS = "PlyrTrgt=";
		concat(debugS, PlayerTarget);
		setDebugString(-1, 3, debugS);
	
	    return(1);

//----------------------------------------------------------------------------------------

endmodule.

