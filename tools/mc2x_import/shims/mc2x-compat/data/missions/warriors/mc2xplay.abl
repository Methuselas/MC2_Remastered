		rwPUStartWait	= 20;
		PUDelay			= -1;
		PUpTime			= false;
	endif; 
//=======================================================	
if (wmxid == 4719) then
		rwPUStartWait		= 3;
		PUDelay			= -1;
		PUpTime			= false;
	endif; 	
//=======================================================	

//=======================================================	
if (wmxid == 4715) then
		Me 								= getId;
		objectiveToTrigger		= 20;
		objectiveToggled			= FALSE;
		shutdownA 					= FALSE;
		shutdownB 					= FALSE;
		shutdowncenterA[0]		= 3648;
		shutdowncenterA[1]		= -5994;
		shutdowncenterB[0]		= -832;
		shutdowncenterB[1]		= -6080;
	endif; 
//=======================================================	

//=======================================================	
	if (wmxid == 4718) then
		Me 								= getId;
		objectiveToTrigger		= 32;
		objectiveToggled			= FALSE;
		objective2ToTrigger		= 4;
		objective2Toggled		= FALSE;
		shutdownC 					= FALSE;
		shutdowncenterC[0]	= -5440;
		shutdowncenterC[1]	= -8640;
		shutdowncenterC[2]	= 0;
	endif; 
//=======================================================	

//=======================================================	
	if (wmxid == 4721) then
		Me 	= getId;
		AobjectID = 113435;
		BobjectID = 20012;
		CobjectID = 452435;
		DobjectID = 458915;
		EobjectID = 173372;
		FobjectID = 380828;		
		AgenID = 110554;
		BgenID = 20728;
		CgenID = 452439;
		DgenID = 458919;
		EgenID = 174096;
		FgenID = 380824;	
		ASpot[0] = 11072;
		ASpot[1] = 8896;
		BSpot[0] = -12096;
		BSpot[1] = 14400;
		CSpot[0] = 5952;
		CSpot[1] = -11200;
		DSpot[0] = 5952;
		DSpot[1] = -11584;
		ESpot[0] = -12096;
		ESpot[1] = 5312;
		FSpot[0] = -8000;
		FSpot[1] = -6976;		
		waitover 	= TRUE;
	endif; 
//=======================================================	

//=======================================================	
	if (wmxid == 4722) then
		Me 	= getId;
		AobjectID = 117536;
		BobjectID = 461207;
		AgenID = 118260;
		BgenID = 464087;
		ASpot[0] = 1728;
		ASpot[1] = 8640;
		BSpot[0] = 11584;
		BSpot[1] = -11712;
