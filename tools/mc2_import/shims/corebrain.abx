//----------------------------------------------------------------------------------
// CHECK TARGET LIST
//195----------------------------------------------------------------------------------
function CheckTargetList (integer current_target, real attack_range) : integer;

	var
		integer	x;
		integer 	currentCell;
		integer	num_targets;
		integer	Target_ID;
		integer	best_target;
		real		Target_rating;
		real		best_distance;
		real		target_distance;

	code
	best_target = current_target;
	if (distancetoobject(-1,best_target) > attack_range) then 
		currentCell = FIRST_TARGET_CELL;
		num_targets = getIntegerMemory(I_TARGETS_TO_REMEMBER);

		for x = 0 to (num_targets - 1) do
			currentCell = currentCell + 1;
			Target_ID = getIntegerMemory(currentCell);
			currentCell = currentCell + 1;
			Target_Rating = getRealMemory(currentCell);
			best_distance = distancetoobject(-1,best_target);
			target_distance = distancetoobject(-1,Target_ID);
			if (target_distance < attack_range) AND ((attack_range - target_distance) < (attack_range - best_distance)) then //AND (best_distance > target_distance) 
				best_target = Target_ID;
			endif;
		endfor;
	endif;

	return(best_target);

endfunction;
//230----------------------------------------------------------------------------------------
function ForceWithinArea(real x, real y, real Radius) : boolean;

	var
		integer	i;
		integer VehID;
		integer EnemyVehID;
		integer AlliedVehID;
		integer Size;
		real Distance;
		position Point;

	code

	Point[0] = x;
	Point[1] = y;
	Point[2] = 0;
	
	VehID = 2050;
	EnemyVehID = 704;
	AlliedVehID = 896;
	Size = 16; // Assuming player force is no bigger than 16

//	Player_side = ObjectSide(2050); //OK = 500

		for i = 0 to 191 do
			if (isAlive(EnemyVehID + i) AND (ObjectSide(EnemyVehID + i) <> 500)) then
				distance = distanceToPosition(EnemyVehID + i, Point);
				if ((distance <> -1) and (distance < Radius)) then
					return(FALSE);
				endif;
			endif;
		endfor;
	
		for i = 0 to (size - 1) do
			if (isAlive(VehID + i) AND (objectClass(VehID + i) == MECH_CLASS)) then
				distance = distanceToPosition(VehID + i, Point);
				if ((distance <> -1) and (distance > Radius)) then
					return(FALSE);
				endif;
			endif;
		endfor;

		for i = 0 to 191 do
			if (isAlive(EnemyVehID + i) AND (objectClass(EnemyVehID + i) == MECH_CLASS) AND (ObjectSide(EnemyVehID + i) == 500)) then
							// AND (ObjectSide(EnemyVehID + i) == INNER_SPHERE)) then -No good
				distance = distanceToPosition(EnemyVehID + i, Point);
				if ((distance <> -1) and (distance > Radius)) then
					return(FALSE);
				endif;
			endif;
		endfor;

//		for i = 0 to 50 do
//			if (isAlive(AlliedVehID + i) AND (objectClass(AlliedVehID + i) == MECH_CLASS) AND (ObjectSide(AlliedVehID + i) == 500)) then
//				distance = distanceToPosition(AlliedVehID + i, Point);
//				if ((distance <> -1) and (distance > Radius)) then
//					return(FALSE);
//				endif;
//			endif;
//		endfor;
// No good, Allied side is 500, same as Player side
		return(TRUE);

endfunction;

//230----------------------------------------------------------------------------------------
function PlayerForceNearObject(integer objectID, real Radius) : boolean;

	var
		integer	i;
		integer VehID;
		integer EnemyVehID;
		integer Size;
		real Distance;

	code

	VehID = 2050;
	EnemyVehID = 704;

	Size = 16; // Assuming player force is no bigger than 16

//	Player_side = 500

		for i = 0 to (size - 1) do
			if (isAlive(VehID + i) AND (objectClass(VehID + i) == MECH_CLASS)) then
				distance = distanceToObject(VehID + i, objectID);
				if ((distance <> -1) and (distance < Radius)) then
					return(TRUE);
				endif;
			endif;
		endfor;

		for i = 0 to 191 do
			if (isAlive(EnemyVehID + i) AND (objectClass(EnemyVehID + i) == MECH_CLASS) AND (ObjectSide(EnemyVehID + i) == 500)) then
				distance = distanceToObject(VehID + i, objectID);
				if ((distance <> -1) and (distance < Radius)) then
					return(TRUE);
				endif;
			endif;
		endfor;

		return(FALSE);

endfunction;

//296------------------------------------------------------------------------------------

order magicAttack (integer targetID) : integer;


	var

		WorldPosition		attackPoint;
		real				Range;
		real				Angle;
		real				RandomAngle;
//		integer				curTacCode;
//		static integer[15]	tacOrderParams;
//		real				time;
		integer				targetClass;
		real				MinWeaponRange;
		real[3]				weaponRanges;
		integer[30]			weaponList;
		integer				numFunctionalWeapons;
		integer				targetObjectStatus;
//		integer				result;
		integer			curParams;
		integer			tacticState;
//		real				game_angle;
		integer 			param_tactic;
		static integer 		random_num;
//		integer[32]			enemyList;
//		integer			numTargets;


	code

//		if (targetID <> 0) AND (getenemycount(-1) > 0) then 
//			targetID = 0;
//		endif;
		curParams = 0;

		if (CoreRun) then
			curParams = TACORDER_PARAM_RUN;
			CoreRun = false;
		endif;
		if (CoreJump) then
			curParams = TACORDER_PARAM_JUMP;
			CoreJump = false;
		endif;

		numFunctionalWeapons = getWeapons(weaponList, 1);
		if (numFunctionalWeapons == 0) then
			//clearTacOrder;
			return(1);
		endif;

		getWeaponRanges(-1, weaponRanges);

//			numTargets = getContacts(enemyList, CONTACT_CRITERIA_VISUAL_OR_SENSOR + CONTACT_CRITERIA_NOT_DISABLED, 300); //CONTACT_CRITERIA_ENEMY 
			if (getenemycount(-1) > 50) then //OK radi ali treba pronaci funkciju koja broji friendly_in_area od 300 i ubaciti umesto 16 (*2)
									//getenemycount(targetID) - always returns 0
//			if (numTargets > 4) then //OK
				param_tactic = TACORDER_PARAM_HIT_AND_RUN;
			else
				if (WeaponRanges[2] > 180.0) then
						random_num = random(6);
						switch (random_num)
							case 0:
								param_tactic = TACORDER_PARAM_FLANK_RIGHT;
							endcase;
							case 1:
								param_tactic = TACORDER_PARAM_FLANK_LEFT;
							endcase;
							case 2:
								param_tactic = TACORDER_PARAM_FLANK_REAR;
							endcase;
							case 3:
								param_tactic = TACORDER_PARAM_RANGE_OPTIMAL;
							endcase;
							case 4:
								param_tactic = TACORDER_PARAM_RANGE_OPTIMAL;
							endcase;
							case 5:
								param_tactic = TACORDER_PARAM_RANGE_OPTIMAL;
							endcase;
							case 6:
								param_tactic = TACORDER_PARAM_RANGE_OPTIMAL;
							endcase;
						endswitch;
				else
					if (WeaponRanges[2] > 110.0) then
						random_num = random(5);
						switch (random_num)
							case 0:
								param_tactic = TACORDER_PARAM_FLANK_RIGHT;
							endcase;
							case 1:
								param_tactic = TACORDER_PARAM_FLANK_LEFT;
							endcase;
							case 2:
								param_tactic = TACORDER_PARAM_FLANK_REAR;
							endcase;
							case 3:
								param_tactic = TACORDER_PARAM_JOUST;
							endcase;
							case 4:
								param_tactic = TACORDER_PARAM_RANGE_OPTIMAL;
							endcase;
							case 5:
								param_tactic = TACORDER_PARAM_RANGE_OPTIMAL;
							endcase;

						endswitch;
					else
						param_tactic = TACORDER_PARAM_OBLITERATE;
					endif;
				endif;
			endif;


		if (targetID == 0) then
			targetID = getLastScan;
			if (targetID <> 0) then
				if (distancetoobject(-1,targetID) > 500) then // OR (distancetoobject(-1,targetID) > (WeaponRanges[2]))) then
				//if (distancetoobject(-1,targetID) > (WeaponRanges[2])) then
					targetID = newScan(0, CONTACT_CRITERIA_VISUAL_OR_SENSOR + CONTACT_CRITERIA_ENEMY + CONTACT_CRITERIA_NOT_DISABLED);
					if (targetID == 0) then
						return(1);
					endif;
				endif;
			else
				targetID = newScan(0, CONTACT_CRITERIA_VISUAL_OR_SENSOR + CONTACT_CRITERIA_ENEMY + CONTACT_CRITERIA_NOT_DISABLED);
				if (targetID == 0) then

					return(1);
				endif;
			endif;
		endif;

		targetObjectStatus = objectStatus(targetID);
		if ((targetObjectStatus == OBJECT_STATUS_DISABLED) or
		    (targetObjectStatus == OBJECT_STATUS_DESTROYED) or
			(targetObjectStatus == OBJECT_STATUS_WITHDRAWN)) then

			return(1);
		endif;

		targetClass = objectClass(targetID);		  
		if ((targetClass <> MECH_CLASS) and (targetClass <> VEHICLE_CLASS) and (targetClass <> ELEMENTAL_CLASS)) then
				SetTarget(-1,TargetID);
//				getObjectPosition(TargetID,attackpoint);
//				curparams = setFlag(curparams, TACORDER_PARAM_DONT_KEEP_MOVING, true);
			if (distancetoobject(-1,targetID) > (WeaponRanges[2])) then
				coreMoveToObject(targetID, curparams);
			else
				coreAttack(targetID, TACORDER_PARAM_PURSUE + curparams);
			endif;
//				coreMoveTo(attackPoint, curparams);
//				tacticState = targetID;

			return(1);
		endif;

//*************************NEW
if (getenemycount(-1) > 1) then
	targetID = CheckTargetList(targetID,WeaponRanges[2]);
endif;
//**********************endNEW

//		getWeaponRanges(-1, weaponRanges);

		switch (param_tactic)

		case TACORDER_PARAM_NONE:

				SetTarget(-1,TargetID);
				setintegermemory(I_MOVE_STATUS,NOT_MOVING);

			endcase;

//		case TACORDER_PARAM_PURSUE:
//				SetTarget(-1,TargetID);
//				
//				if (range < WeaponRanges[2] - 15.0) then
//					coreAttack(targetID, TACORDER_PARAM_PURSUE + curparams);
//				else
//					coreMoveToObject(targetID, TACORDER_PARAM_RUN);
//
//				endif;
//			endcase;

//		case TACORDER_PARAM_WAIT:
//			endcase;

		case TACORDER_PARAM_OBLITERATE: //SWARM

				SetTarget(-1,TargetID);

				if (ObjectClass(-1) == ELEMENTAL_CLASS) then

					if (distancetoObject(-1,TargetID) > 25.0) then // 1.0
						getRelativePositionToObject(TargetID, RandomAngle, 9.0, 2, AttackPoint);
						curparams = setFlag(curparams, TACORDER_PARAM_DONT_KEEP_MOVING, true);
						coreMoveTo(attackPoint, curparams);

				   	endif;

				else

					if (distancetoObject(-1,TargetID) > 2.0) then // 1.0
						getRelativePositionToObject(TargetID, RandomAngle, 15.0, 2, AttackPoint);					
						curparams = setFlag(curparams, TACORDER_PARAM_DONT_KEEP_MOVING, true);
						coreMoveTo(attackPoint, curparams);
				   	endif;

				endif;

			endcase;

//		case TACORDER_PARAM_SCAN:
//			endcase;

		case TACORDER_PARAM_RANGE_OPTIMAL:
				SetTarget(-1,TargetID);
				//selectContact(1, targetID);
				//getContactRelativePosition(range, angle);	

				//if (WeaponRanges[2] > 180.0) then
				//	MinWeaponRange = 100.0;
				//else
				//	if (WeaponRanges[2] > 110.0) then
				//		MinWeaponRange = 60.0;
				//	else
				//		MinWeaponRange = 0.0;
				//	endif;
				//endif;

				getTargetRelativePosition(targetID, range, angle);

				if (range < (WeaponRanges[2] - 15.0)) then
					if ((range - WeaponRanges[2] + 15.0) > 50.0) then
						getRelativePositionToTarget(targetID, (WeaponRanges[2] - 15.0), 2, attackPoint);
						curparams = setFlag(curparams, TACORDER_PARAM_DONT_KEEP_MOVING, true);
						coreMoveTo(attackPoint, curparams);						
					else
						//coreAttack(targetID, TACORDER_PARAM_PURSUE + curparams);
						coreAttack(targetID, TACORDER_PARAM_DONT_KEEP_MOVING + curparams);
					endif;
				else
					//curparams = setFlag(curparams, TACORDER_PARAM_DONT_KEEP_MOVING, true);
					//coreMoveToObject(targetID, curparams);
					getRelativePositionToTarget(targetID, (WeaponRanges[2] - 15.0), 2, attackPoint);
					curparams = setFlag(curparams, TACORDER_PARAM_DONT_KEEP_MOVING, true);
					coreMoveTo(attackPoint, curparams);

				endif;

			endcase;

//		case TACORDER_PARAM_RANGE_SHORT:
//				SetTarget(-1,TargetID);
//				orderAttackObject(TargetID,ATTACK_TO_DESTROY, ATTACK_RANGED, FIRERANGE_SHORT, TRUE);
