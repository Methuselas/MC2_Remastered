order patrol (@PatrolState pState, @PatrolPath pPath) : integer;

	code

		return(corePatrol(pState, pPath, 0));

endorder;

//----------------------------------------------------------------------------------------

order patrolDelayed (@PatrolState pState, @PatrolPath pPath, real startTime) : integer;

	code

		return(corePatrolDelayed(pState, pPath, startTime, 0));

endorder;

//----------------------------------------------------------------------------------------

function CalculateGameAngle(real angle) : real;

	var
		real gameAngle;
	code

		if ((angle >= -22.5) and (angle <= 22.5)) then
			gameAngle = ANGLE_SOUTH;
		else
			if ((angle > 22.5) and (angle <= 67.5)) then
				gameAngle = ANGLE_SOUTHWEST;						
			else
				if ((angle > 67.5) and (angle <= 112.5)) then
					gameAngle = ANGLE_WEST;
				else
					if ((angle > 112.5) and (angle < 157.5)) then
						gameAngle = ANGLE_NORTHWEST;
					else
						if (angle > 157.5) then
							gameAngle = ANGLE_NORTH;
						else
							if ((angle < -22.5) and (angle >= -67.5)) then
								gameAngle = ANGLE_SOUTHEAST;
							else
								if ((angle < -67.5) and (angle >= -112.5)) then
									gameAngle = ANGLE_EAST;
								else
									if ((angle < -112.5) and (angle >= -157.5)) then
										gameAngle = ANGLE_NORTHEAST;
									else
										if (angle < -157.5) then
											gameAngle = ANGLE_NORTH;
										else
											fatal(86,"Bad Relative Position in Tactic.");
										endif;
									endif;
								endif;
							endif;
						endif;
					endif;
				endif;
			endif;
		endif;

		return(gameAngle);

endfunction;

