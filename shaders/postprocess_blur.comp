// postprocess_blur.comp  (POSTPROCESS-COMPUTE-BLUR-1)
//
// MC2-native GPU compute downsample + separable-Gaussian-blur SUBSTRATE. This is
// a greenfield, gated, INERT pass: there is NO bloom / glow / DOF consumer of the
// blurred output. Its purpose is to exercise the typed-sync + ping-pong compute
// pattern (Vulkan-prep) and to be CPU-verifiable, while shipping ZERO visual
// change.
//
// THREE STAGES, selected by the MODE_* define injected by the C++ builder
// (project rule: never put #version in a shader file — the C++ side prepends
// "#version 430\n" plus the right "#define MODE_* 1\n" and "#define ..." lines):
//
//   MODE_DOWNSAMPLE : read a full-res RGBA texture (sampler2D), box-average a 2x2
//                     footprint, write half-res into an RGBA16F image2D.
//   MODE_BLUR_H     : separable Gaussian, horizontal pass. Read half-res image
//                     (as sampler2D), write half-res image2D.
//   MODE_BLUR_V     : separable Gaussian, vertical pass. Same, transposed axis.
//
// GAUSSIAN KERNEL (authored, clean-room — standard separable 5-tap, sigma ~= 1.0,
// normalized to sum 1.0):  [0.0625, 0.25, 0.375, 0.25, 0.0625]  (1/16, 4/16,
// 6/16, 4/16, 1/16 — the binomial row, a textbook discrete Gaussian). Applied
// once horizontally then once vertically => a separable 5x5 Gaussian. No imported
// kernel; weights are written out below and must match the CPU reference exactly.
//
// Edge handling: CLAMP_TO_EDGE (texelFetch with clamped coordinates) so the CPU
// reference and GPU agree bit-for-bit on borders.

#ifndef TILE_X
#define TILE_X 8
#endif
#ifndef TILE_Y
#define TILE_Y 8
#endif

layout(local_size_x = TILE_X, local_size_y = TILE_Y, local_size_z = 1) in;

// Input sampled as a plain texture (NEAREST filtering; we index exact texels).
layout(binding = 0) uniform sampler2D u_src;

// Output half-res (downsample) or same-res (blur) RGBA16F image.
layout(binding = 0, rgba16f) uniform writeonly image2D u_dst;

// Destination image dimensions in texels (so edge threads can early-out).
uniform ivec2 u_dstSize;

// Authored separable Gaussian weights (binomial 5-tap, sum = 1.0).
const float W0 = 0.0625; // 1/16  (offset +/-2)
const float W1 = 0.25;   // 4/16  (offset +/-1)
const float W2 = 0.375;  // 6/16  (center)

// Clamp an integer texel coordinate into [0, size-1] (CLAMP_TO_EDGE).
ivec2 clampTexel(ivec2 c, ivec2 size) {
    return clamp(c, ivec2(0), size - ivec2(1));
}

void main()
{
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    if (dst.x >= u_dstSize.x || dst.y >= u_dstSize.y) return;

#if defined(MODE_DOWNSAMPLE)
    // Box-average the 2x2 full-res footprint that maps to this half-res texel.
    ivec2 srcSize = textureSize(u_src, 0);
    ivec2 base = dst * 2;
    vec4 s = texelFetch(u_src, clampTexel(base + ivec2(0, 0), srcSize), 0)
           + texelFetch(u_src, clampTexel(base + ivec2(1, 0), srcSize), 0)
           + texelFetch(u_src, clampTexel(base + ivec2(0, 1), srcSize), 0)
           + texelFetch(u_src, clampTexel(base + ivec2(1, 1), srcSize), 0);
    imageStore(u_dst, dst, s * 0.25);

#elif defined(MODE_BLUR_H)
    ivec2 sz = u_dstSize; // src and dst are same-res for blur
    vec4 c = W0 * texelFetch(u_src, clampTexel(dst + ivec2(-2, 0), sz), 0)
           + W1 * texelFetch(u_src, clampTexel(dst + ivec2(-1, 0), sz), 0)
           + W2 * texelFetch(u_src, clampTexel(dst + ivec2( 0, 0), sz), 0)
           + W1 * texelFetch(u_src, clampTexel(dst + ivec2( 1, 0), sz), 0)
           + W0 * texelFetch(u_src, clampTexel(dst + ivec2( 2, 0), sz), 0);
    imageStore(u_dst, dst, c);

#elif defined(MODE_BLUR_V)
    ivec2 sz = u_dstSize;
    vec4 c = W0 * texelFetch(u_src, clampTexel(dst + ivec2(0, -2), sz), 0)
           + W1 * texelFetch(u_src, clampTexel(dst + ivec2(0, -1), sz), 0)
           + W2 * texelFetch(u_src, clampTexel(dst + ivec2(0,  0), sz), 0)
           + W1 * texelFetch(u_src, clampTexel(dst + ivec2(0,  1), sz), 0)
           + W0 * texelFetch(u_src, clampTexel(dst + ivec2(0,  2), sz), 0);
    imageStore(u_dst, dst, c);

#else
#error "postprocess_blur.comp requires one of MODE_DOWNSAMPLE / MODE_BLUR_H / MODE_BLUR_V"
#endif
}
