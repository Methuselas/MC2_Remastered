// lightgrid_build.comp  (MC2-LIGHTGRID-BUILD-NATIVE-1)
//
// MC2-native, clean-room GPU light-bin grid builder. INERT substrate: builds a
// per-tile light-index grid from a native sphere cull-geometry buffer, validated
// against a CPU reference. NO shading consumer, NO visual change.
//
// This ONE source file holds TWO compute stages, selected by the LIGHTGRID_STAGE
// macro injected by the C++ builder (same pattern cluster_depth_pyramid.comp uses
// for TILE_SIZE). The C++ side compiles two programs from this file:
//   LIGHTGRID_STAGE == 0  -> sphere-build stage (ObjectLights -> sphere buffer)
//   LIGHTGRID_STAGE == 1  -> grid-build stage   (spheres + depth pyramid -> grid)
//
// No #version line here on purpose -- C++ prepends "#version 430\n" plus the
// stage/define block (project rule: never put #version in a shader file).
//
// REVERSED-Z GATE (load-bearing -- mirrored in the C++ checker and the doc):
//   MC2 renders reversed-Z (near ~= 1.0, far ~= 0.0). The depth pyramid stores
//   raw extents: R = numeric MIN, G = numeric MAX. The NEAREST surface in a tile
//   is therefore the numeric MAX (channel G); the FARTHEST is the numeric MIN
//   (channel R). This shader reads near = MAX(G), far = MIN(R). Do not "fix" the
//   apparent inversion -- it is correct for reversed-Z.

#ifndef LIGHTGRID_STAGE
#define LIGHTGRID_STAGE 1
#endif

// Hard light cap (lockstep with shaders/include/lighting.hglsl MAX_LIGHTS_IN_WORLD
// and the C++ side). LIGHT-ABI-WIDEN-STAGE0-1 widened the per-object ABI 16->32;
// this binding-20 reader mirror MUST agree with the record stride (LG_ObjectLights
// inner-array size) or the sphere-build reads garbage. Runtime population still 16.
#ifndef LIGHTGRID_MAX_LIGHTS
#define LIGHTGRID_MAX_LIGHTS 32
#endif

// ---------------------------------------------------------------------------
// Shared native sphere cull-record. std430-packed, 32 bytes. This is the core
// new data: POINT and SPOT lights are BOTH treated as spheres (MC2 stores no
// cone half-angle for SPOT -- cone culling is DEFERRED, no source data). The
// layout is MC2-native (not a clone of any reference struct).
//   offset 0  : center.xyz (12) + radius (4)   == one vec4 lane
//   offset 16 : lightIndex (4) + type (4) + pad0 (4) + pad1 (4)
//   total: 32 bytes, no vec4 straddle.
// ---------------------------------------------------------------------------
struct MC2LightCullSphere {
    vec4 centerRadius;   // xyz = world center, w = radius
    uint lightIndex;     // index back into ObjectLights
    uint type;           // light_dir.w (POINT/SPOT both bin as sphere)
    uint pad0;
    uint pad1;
};

#if LIGHTGRID_STAGE == 0
// ===========================================================================
// STAGE 0 -- SPHERE BUILD: derive the native sphere buffer from ObjectLights.
// "Do NOT feed raw ObjectLights to the grid builder directly -- build the
// sphere buffer first." This is that build, on the GPU.
// ===========================================================================

// ObjectLights mirror (read-only). Kept byte-identical to lighting.hglsl's
// ObjectLights so binding 20 reads correctly -- but written fresh here, no
// #include of the shading header (this pass is shading-independent).
struct LG_ObjectLights {
    mat4 light_to_world[LIGHTGRID_MAX_LIGHTS];
    vec4 light_dir[LIGHTGRID_MAX_LIGHTS];     // w = type
    vec4 light_color[LIGHTGRID_MAX_LIGHTS];
    vec4 light_falloff[LIGHTGRID_MAX_LIGHTS]; // x=close, y=far, z=oneOver, w=unused
    ivec4 numLights;
};

// Binding 20 -- the live ObjectLights SSBO (LIGHT_DATA_SSBO_BINDING). Read-only.
layout(binding = 20, std430) readonly buffer LG_LightsData {
    LG_ObjectLights light[];
};

// Output sphere pool (this pass owns binding 0 in its own dispatch bind set).
layout(binding = 0, std430) writeonly buffer LG_SphereOut {
    MC2LightCullSphere spheres[];
};

// Survivor count for the sphere stage: how many lights produced a real sphere.
// Single uint at binding 1.
layout(binding = 1, std430) buffer LG_SphereCount {
    uint sphereCount;
};

layout(local_size_x = LIGHTGRID_MAX_LIGHTS, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    int  n = light[0].numLights.x;
    if (i == 0u) sphereCount = uint(max(n, 0));
    if (int(i) >= LIGHTGRID_MAX_LIGHTS) return;

    // Inactive slots (index >= active light count) get a degenerate sphere
    // (radius 0) so the grid stage rejects them via its r > 0.0 test WITHOUT
    // needing a per-frame CPU readback of the active count. This keeps the
    // steady-state hot path readback-free (no GPU stall).
    if (int(i) >= n) {
        MC2LightCullSphere dead;
        dead.centerRadius = vec4(0.0);
        dead.lightIndex = i;
        dead.type = 0u;
        dead.pad0 = 0u;
        dead.pad1 = 0u;
        spheres[i] = dead;
        return;
    }

    // center = light_to_world translation. In std430 a mat4 is 4 column vec4s;
    // column 3 (.xyz) is the translation for a standard affine transform.
    vec3 center = light[0].light_to_world[i][3].xyz;
    float radius = light[0].light_falloff[i].y;   // far distance == cull radius
    uint type = uint(light[0].light_dir[i].w + 0.5);

    MC2LightCullSphere s;
    s.centerRadius = vec4(center, radius);
    s.lightIndex = i;
    s.type = type;
    s.pad0 = 0u;
    s.pad1 = 0u;
    spheres[i] = s;
}

#else
// ===========================================================================
// STAGE 1 -- GRID BUILD: per-tile sphere binning, BT-shaped LDS-staged append.
//
// One workgroup == one screen tile. Threads stride the (<=16) spheres, stage
// survivors in LDS, then ONE global atomicAdd reserves a span in the global
// index pool and the survivors are compact-written; a per-tile (offset,count)
// header is stored. This is the AMD-friendly "stage-then-single-reserve"
// discipline (NOT a per-candidate global-atomic storm).
//
// Z-BIN CHOICE: NZ = 1 (a single Z interval per tile). Justification: this lane
// is build+validate infra at a 16-light cap. One near/far interval per tile,
// taken from the depth pyramid (near = MAX(G), far = MIN(R)), is sufficient to
// exercise + parity-prove the full sphere/frustum/depth cull and the LDS append
// without the cost/complexity of froxel Z-slicing. Froxel Z-bins are deferred
// to a later slice (this builder is tile/froxel-neutral: lifting NZ later only
// adds an outer Z loop + a wider header).
// ===========================================================================

layout(binding = 0, std430) readonly buffer LG_SphereIn {
    MC2LightCullSphere spheres[];
};

// Per-tile header: (offset, count) into the global index pool. RG32UI image.
layout(binding = 0, rg32ui) uniform writeonly uimage2D u_tileHeader;

// Global compact light-index pool.
layout(binding = 1, std430) writeonly buffer LG_IndexPool {
    uint indexPool[];
};

// Global allocation cursor (single uint). atomicAdd reserves spans here.
layout(binding = 2, std430) buffer LG_Cursor {
    uint poolCursor;
};

// Per-tile depth (min,max) pyramid from CLUSTER-DEPTH-PYRAMID-NATIVE-1.
//   R = numeric MIN depth, G = numeric MAX depth (reversed-Z: near=MAX, far=MIN).
layout(binding = 1) uniform sampler2D u_tileMinMax;

// Uniforms describing the screen-tile frustum reconstruction.
uniform ivec2 u_tileGrid;     // tile grid dims (== depth pyramid dims)
uniform ivec2 u_sceneSize;    // full scene size in pixels
uniform int   u_tileSize;     // pixels per tile edge (matches pyramid tile size)
uniform int   u_lightCount;   // active sphere count (<= LIGHTGRID_MAX_LIGHTS)
uniform int   u_poolStride;   // max indices reserved per tile (== cap)
uniform mat4  u_invViewProj;  // clip -> world, to rebuild the tile frustum

layout(local_size_x = LIGHTGRID_MAX_LIGHTS, local_size_y = 1, local_size_z = 1) in;

// LDS survivor staging + running cursor (BT-shaped).
shared uint s_survivors[LIGHTGRID_MAX_LIGHTS];
shared uint s_localCount;
shared uint s_globalBase;

// Reconstruct a world-space point from clip (NDC) xy + depth via inverse VP.
// MC2 uses glClipControl(GL_ZERO_TO_ONE) reversed-Z: NDC z is in [0,1] and the
// sampled depth IS the clip z directly (no [-1,1] remap). This matches the
// engine's edge_fog.frag / fog_oob.frag unprojection (vec4(ndc, depth, 1.0)),
// and inverseViewProj_ is uploaded GL_FALSE so u_invViewProj is its transpose --
// the same clip->world convention every post pass uses.
vec3 worldFromClip(vec2 ndc, float depth)
{
    vec4 clip = vec4(ndc, depth, 1.0);
    vec4 world = u_invViewProj * clip;
    return world.xyz / world.w;
}

// Test a sphere against this tile's frustum. We build the 8 corners of the tile
// sub-frustum (4 screen-tile corners x near/far depth) in world space and test
// the sphere against the convex hull's 6 planes. Lean + robust for v1.
bool sphereInTile(vec3 c, float r, vec3 corners[8])
{
    // Build 6 planes from the 8 corners. Corner order:
    //   0..3 = near plane (TL,TR,BR,BL), 4..7 = far plane (TL,TR,BR,BL).
    // For each plane, if the sphere center is farther than r BEHIND the plane
    // (outside), reject. Planes face inward.
    // Plane from 3 points a,b,c with inward reference point ref.
    vec3 ref = (corners[0] + corners[1] + corners[2] + corners[3] +
                corners[4] + corners[5] + corners[6] + corners[7]) * 0.125;
    // 6 faces as triangles (ccw not assumed; we orient toward ref).
    ivec3 faces[6] = ivec3[6](
        ivec3(0,1,2),   // near
        ivec3(4,6,5),   // far
        ivec3(0,4,5),   // top    (TL,TR span)
        ivec3(2,6,7),   // bottom
        ivec3(0,3,7),   // left
        ivec3(1,5,6)    // right
    );
    for (int f = 0; f < 6; ++f) {
        vec3 a = corners[faces[f].x];
        vec3 b = corners[faces[f].y];
        vec3 d = corners[faces[f].z];
        vec3 nrm = cross(b - a, d - a);
        float len = length(nrm);
        if (len < 1e-12) continue;     // degenerate face, skip
        nrm /= len;
        // Orient inward (toward centroid).
        if (dot(nrm, ref - a) < 0.0) nrm = -nrm;
        float dist = dot(nrm, c - a);  // signed: + inside, - outside
        if (dist < -r) return false;   // sphere fully behind this face
    }
    return true;
}

void main()
{
    ivec2 tile = ivec2(gl_WorkGroupID.xy);
    uint  li = gl_LocalInvocationIndex;

    if (li == 0u) s_localCount = 0u;
    barrier();

    bool tileValid = (tile.x < u_tileGrid.x) && (tile.y < u_tileGrid.y);

    // Reconstruct this tile's world-space sub-frustum once (all threads agree).
    vec3 corners[8];
    if (tileValid) {
        // Screen-tile pixel rect -> NDC rect.
        vec2 p0 = vec2(tile) * float(u_tileSize);
        vec2 p1 = p0 + float(u_tileSize);
        p1 = min(p1, vec2(u_sceneSize));
        vec2 sz = vec2(u_sceneSize);
        // GL framebuffer pixel coords are y-up (origin bottom-left), and the
        // depth pyramid tiles are indexed the same way. NDC = pixel/size*2-1
        // with NO y-flip -- matching edge_fog.frag's TexCoord*2-1 convention.
        vec2 nMin = (p0 / sz) * 2.0 - 1.0;
        vec2 nMax = (p1 / sz) * 2.0 - 1.0;

        // REVERSED-Z: near = MAX (G), far = MIN (R).
        vec2 mm = texelFetch(u_tileMinMax, tile, 0).rg;
        float near = mm.y;   // G = numeric MAX = nearest
        float far  = mm.x;   // R = numeric MIN = farthest

        corners[0] = worldFromClip(vec2(nMin.x, nMax.y), near);
        corners[1] = worldFromClip(vec2(nMax.x, nMax.y), near);
        corners[2] = worldFromClip(vec2(nMax.x, nMin.y), near);
        corners[3] = worldFromClip(vec2(nMin.x, nMin.y), near);
        corners[4] = worldFromClip(vec2(nMin.x, nMax.y), far);
        corners[5] = worldFromClip(vec2(nMax.x, nMax.y), far);
        corners[6] = worldFromClip(vec2(nMax.x, nMin.y), far);
        corners[7] = worldFromClip(vec2(nMin.x, nMin.y), far);
    }

    // Each thread tests one sphere slot. Inactive slots carry radius 0 (the
    // sphere stage zeroes them), so the r > 0.0 test below skips them -- no
    // per-frame active-count readback needed. u_lightCount is retained only as
    // an upper bound (== cap) for clarity.
    if (tileValid && int(li) < u_lightCount) {
        MC2LightCullSphere s = spheres[li];
        vec3 c = s.centerRadius.xyz;
        float r = s.centerRadius.w;
        if (r > 0.0 && sphereInTile(c, r, corners)) {
            uint slot = atomicAdd(s_localCount, 1u);
            if (slot < uint(LIGHTGRID_MAX_LIGHTS))
                s_survivors[slot] = s.lightIndex;
        }
    }
    barrier();

    // Thread 0: ONE global reserve, then compact-write survivors + header.
    if (li == 0u) {
        uint count = min(s_localCount, uint(u_poolStride));
        uint base = 0u;
        if (tileValid) {
            base = atomicAdd(poolCursor, count);
        }
        s_globalBase = base;
        if (tileValid) {
            imageStore(u_tileHeader, tile, uvec4(base, count, 0u, 0u));
        }
    }
    barrier();

    // Compact-write survivors to the global pool (cooperative).
    uint count = min(s_localCount, uint(u_poolStride));
    if (tileValid && li < count) {
        indexPool[s_globalBase + li] = s_survivors[li];
    }
}

#endif
