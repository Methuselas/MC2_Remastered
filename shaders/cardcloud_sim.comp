// cardcloud_sim.comp — VFX-GPU-SIM-CARDCLOUD-COMPUTE-1 (compare-only).
//
// Pipeline-validation integration ONLY: advance each LIVE particle one step
//   age      += ageRate * u_dt
//   position += velocity * u_dt
// and clear the alive flag when age >= 1. This is NOT full gosFX physics
// (no drag/ether/accel, no curve eval); it is the simple step the CPU
// reference applies identically so the COMPUTE-1 compare validates the GPU
// compute path (shader/SSBO/dispatch/barrier/readback) within float epsilon.
// Real lifetime physics parity is a separate PARITY slice (needs particle IDs).
//
// "#version 430\n" is prepended by the loader (gos_cardcloud_sim.cpp) per the
// CLAUDE.md shader-#version rule. The std430 struct below MUST stay in lockstep
// with mclib/particles/cardcloud_sim.h CardCloudSimParticle (64 B).

layout(local_size_x = 64) in;

struct Particle {
    float position[3];   //  0
    float ageRate;       // 12
    float velocity[3];   // 16
    float age;           // 28
    vec4  color;         // 32
    float size;          // 48
    float lifetime;      // 52
    uint  flags;         // 56  bit0 = alive
    uint  _pad;          // 60
};

layout(std430, binding = 0) buffer CardCloudSimBuf {
    Particle particles[];
};

uniform float u_dt;     // fixed validation timestep (matches the CPU reference)
uniform uint  u_count;  // number of valid records this frame

const uint kAlive = 1u;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_count) return;
    if ((particles[i].flags & kAlive) == 0u) return;

    particles[i].age += particles[i].ageRate * u_dt;
    particles[i].position[0] += particles[i].velocity[0] * u_dt;
    particles[i].position[1] += particles[i].velocity[1] * u_dt;
    particles[i].position[2] += particles[i].velocity[2] * u_dt;

    if (particles[i].age >= 1.0) {
        particles[i].flags &= ~kAlive;
    }
}
