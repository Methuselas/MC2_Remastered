// gpu_cull_patch.comp — Track C slice C1b: patch indirect draw command buffer.
//
// One invocation per bucket (typeID). Copies perBucketCount[b] into
// cmds[b].instanceCount so the indirect draw commands reflect GPU cull results.
//
// This second dispatch avoids per-dispatch ordering issues: the barrier after
// the cull dispatch makes perBucketCount[] coherent, then this patch dispatch
// copies counts into the DrawElementsIndirectCommand array before the draw.
//
// Q12 sync contracts:
//   - Caller issues GL_SHADER_STORAGE_BARRIER_BIT after cull dispatch before
//     this patch dispatch.
//   - Caller issues GL_SHADER_STORAGE_BARRIER_BIT | GL_COMMAND_BARRIER_BIT
//     after this patch dispatch before glMultiDrawElementsIndirect.
//   - DO NOT add GL_ATOMIC_COUNTER_BARRIER_BIT — no ACBOs used.
//
// #version 430 is injected by the C++ loader — do NOT add it here.

layout(local_size_x = 64) in;

// ---------------------------------------------------------------------------
// DrawElementsIndirectCommand layout (std430, matches C++ struct).
// ---------------------------------------------------------------------------
struct DrawElementsIndirectCommand {
    uint count;          // index count (immutable — set at mission load)
    uint instanceCount;  // GPU-written: set to perBucketCount[b] each frame
    uint firstIndex;     // byte offset / sizeof(index) into IBO
    int  baseVertex;     // offset into VBO
    uint baseInstance;   // base offset into visibleIds[] for this bucket
};

// Binding 16: per-cmd base instance values written by batcher_prepareBaseInstanceTable()
// CPU-side each frame. One uint32 per sorted draw command. Read when u_legacyBaseInstance==0.
// Slot reserved to this feature (verified: no other shader uses binding 16).
layout(std430, binding = 16) readonly buffer BaseInstanceByCmd {
    uint baseInstanceByCmd[];
};

// 0 = global-pool path (write cmds[c].baseInstance from SSBO; safe DCE default).
// 1 = legacy per-type-cap path (baseInstance set at build time; skip write here).
uniform int u_legacyBaseInstance;

// Binding 10: per-bucket instance count accumulators written by cull dispatch.
// Layout: [bucketCountData[0..N-1]=perBucketCount, bucketCountData[N]=overflowCount]
// Same flat-array layout as used in gpu_cull.comp BucketCounts block.
layout(std430, binding = 10) readonly buffer BucketCounts {
    uint bucketCountData[];
};

// Binding 11: indirect draw command array (GL_DRAW_INDIRECT_BUFFER content).
// Plan v3.8 Step 10.1 — `writeonly` removed. Step 10.2 below reads
// cmds[sortedSlot].count to gate the instanceCount write for zero-packet
// types. Default (read+write) layout is required.
layout(std430, binding = 11) buffer IndirectCmds {
    DrawElementsIndirectCommand cmds[];
};

// Plan v3.8 Step 10.1 — natural-typeID → sorted-slot remap.
// permutation[typeID] == sortedSlot when coalesce is armed; identity
// (permutation[t] == t) when coalesce is disarmed (Step 5.4 guarantee).
// Either way the patch shader writes through this indirection so the
// armed and disarmed code paths share the same dispatch body.
//
// Binding 15: history is 13 (collided with BlockVis at
// gpu_cull_block_rollup.comp:58) → 14 (collided with diagnostic readback
// at gpu_cull_compute.cpp:855) → 15 (verified free against shaders/ AND
// C++ binding readbacks). C++ binds via Step 10.3 envelope around the
// dispatch in compute_dispatch().
layout(std430, binding = 15) readonly buffer PermutationBuf {
    uint permutation[];
};

// 2026-05-11 per-packet rework. Cmd → bucket (typeID) lookup, one uint
// per cmd. Drives the per-packet layout where multi-packet types emit
// multiple cmds but share one bucket count. Used when u_useCmdToBucket=1.
layout(std430, binding = 7) readonly buffer CmdToBucket {
    uint cmdToBucket[];
};

uniform int u_nBuckets;
uniform int u_nCmds;          // total indirect cmds (per-packet count when armed)
uniform int u_useCmdToBucket; // 1 = per-packet path; 0 = legacy per-type

void main() {
    uint c = gl_GlobalInvocationID.x;

    if (u_useCmdToBucket != 0) {
        // Per-packet path: dispatch per-cmd. Look up the cmd's bucket
        // (typeID) via cmdToBucket[c], write that bucket's instanceCount.
        // All packet-cmds of one type get the same count.
        if (c >= uint(u_nCmds)) return;
        uint bucketID = cmdToBucket[c];
        uint n = (bucketID < uint(u_nBuckets)) ? bucketCountData[bucketID] : 0u;
        if (cmds[c].count == 0u) { n = 0u; }
        cmds[c].instanceCount = n;
        // Global-pool path: write per-cmd baseInstance from CPU prefix-sum table.
        if (u_legacyBaseInstance == 0) {
            cmds[c].baseInstance = baseInstanceByCmd[c];
        }
    } else {
        // Legacy per-type: invocation index = bucket = typeID.
        if (c >= uint(u_nBuckets)) return;
        uint sortedSlot = permutation[c];
        uint n = bucketCountData[c];
        if (cmds[sortedSlot].count == 0u) { n = 0u; }
        cmds[sortedSlot].instanceCount = n;
    }
}
