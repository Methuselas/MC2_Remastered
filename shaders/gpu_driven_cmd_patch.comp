// shaders/gpu_driven_cmd_patch.comp — Phase C shared across buckets
//
// Single-invocation dispatch that reads BucketHeader.visibleCount and writes
// DrawArraysIndirectCommand.count for each cmd slot.
//
// After the water cull/pack dispatch (gpu_driven_water.comp) is complete and
// a GL_SHADER_STORAGE_BARRIER_BIT has been issued, this shader translates the
// atomicAdd-accumulated visibleCount into a vertex count for each indirect
// draw command:
//   cmds[i].count = visibleCount * u_vertsPerElement
//
// The water fast path emits u_vertsPerElement vertices per visible thin record
// (e.g. 6 for two triangles per quad). u_cmdCount covers all indirect cmds
// that should reflect this bucket's cull result.
//
// #version 430 is prepended by host-side program builder — do NOT add it here.
//
// Bindings:
//   0 — GpuDrivenBucketHeader  (input, visibleCount from cull dispatch)
//   1 — DrawArraysIndirectCommand[] (output, cmd array for glDrawArraysIndirect)
//
// Uniforms:
//   u_vertsPerElement — vertices per thin record emitted by the VS (e.g. 6)
//   u_cmdCount        — number of cmds[] entries to patch

layout(local_size_x = 1) in;

// ---------------------------------------------------------------------------
// GpuDrivenBucketHeader — 16 B std430. Trailing-underscore pads per project rule.
// Must match gpu_driven_water.comp and the C++ host-side layout.
// ---------------------------------------------------------------------------
struct GpuDrivenBucketHeader {
    uint visibleCount;
    uint pad0_;
    uint pad1_;
    uint pad2_;
};

// ---------------------------------------------------------------------------
// DrawArraysIndirectCommand — 16 B std430.
// Layout matches the GL spec for GL_DRAW_INDIRECT_BUFFER:
//   count         — total vertex count for glDrawArrays
//   instanceCount — number of instances (always 1 for the water fast path)
//   first         — starting vertex index (always 0; VS computes from gl_VertexID)
//   baseInstance  — base instance (always 0; no instanced attribute arrays)
// ---------------------------------------------------------------------------
struct DrawArraysIndirectCommand {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
};

// ---------------------------------------------------------------------------
// SSBO bindings
// ---------------------------------------------------------------------------
layout(std430, binding = 0) readonly  buffer Header { GpuDrivenBucketHeader      hdr;    };
layout(std430, binding = 1) writeonly buffer Cmds   { DrawArraysIndirectCommand  cmds[]; };

// ---------------------------------------------------------------------------
// Uniforms.
// 'uniform uint' crashes this engine's shader compile (memory/uniform_uint_crash.md);
// use int + cast.
// ---------------------------------------------------------------------------
uniform int u_vertsPerElement;
uniform int u_cmdCount;

// ---------------------------------------------------------------------------
// main — single invocation; patches all cmd slots with the cull result.
// ---------------------------------------------------------------------------
void main() {
    uint vis    = hdr.visibleCount;
    uint verts  = vis * uint(u_vertsPerElement);
    uint nCmds  = uint(u_cmdCount);

    for (uint i = 0u; i < nCmds; ++i) {
        cmds[i].count         = verts;
        cmds[i].instanceCount = 1u;
        cmds[i].first         = 0u;
        cmds[i].baseInstance  = 0u;
    }
}
