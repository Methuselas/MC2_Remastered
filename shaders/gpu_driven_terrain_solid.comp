// shaders/gpu_driven_terrain_solid.comp — Phase C Stage 2 (GPU-direct)
//
// Cull/pack pass for terrain SOLID quads. One invocation per recipe slot
// (u_windowCount = g_denseRecipes.size() = realVerticesMapSide²).
//
// For each invocation:
//   1. Fetch the mission-static TerrainQuadRecipe from binding 0 at index id.
//   2. Skip edge quads (mx >= mapSide-1 or my >= mapSide-1) — no right/bottom neighbor.
//   3. Read nodeId from recipe._wp2 (floatBitsToUint); look up thSlot in LUT (binding 2).
//      Skip if thSlot == 0 (nodeId not resolved or invalid).
//   4. Project all 4 world-space corners through u_terrainMVP to get pz.
//   5. Apply per-triangle pz-valid gate (pz + FUDGE ∈ [0,1)) — drop if both tris cull.
//   6. Read per-vertex lightRGB from Phase 1's lighting SSBO at binding 1.
//   7. Allocate an output slot via atomicAdd on GpuDrivenBucketHeader.visibleCount.
//   8. Pack a TerrainQuadThinRecord byte-identical to the CPU pack loop.
//
// Struct layouts are LOCKSTEP with C++ counterparts (verified by grep at write-time):
//   TerrainQuadRecipe       — gos_terrain_patch_stream.h:87-97  (144 B, alignas(16))
//   TerrainQuadThinRecord   — gos_terrain_patch_stream.h:103-11 ( 32 B, alignas(16))
//   GpuTerrainLightingOutput— gos_terrain_lighting.h:56-59      (  8 B, alignas(4))
//
// Terrain handle LUT (binding 2 — per-frame, uint[MC_MAXTEXTURES]):
//   Index = nodeId baked into recipe._wp2 at mission load.
//   Value = resolved gosHandle (tex_resolve result), or 0 if unresolved.
//   nodeId 0 = unset; skip quad. Uploaded by UploadTerrainHandleLUT() each frame.
//
// #version 430 is prepended by host-side BuildComputeProgramFromFile — do NOT add here.
//
// Bindings:
//   0 — TerrainQuadRecipe[]        (input, mission-static per-quad recipe)
//   1 — GpuTerrainLightingOutput[] (input, Phase 1 per-vertex lightRGB; same-frame)
//   2 — uint[]                     (input, terrain handle LUT: nodeId → gosHandle)
//   3 — TerrainQuadThinRecord[]    (output, packed thin records)
//   6 — GpuDrivenBucketHeader      (coherent, atomicAdd on visibleCount)
//
// Uniforms:
//   u_windowCount      — total recipe slots (= realVerticesMapSide²; dispatch range)
//   u_maxThinRecords   — capacity of thin[] output array (overflow guard)
//   u_mapSide          — realVerticesMapSide (int); used for edge-quad check + uvMode
//   u_alphaOverride    — 1 when Terrain::terrainTextures2 != nullptr; forces lightRGB=0xFFFFFFFF
//   u_terrainMVP       — row-major 4×4 terrain MVP (uploaded GL_FALSE).
//                        See memory/terrain_mvp_gl_false.md.

layout(local_size_x = 64) in;

// ---------------------------------------------------------------------------
// TerrainQuadRecipe — lockstep with gos_terrain_patch_stream.h:87-97 (144 B)
//
// 9 vec4s in std430 layout (row-order in the struct, column-order in SSBO):
//   pos0  = (wx0, wy0, wz0, _wp0)  — _wp0: 4-corner material types packed as bytes
//   pos1  = (wx1, wy1, wz1, _wp1)  — _wp1 low bit: uvMode (baked at mission start)
//   pos2  = (wx2, wy2, wz2, _wp2)  — _wp2: terrain handle slot (bit-cast uint)
//   pos3  = (wx3, wy3, wz3, _wp3)  — _wp3: cement word (bit-cast uint)
//   norm0 = (nx0, ny0, nz0, _np0)  — not read by this shader
//   norm1 = (nx1, ny1, nz1, _np1)
//   norm2 = (nx2, ny2, nz2, _np2)
//   norm3 = (nx3, ny3, nz3, _np3)
//   uvExt = (minU, minV, maxU, maxV)
// ---------------------------------------------------------------------------
struct TerrainQuadRecipe {
    vec4 pos0, pos1, pos2, pos3;
    vec4 norm0, norm1, norm2, norm3;
    vec4 uvExt;
};

// ---------------------------------------------------------------------------
// TerrainQuadThinRecord — lockstep with gos_terrain_patch_stream.h:103-111 (32 B)
//
//   uint recipeIdx;     // offset  0 — top-left vertexNum (= windowIdx entry)
//   uint terrainHandle; // offset  4 — terrain texture slot
//   uint flags;         // offset  8 — bit0=uvMode, bit1=pzTri1Valid, bit2=pzTri2Valid
//   uint cementWord;    // offset 12 — was _pad0; cement layer encoding
//   uint lightRGB0;     // offset 16
//   uint lightRGB1;     // offset 20
//   uint lightRGB2;     // offset 24
//   uint lightRGB3;     // offset 28
// ---------------------------------------------------------------------------
struct TerrainQuadThinRecord {
    uint recipeIdx;
    uint terrainHandle;
    uint flags;
    uint cementWord;
    uint lightRGB0, lightRGB1, lightRGB2, lightRGB3;
    // Fix B 2026-05-14: per-corner clip-space positions, written here
    // (alongside pzOk gate computation) so the VS skips terrainMVP entirely
    // — eliminates the temporal MVP misalignment root cause at its source.
    // Std430 vec4[4] = 64 B, 16-aligned, contiguous. Total record: 96 B.
    // LOCKSTEP with C++ struct in gos_terrain_patch_stream.h + VS reader
    // in gos_terrain_thin.vert + frag mirror in gos_terrain.frag.
    vec4 clipPos[4];
};

// Flag bit encoding — matches PackThinRecordsForFrame() gos_terrain_indirect.cpp:1470-1472.
const uint kThinFlagUvMode     = 0x1u;  // bit 0: uvMode (0=TOPRIGHT, 1=BOTTOMLEFT)
const uint kThinFlagPzTri1     = 0x2u;  // bit 1: pzTri1Valid
const uint kThinFlagPzTri2     = 0x4u;  // bit 2: pzTri2Valid

// ---------------------------------------------------------------------------
// GpuDrivenBucketHeader — 16 B std430.
// ---------------------------------------------------------------------------
struct GpuDrivenBucketHeader {
    uint visibleCount;
    uint pad0_;
    uint pad1_;
    uint pad2_;
};

// ---------------------------------------------------------------------------
// DrawArraysIndirectCommand — 16 B std430.
// Layout LOCKSTEP with gpu_driven_cmd_patch.comp:47-52 and the C++ host-side
// type at gos_terrain_indirect.cpp DrawArraysIndirectCommand (16 B, 4 GLuints).
// Step 2 of VPL retirement: primary compute writes cmds[0].count directly via
// atomicAdd, replacing the cmd-patch dispatch that translates visibleCount→count.
// Bound at slot 8 when MC2_SOLID_CMD_PATCH_RETIRE=1 (parity arm in commit 2a;
// default-on after flip in commit 2b).
// ---------------------------------------------------------------------------
struct DrawArraysIndirectCommand {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
};

// ---------------------------------------------------------------------------
// GpuTerrainLightingOutput — lockstep with gos_terrain_lighting.h:56-59 (8 B).
//   uint lightRGB;  // offset 0 — BGRA-packed per memory/mc2_argb_packing.md
//   uint fogRGB;    // offset 4 — not written to SOLID thin record (no fogRGB field)
// One entry per terrain vertex, indexed by vertexNum = mapY*mapSide + mapX.
// ---------------------------------------------------------------------------
struct GpuTerrainLightingOutput {
    uint lightRGB;
    uint fogRGB;
};

// ---------------------------------------------------------------------------
// SSBO bindings
// ---------------------------------------------------------------------------
layout(std430, binding = 0) readonly  buffer Recipes  { TerrainQuadRecipe        recipes[];          };
layout(std430, binding = 1) readonly  buffer Lighting  { GpuTerrainLightingOutput lighting[];         };
layout(std430, binding = 2) readonly  buffer HandleLut { uint                     terrainHandleLut[]; };
// AMD L1-coherency fix (mc2-cpu-gpu-offload-expert, 2026-05-14):
// On AMD RDNA1/2/3, cross-stage SSBO writes-then-reads in the same frame can
// expose stale L1 vector cache lines to the reader (VS) even after the
// explicit glMemoryBarrier(GL_SHADER_STORAGE_BARRIER_BIT).  The qualifier
// `coherent` forces the compiler to emit cache-bypass loads/stores, and the
// reader-side `coherent` invalidates the relevant cache lines on read.  The
// project applies this consistently in gpu_cull.comp / gpu_cull_block_rollup.comp
// and on the bucket header below, but the thin record stream was inconsistent.
// Suspected root cause of the giant-grey-triangle-under-fast-rotation bug
// (probe trail: docs/superpowers/progress/2026-05-13-raster-triangle-probe-state.md).
layout(std430, binding = 3) coherent  writeonly buffer Thin      { TerrainQuadThinRecord    thin[];             };
layout(std430, binding = 6) coherent  buffer Header    { GpuDrivenBucketHeader    hdr;                };
// Probe 6 + 7a: canary buffer.  Stride is 2 uints per record: [recipeIdx, flags].
// Bridge never binds this buffer, so nothing else in the GL pipeline can touch
// it.  If thin[i].recipeIdx != canary[2*i] OR thin[i].flags != canary[2*i+1]
// on C++-side comparison, the thin SSBO has been clobbered between compute
// write and our readback — and we can identify WHICH field was hit.
// flags field is the prime suspect post-coherent-qualifier falsification.
layout(std430, binding = 7) coherent  writeonly buffer Canary    { uint                     canaryWord[];       };
// Step 2a (VPL retirement): direct write of indirect-draw cmd.count by the
// primary dispatch when u_cmdPatchRetire != 0.  Coherent + buffer (not
// writeonly) because we atomicAdd into cmds[0].count; the cmd-patch shader
// still also writes this slot in commit 2a (dual-path parity), so coherent is
// load-bearing.  Binding 8 chosen to not collide with bindings 0..7 above.
layout(std430, binding = 8) coherent  buffer CmdBuf   { DrawArraysIndirectCommand cmds[];             };

// ---------------------------------------------------------------------------
// Uniforms.
// 'uniform uint' crashes this engine's shader compile (memory/uniform_uint_crash.md);
// use int + cast where the value is passed from C++ as GLint.
// ---------------------------------------------------------------------------
uniform int  u_windowCount;
uniform int  u_maxThinRecords;
uniform int  u_mapSide;          // realVerticesMapSide
uniform int  u_alphaOverride;    // 1 when Terrain::terrainTextures2 != nullptr
// Step 2b (VPL retirement): bucket-header SSBO (binding 6) and the pad1_ /
// pad2_ diagnostic atomicAdd writes are demoted behind
// MC2_BUCKET_HEADER_TRACE.  When 0 the binding is unbound on the C++ side
// and the in-shader writes are skipped.  Reads must still be guarded so we
// do not touch an unbound slot.
uniform int  u_bucketHeaderTrace;
uniform mat4 u_terrainMVP;
uniform float u_worldUnitsPerVertex;  // Terrain::worldUnitsPerVertex; probe-5 spread check

// ---------------------------------------------------------------------------
// Depth fudge — matches TERRAIN_DEPTH_FUDGE at gos_terrain_indirect.cpp.
// Mirrors PackThinRecordsForFrame and gos_terrain_thin.vert:176.
// Doubled 0.001→0.002 post glClipControl(ZERO_TO_ONE); see quad.cpp:1921.
// Gate is pz_adj ∈ [0,1), equivalent to pz ∈ [-FUDGE, 1-FUDGE).
// ---------------------------------------------------------------------------
const float kTerrainDepthFudge = 0.002;

// ---------------------------------------------------------------------------
// projectZ — project world-space position through u_terrainMVP and return
// the perspective-divided z (NDC depth). Matches CPU projectZ / vertexProjectLoop.
// See memory/terrain_mvp_gl_false.md for the row-major / GL_FALSE convention.
// No guard on clip.w <= 0 — both z and w can be negative at map boundaries
// (oblique camera convention, see memory/clip_w_sign_trap.md). clip.z*rhw
// with negative w gives a value the CPU pzOk gate also sees; no early return.
// ---------------------------------------------------------------------------
float projectZ(float wx, float wy, float wz) {
    vec4 clip = u_terrainMVP * vec4(wx, wy, wz, 1.0);
    float rhw = (clip.w != 0.0) ? 1.0 / clip.w : 1.0;
    return clip.z * rhw;
}

// Fix B helper: return the full clip-space vec4 for storage in the thin
// record's clipPos[c] field.  Same math as projectZ() but without the
// rhw divide — the writer keeps raw clip and the VS does its own 1/w.
// Keeping projectZ() separate (rather than refactoring it to return vec4
// and computing rhw at every call site) preserves the pzOk gate's exact
// existing math, removing one axis of risk for the schema change.
vec4 projectClip(float wx, float wy, float wz) {
    return u_terrainMVP * vec4(wx, wy, wz, 1.0);
}

// Probe-4 helper: return |clip.w| for the same projection.  Used by the
// near-zero-clip.w detector to count quads that pass pzOk with one or more
// corners straddling the camera plane (where clip.w ~ 0 produces wild VS
// projection — see memory/clip_w_sign_trap.md).
float absClipW(float wx, float wy, float wz) {
    vec4 clip = u_terrainMVP * vec4(wx, wy, wz, 1.0);
    return abs(clip.w);
}

// pzOk — with TERRAIN_DEPTH_FUDGE applied. Mirrors packer:1435-1436.
bool pzOk(float pz) {
    float adj = pz + kTerrainDepthFudge;
    return adj >= 0.0 && adj < 1.0;
}

// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------
void main() {
    uint id = uint(gl_GlobalInvocationID.x);
    if (id >= uint(u_windowCount)) return;

    // id is the recipe index (= top-left vertexNum vn0 in the dense recipe array).
    // Skip edge quads — no right or bottom neighbor exists.
    uint ms_  = uint(u_mapSide);
    uint mx_  = id % ms_;
    uint my_  = id / ms_;
    if (mx_ >= ms_ - 1u || my_ >= ms_ - 1u) return;

    uint vn0 = id;
    TerrainQuadRecipe r = recipes[vn0];

    // ─── Probe 5 (recipe corner-spread sanity check, 2026-05-14) ─────────
    // Recipe corners (worldPos0..3) should span at most ONE cell width in
    // each axis — they're the 4 corners of a single map quad whose
    // top-left vertex is at vn0.  If any axis spread exceeds a generous
    // 2.5× worldUnitsPerVertex, the recipe entry is CORRUPT (its corners
    // are pointing somewhere else on the map).  Such a recipe would, if
    // it passes the cull gate, draw a giant triangle stretching across
    // the world — exactly matching the symptom we're chasing.  Count
    // such corrupt recipes per frame via pad2_.  Read back on C++ side.
    {
        float minX = min(min(r.pos0.x, r.pos1.x), min(r.pos2.x, r.pos3.x));
        float maxX = max(max(r.pos0.x, r.pos1.x), max(r.pos2.x, r.pos3.x));
        float minY = min(min(r.pos0.y, r.pos1.y), min(r.pos2.y, r.pos3.y));
        float maxY = max(max(r.pos0.y, r.pos1.y), max(r.pos2.y, r.pos3.y));
        float spreadX = maxX - minX;
        float spreadY = maxY - minY;
        float kLimit = 2.5 * u_worldUnitsPerVertex;
        if ((spreadX > kLimit || spreadY > kLimit) && u_bucketHeaderTrace != 0) {
            atomicAdd(hdr.pad2_, 1u);
        }
    }

    // cementWord read before the thSlot gate: cement quads use the cement atlas
    // (tex3) in the fragment shader and must not be gated on thSlot.
    // peekTextureHandle() in the C++ cache builder returns 0xffffffff for cement
    // textures whose gos node was never explicitly resolved — those quads have
    // nodeId == 0xffffffff, which would otherwise cause an unconditional skip.
    // The fragment shader does not read thSlot for cement quads (control.y is
    // declared but never used in the frag body for atlas-path quads).
    uint cementWord = floatBitsToUint(r.pos3.w);
    bool cementQuad = (cementWord & 0x80000000u) != 0u;

    // Resolve terrain handle via LUT: nodeId baked into recipe._wp2 at mission load.
    // Non-cement quads: skip when nodeId is invalid or unresolved (no colormap tile).
    // Cement quads: allow through even with invalid/evicted nodeId — atlas rendering
    // uses cementWord + WorldPos, not thSlot.
    uint nodeId = floatBitsToUint(r.pos2.w);
    uint thSlot;
    if (nodeId == 0u || nodeId >= uint(terrainHandleLut.length())) {
        if (!cementQuad) return;
        thSlot = 1u;  // dummy: frag shader ignores thSlot for cement-atlas quads
    } else {
        thSlot = terrainHandleLut[nodeId];
        if ((thSlot == 0u || thSlot == 0xFFFFFFFFu) && !cementQuad) return;
        if (thSlot == 0u || thSlot == 0xFFFFFFFFu) thSlot = 1u;  // cement with evicted handle
    }

    // -----------------------------------------------------------------------
    // Project all 4 world corners through terrainMVP to get per-vertex pz.
    // Corner ordering matches gos_terrain_patch_stream.h + PackThinRecordsForFrame:
    //   corner 0 = (wx0,wy0,wz0) — top-left  vn = vn0
    //   corner 1 = (wx1,wy1,wz1) — top-right vn = vn0+1
    //   corner 2 = (wx2,wy2,wz2) — bot-right vn = vn0+ms+1
    //   corner 3 = (wx3,wy3,wz3) — bot-left  vn = vn0+ms
    // -----------------------------------------------------------------------
    float pz0 = projectZ(r.pos0.x, r.pos0.y, r.pos0.z);
    float pz1 = projectZ(r.pos1.x, r.pos1.y, r.pos1.z);
    float pz2 = projectZ(r.pos2.x, r.pos2.y, r.pos2.z);
    float pz3 = projectZ(r.pos3.x, r.pos3.y, r.pos3.z);

    // Fix B 2026-05-14: capture per-corner clip-space vec4 alongside the pz
    // computation above.  These are stored in tr.clipPos[c] below; the VS
    // reads them directly and bypasses terrainMVP * worldPos projection.
    // Same matrix (u_terrainMVP), same lane, same dispatch — so the pzOk
    // gate and clipPos cannot disagree about which projection-frame the
    // record describes.
    vec4 clip0 = projectClip(r.pos0.x, r.pos0.y, r.pos0.z);
    vec4 clip1 = projectClip(r.pos1.x, r.pos1.y, r.pos1.z);
    vec4 clip2 = projectClip(r.pos2.x, r.pos2.y, r.pos2.z);
    vec4 clip3 = projectClip(r.pos3.x, r.pos3.y, r.pos3.z);

    bool ok0 = pzOk(pz0);
    bool ok1 = pzOk(pz1);
    bool ok2 = pzOk(pz2);
    bool ok3 = pzOk(pz3);

    // uvMode derived from (mx, my) parity — matches worldQuadUVMode() mapdata.cpp:117:
    //   ((tileR & 1) == (tileC & 1)) ? BOTTOMRIGHT : BOTTOMLEFT
    // With tileR=my=vn0/mapSide, tileC=mx=vn0%mapSide:
    //   isBottomLeft = ((mx & 1) != (my & 1))
    // Same convention as PackThinRecordsForFrame:1439 uvMode = q.uvMode.
    bool isBottomLeft = ((mx_ & 1u) != (my_ & 1u));

    bool pzTri1, pzTri2;
    if (!isBottomLeft) {
        // TOPRIGHT (uvMode=0): tri1 = corners (0,1,2), tri2 = corners (0,2,3)
        pzTri1 = ok0 && ok1 && ok2;
        pzTri2 = ok0 && ok2 && ok3;
    } else {
        // BOTTOMLEFT (uvMode=1): tri1 = corners (0,1,3), tri2 = corners (1,2,3)
        pzTri1 = ok0 && ok1 && ok3;
        pzTri2 = ok1 && ok2 && ok3;
    }

    // Drop if both triangles cull — matches PackThinRecordsForFrame:1449.
    if (!pzTri1 && !pzTri2) return;

    // -----------------------------------------------------------------------
    // Compute corner vertexNums for Phase 1 lighting SSBO lookup.
    // Same formula as gpu_driven_water.comp (terrain grid = water grid layout).
    // -----------------------------------------------------------------------
    uint vn1 = vn0 + 1u;
    uint vn2 = vn0 + ms_ + 1u;
    uint vn3 = vn0 + ms_;

    // ─── Probe 4 (raster-triangle hypothesis: near-zero |clip.w|) ────────
    // Count quads that passed pzOk where ANY corner has |clip.w| below
    // kClipWWarn — these corners produce wild VS screen positions because
    // rhw = 1/clip.w explodes.  The VS gracefully handles abs(clip.w) but
    // pinning gl_Position to an NDC-corner via the absW rescaling can still
    // produce screen-spanning triangles.  Threshold chosen empirically as
    // ~1% of typical clip.w under oblique camera; tune via [RING_NEARW] data.
    {
        const float kClipWWarn = 0.05;
        float aw0 = absClipW(r.pos0.x, r.pos0.y, r.pos0.z);
        float aw1 = absClipW(r.pos1.x, r.pos1.y, r.pos1.z);
        float aw2 = absClipW(r.pos2.x, r.pos2.y, r.pos2.z);
        float aw3 = absClipW(r.pos3.x, r.pos3.y, r.pos3.z);
        float minAw = min(min(aw0, aw1), min(aw2, aw3));
        if (minAw < kClipWWarn && u_bucketHeaderTrace != 0) {
            // pad1_ = count of pzOk-passed quads with one or more "thin" corners
            atomicAdd(hdr.pad1_, 1u);
        }
    }

    // -----------------------------------------------------------------------
    // Allocate output slot via atomicAdd on the coherent bucket header.
    // -----------------------------------------------------------------------
    // Step 2b (VPL retirement): the primary cull/pack dispatch is the sole
    // writer of cmds[0].count.  The cmd-patch dispatch is retired.  Slot
    // admission uses a local per-thread atomicAdd on hdr.visibleCount when
    // the diagnostic bucket-header SSBO is bound (MC2_BUCKET_HEADER_TRACE=1)
    // -- and otherwise on cmds[0].count itself, which doubles as the
    // monotonically-increasing slot counter (cmd-count = admittedRecords * 6,
    // so admittedRecords = (atomicAdd return value before this record) / 6).
    //
    // C3: bound check fires BEFORE we contribute to cmds[0].count so overflow
    // records do not advance the indirect-draw count.
    uint outSlot;
    if (u_bucketHeaderTrace != 0) {
        outSlot = atomicAdd(hdr.visibleCount, 1u);
        if (outSlot >= uint(u_maxThinRecords)) return;
        atomicAdd(cmds[0].count, 6u);
    } else {
        // Derive the slot from cmds[0].count: each admitted record bumps the
        // counter by 6u, so the (atomic returned value) / 6u is this record's
        // slot.  atomicAdd returns the value BEFORE the increment, matching
        // the prior atomicAdd(hdr.visibleCount, 1u) semantics.
        uint prev = atomicAdd(cmds[0].count, 6u);
        outSlot = prev / 6u;
        if (outSlot >= uint(u_maxThinRecords)) {
            // Roll back: subtract the 6u we just contributed so cmd.count
            // does not overshoot kMaxThinRecords * 6 in steady state.
            // atomicAdd of (0xFFFFFFFFu - 5u) == -6 mod 2^32 (two's complement).
            // Benign race: multiple workgroups can roll back; cmd.count
            // oscillates near the cap.  outSlot uniqueness is preserved
            // because atomicAdd returns a unique pre-increment value per call
            // regardless of subsequent rollbacks.
            atomicAdd(cmds[0].count, 0xFFFFFFFAu);
            return;
        }
    }

    // -----------------------------------------------------------------------
    // Build thin record fields from recipe and lighting SSBO.
    // -----------------------------------------------------------------------

    // thSlot and cementWord were resolved above from the recipe LUT fields.

    // flags: bit0=uvMode, bit1=pzTri1Valid, bit2=pzTri2Valid
    uint thinFlags = (isBottomLeft ? kThinFlagUvMode : 0u)
                   | (pzTri1       ? kThinFlagPzTri1  : 0u)
                   | (pzTri2       ? kThinFlagPzTri2  : 0u);

    // lightRGB per corner from Phase 1 SSBO (same-frame, after PackAndDispatch barrier).
    // alphaOverride: when terrainTextures2 is active, whitens all lighting.
    // Matches PackThinRecordsForFrame:1458-1465.
    // Note: pVertex->selected check (→ 0xffff7fffu) is skipped here; parity
    // will flag selection events as minor mismatches (rare gameplay condition).
    uint lrgb0, lrgb1, lrgb2, lrgb3;
    if (u_alphaOverride != 0) {
        lrgb0 = lrgb1 = lrgb2 = lrgb3 = 0xFFFFFFFFu;
    } else {
        lrgb0 = lighting[vn0].lightRGB;
        lrgb1 = lighting[vn1].lightRGB;
        lrgb2 = lighting[vn2].lightRGB;
        lrgb3 = lighting[vn3].lightRGB;
    }

    // -----------------------------------------------------------------------
    // Write thin record — byte-identical to PackThinRecordsForFrame output
    // when recipe pads are correctly baked. Verified by ComputeDispatchParity_Check.
    // -----------------------------------------------------------------------
    TerrainQuadThinRecord tr;
    tr.recipeIdx     = vn0;
    tr.terrainHandle = thSlot;
    tr.flags         = thinFlags;
    tr.cementWord    = cementWord;
    tr.lightRGB0     = lrgb0;
    tr.lightRGB1     = lrgb1;
    tr.lightRGB2     = lrgb2;
    tr.lightRGB3     = lrgb3;
    // Fix B 2026-05-14: per-corner clip vec4s (computed at pz time above).
    tr.clipPos[0]    = clip0;
    tr.clipPos[1]    = clip1;
    tr.clipPos[2]    = clip2;
    tr.clipPos[3]    = clip3;
    thin[outSlot]    = tr;

    // Probe 6 + 7a: canary writes — recipeIdx at 2*outSlot, flags at 2*outSlot+1.
    // If thin[outSlot].recipeIdx ever != canaryWord[2*outSlot] OR
    // thin[outSlot].flags ever != canaryWord[2*outSlot+1] when sampled after
    // barrier, the thin SSBO is being clobbered.  Identifies WHICH field hit.
    canaryWord[2u * outSlot]      = vn0;
    canaryWord[2u * outSlot + 1u] = thinFlags;
}
