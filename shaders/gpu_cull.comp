// gpu_cull.comp — Track C: GPU visibility compute shader.
//
// C1a mode (default): shadow/diagnostic only — fills debug SSBO (binding 9)
//   so compute_emitParitySummary() can compare GPU vs CPU inView.
//   CPU still renders normally; zero change to rendering output.
//
// C1b mode (GPU_CULL_C1B_INDIRECT defined): indirect draw authority for
//   static props. Additionally writes:
//   - visibleIds[] (binding 9)  — per-bucket instance ID list for indirect draw
//   - perBucketCount[] (binding 10) — per-bucket visible counts (patch dispatch copies
//     these into cmds[].instanceCount via gpu_cull_patch.comp)
//   - actorVisBits[] (binding 12) — per-actor 0/1 visibility for rollup kernel
//
// Q12 contracts (C1b):
//   - GL_SHADER_STORAGE_BARRIER_BIT after this dispatch before patch dispatch
//   - GL_COMMAND_BARRIER_BIT after patch dispatch before glMultiDrawElementsIndirect
//   - DO NOT add GL_ATOMIC_COUNTER_BARRIER_BIT (no ACBOs used)
//
// #version 430 is injected by the C++ loader — do NOT add it here.

layout(local_size_x = 64) in;

// ---------------------------------------------------------------------------
// GpuActorRecord: mirror of gpu_cull_record.h (std430, 64 B per element).
// LOCKSTEP: field order and types must match the C++ struct exactly.
// ---------------------------------------------------------------------------
struct GpuActorRecord {
    vec3     worldCenter;      // offset 0  (12 B)
    float    boundingRadius;   // offset 12 (4 B)
    vec3     worldAabbMin;     // offset 16 (12 B)
    uint     category;         // offset 28 (4 B)
    vec3     worldAabbMax;     // offset 32 (12 B)
    uint     flags;            // offset 44 (4 B)
    uint     actorId;          // offset 48 (4 B)
    uint     prevVisibilityBit;// offset 52 (4 B)
    uint     consumerFlags;    // offset 56 (4 B)
    uint     blockIdx;         // offset 60 (4 B) — terrain block index for C1-RB rollup
};

struct GpuActorRecordHeader {
    uint recordCount;    // set by CPU at flushUpload()
    uint recordCapacity; // mission-load constant
    uint visibleCount;   // written by compute (C1+); C1a writes debug SSBO, not this
    uint _pad0;
};

// ---------------------------------------------------------------------------
// Binding 8: input from C0 substrate (persistent-mapped triple-buffered SSBO).
// Same binding point as SUBSTRATE_SSBO_BINDING in gpu_cull_substrate.cpp.
// ---------------------------------------------------------------------------
layout(std430, binding = 8) readonly buffer RecordsBuf {
    GpuActorRecordHeader hdr;
    GpuActorRecord recs[];
};

// ---------------------------------------------------------------------------
// Binding 9:
//   C1a mode: debug output — [gpuVisibleCount][gpuCulledCount][visibilityResults[]]
//   C1b mode: visibleIds[] — per-bucket compact visible instance ID list
//             (indexed as visibleIds[bucketBase[bucket] + atomicSlot])
//
// In C1b the old debug totals are no longer written here; use perBucketCount
// overflow sentinel for summary logging.
// ---------------------------------------------------------------------------
#ifdef GPU_CULL_C1B_INDIRECT

// C1b bindings -----------------------------------------------------------------

// Binding 9: visible instance IDs, concatenated per-bucket.
// Layout: visibleIds[bucketBase[b] + slot] = local instance index for bucket b.
// baseInstance in the indirect command is bucketBase[b] so gl_BaseInstance
// addresses the correct range in the vertex shader.
layout(std430, binding = 9) coherent buffer VisibleIds {
    uint visibleIds[];
};

// Binding 10: per-bucket accumulated counts + overflow sentinel.
// Layout: [perBucketCount[0] .. perBucketCount[N-1], overflowCount(at [N_BUCKETS])]
// Addressed as a flat uint array; overflowCount is at index u_nBuckets.
// Cleared per-frame by glClearNamedBufferSubData before dispatch.
layout(std430, binding = 10) coherent buffer BucketCounts {
    uint bucketCountData[];  // [0..N_BUCKETS-1]=perBucketCount, [N_BUCKETS]=overflowCount
};
// Access helpers:
// bucketCountData[b]           = perBucketCount for bucket b
// bucketCountData[u_nBuckets]  = overflow sentinel

// Binding 11: per-bucket capacity + base (immutable per-mission, set at mission load).
// Layout: [bucketCapacity[0..N-1], bucketBase[0..N-1]] — flat array of 2*N uints.
// Index as: capacity[b] = capsData[b], base[b] = capsData[u_nBuckets + b].
layout(std430, binding = 11) readonly buffer BucketCaps {
    uint capsData[];  // [0..N-1]=capacity, [N..2N-1]=base offsets into visibleIds[]
};

// Binding 12: per-actor visibility bits for the block rollup kernel.
// 1 = admitted by this frame's cull, 0 = culled. Reset per-frame by C++.
layout(std430, binding = 12) coherent buffer ActorVis {
    uint actorVisBits[];
};

// Number of buckets (= type count, set at mission load). Used to address
// bucketCountData[] and capsData[] second half.
// 'uniform uint' crashes this engine's compile (memory/uniform_uint_crash.md);
// use int + cast.
uniform int u_nBuckets;

// CategoryMask lower 4 bits; upper bits hold the bucket (typeID) for static props.
// Cat_StaticProp = 5u (see gpu_cull_record.h). Dynamic actors (cat != StaticProp)
// go into the actorVisBits path only; they have no bucket in the indirect system.
const uint CAT_STATIC_PROP = 5u;
const uint CATEGORY_MASK   = 0xFu;

// Binding 13: per-block STICKY visibility bits (C1b temporal-superset
// META-FIX, sticky-bit revision). Written by gpu_cull_block_rollup.comp via
// atomicOr(blockVisBits[blk], 1u). Once a block has ever been frustum-visible
// during this mission its bit is set permanently; the per-mission one-shot
// zero at gpu_cull_compute.cpp:779-784 (also props-less free at :541-542
// and Mission::destroy free at :483-488) are the SOLE clearing paths.
// Strictly conservative: sticky-bit admits a SUPERSET of any K-frame
// rolling window. The :1074 rollup→barrier→cull ordering carries forward
// (cull still reads bits set by prior frames). The C1a #else path must
// NOT see binding 13 — this decl stays inside the GPU_CULL_C1B_INDIRECT
// guard.
layout(std430, binding = 13) coherent buffer BlockVis {
    uint blockVisBits[];
};
uniform int uBlockCount;   // s_blockCount when allocated, else 0 (M3 fail-OPEN)

#else  // C1a mode -------------------------------------------------------------

layout(std430, binding = 9) buffer DebugOut {
    uint gpuVisibleCount;    // total actors GPU admits (this frame)
    uint gpuCulledCount;     // total actors GPU rejects (this frame)
    uint visibilityResults[];// per-actor: 1=visible, 0=culled
};

#endif  // GPU_CULL_C1B_INDIRECT

// ---------------------------------------------------------------------------
// Binding 14 (C2 readback path, secondary write — does NOT affect existing paths):
// Binding 9 is already used by C1a (DebugOut) and C1b (VisibleIds), so C2 uses
// READBACK_SSBO_BINDING (injected by build_cull_program from gpu_cull_readback.h)
// to avoid any GLSL layout conflict when all three defines are active.
// ---------------------------------------------------------------------------
#ifdef GPU_CULL_C2_READBACK
layout(std430, binding = READBACK_SSBO_BINDING) coherent buffer ReadbackBuf {
    uint rb_visibleCount;   // header[0] — atomicAdd per admitted actor
    uint rb_frameIndex;     // header[1] — set by CPU before dispatch
    uint rb_dilatedAdmits;  // header[2] — actors admitted by dilation but not strict cull
    uint rb_pad1;           // header[3]
    uint rb_actorVisible[]; // per-actor: 1=visible, 0=culled (after dilation)
};
#endif  // GPU_CULL_C2_READBACK

// ---------------------------------------------------------------------------
// Binding 2: frustum UBO — view-projection matrix + ring-slot info.
// gos_GetTerrainMVPMat4() returns a 16-float row-major matrix; uploaded GL_FALSE.
// In GLSL, viewProj * vec4(center, 1.0) implements the row-vector convention
// and gives the correct clip-space result.
//
// slotRecordStart: index (in GpuActorRecord units) of the first record in the
//   current ring slot. Because the substrate is triple-buffered, recs[] in the
//   full SSBO contains RING_FRAMES * capacity records. We index into the active
//   slot as recs[slotRecordStart + i].
// slotRecordCount: number of valid records in the active slot (= hdr.recordCount
//   for the slot; redundant with hdr but avoids reading the slot-0 header when
//   the active slot is 1 or 2).
// ---------------------------------------------------------------------------
layout(std140, binding = 2) uniform CullUBO {
    mat4 viewProj;
    uint slotRecordStart;  // index in recs[] of the active slot's first record
    uint slotRecordCount;  // number of valid records in the active slot
    uint _pad0;
    uint _pad1;
    // Dilation slice: frustum half-extent inflation factor (default 0.08).
    // 0.0 reproduces strict legacy cull. See gpu_cull_compute.cpp env wiring.
    float frustumDilation;
    float _pad2;
    float _pad3;
    float _pad4;
};

// ---------------------------------------------------------------------------
// Lockstep port of mclib/object_admission_predicate.cpp clipSpaceFrustumAdmit().
// See shaders/gpu_cull_predicate.glsl for the canonical definition.
// Both files must change together in the same commit (cross-slice lockstep rule).
// ---------------------------------------------------------------------------
#include <gpu_cull_predicate.glsl>

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;

    // Bounds check using the active slot's record count from the UBO.
    // We use slotRecordCount (from the UBO) rather than hdr.recordCount because
    // hdr is always the header of the FIRST ring slot (offset 0), whereas the
    // active slot may be slot 1 or slot 2. The UBO field is set correctly by
    // compute_dispatch() for whichever slot was just flushed.
    if (i >= slotRecordCount) return;

    // Index into the active ring slot using slotRecordStart offset.
    GpuActorRecord rec = recs[slotRecordStart + i];

    // Transform world-space center to clip space.
    vec4 clip = viewProj * vec4(rec.worldCenter, 1.0);

    // Frustum cull. Dilation slice: when frustumDilation > 0, the dilated
    // predicate replaces the strict one for the visibility decision and the
    // strict result is computed only for the diagnostic delta counter.
    //
    // 2026-05-10: sphere-aware admit for records that supply a non-zero
    // boundingRadius (static props from gos_static_prop_registry). The
    // strict point-in-frustum test rejects buildings whose centroid is
    // offset from the visible silhouette — a 100-unit warehouse with
    // its centroid 50 units off-axis vanishes when the camera angles
    // away even though most of it is on screen. Dynamic actors continue
    // to use the point test (boundingRadius==0 → tol=0 → identical math).
    bool visibleStrict;
    if (rec.boundingRadius > 0.0) {
        visibleStrict = clipSpaceFrustumAdmitSphere(clip, rec.boundingRadius);
    } else {
        visibleStrict = clipSpaceFrustumAdmit(clip);
    }
    bool visibleDilated = (frustumDilation > 0.0)
                            ? clipSpaceFrustumAdmitDilated(clip, frustumDilation)
                            : visibleStrict;
    bool visible = visibleStrict || visibleDilated;

    // Flag_AlwaysVisible (bit 0) overrides cull — same as CPU path.
    if ((rec.flags & 0x1u) != 0u) {
        visible        = true;
        visibleStrict  = true;
        visibleDilated = true;
    }

#ifdef GPU_CULL_C2_READBACK
    // C2 secondary write: per-actor visibility flag + global visible count.
    // ReadbackBuf is at binding 14 (separate from C1a/C1b binding-9 usage).
    rb_actorVisible[i] = visible ? 1u : 0u;
    if (visible) atomicAdd(rb_visibleCount, 1u);
    // Dilation diagnostic: count actors that the dilated test admits but
    // the strict test would have rejected. Reset per-frame by CPU.
    if (visibleDilated && !visibleStrict) atomicAdd(rb_dilatedAdmits, 1u);
    if (i == 0u) rb_frameIndex = 0xDEADu;
#endif  // GPU_CULL_C2_READBACK

#ifdef GPU_CULL_C1B_INDIRECT
    // C1b path: write per-actor visibility bit (used by block-rollup kernel).
    // RAW visible — R4: rollup self-latch reads this raw bit; do NOT widen.
    actorVisBits[i] = visible ? 1u : 0u;

    // HOISTED (R6): category decode lifted ABOVE the if(visible) gate so the
    // parallel else-if sibling below can reference `cat` in scope. Byte-
    // identical value/uses; only the decl site moved up one scope. The old
    // in-block decl was DELETED (the decl must appear exactly once).
    uint cat = rec.category & CATEGORY_MASK;
    if (visible) {
        // Only static props participate in the indirect bucket system.
        // Dynamic actors (mechs, GVs, etc.) go to actorVisBits only.
        if (cat == CAT_STATIC_PROP) {
            // The bucket (typeID) is packed in the upper 28 bits of category.
            uint bucket = rec.category >> 4;
            uint cap    = capsData[bucket];                   // bucketCapacity[b]
            uint base   = capsData[uint(u_nBuckets) + bucket];// bucketBase[b]
            uint slot   = atomicAdd(bucketCountData[bucket], 1u);
            if (slot >= cap) {
                atomicAdd(bucketCountData[uint(u_nBuckets)], 1u);  // overflowCount
            } else {
                // Store the local instance slot index (= i within the record
                // array). The vertex shader reads visibleIds[base + inst] to
                // get the per-instance SSBO index for this invocation.
                visibleIds[base + slot] = i;
            }
        }
    } else if (cat == CAT_STATIC_PROP) {
        // C1b STICKY-BIT TEMPORAL-SUPERSET sibling (option (b), R6): this prop
        // was rejected by this frame's stateless frustum test. Re-admit it
        // if its terrain block has been frustum-visible at any point during
        // this mission (set by rollup atomicOr; cleared only by the
        // per-mission one-shot zero at gpu_cull_compute.cpp:779-784). The
        // admit set is monotonically growing per mission and is a
        // superset-by-construction of any K-frame rolling window.
        // `else if` (not widening if(visible)) confines the temporal term
        // to CAT_STATIC_PROP so the dynamic mech/GV path through if(visible)
        // is byte-identical ([MECHVOL] invariant). M3 fail-OPEN: the
        // `rec.blockIdx < uint(uBlockCount)` test short-circuits (GLSL && is
        // short-circuit, spec 5.10) so when the block buffer is unallocated
        // (uBlockCount==0) binding 13 is NEVER indexed and admit falls to
        // the byte-identical if(visible) path.
        bool effVisible = (rec.blockIdx < uint(uBlockCount)) &&
            (blockVisBits[rec.blockIdx] != 0u);
        if (effVisible) {
            // Recompute bucket/cap/base/slot EXACTLY as the if(visible)
            // branch; same shared atomicAdd on bucketCountData[bucket] +
            // same slot>=cap overflow sentinel + same visibleIds scatter.
            // Code-dup (GLSL has no closure/fallthrough), NOT path-dup —
            // one buffer, one binding, one rollup. Filed debt: collapse
            // into a shared GLSL fn once [MECHVOL] is no longer the gate.
            uint bucket = rec.category >> 4;
            uint cap    = capsData[bucket];                   // bucketCapacity[b]
            uint base   = capsData[uint(u_nBuckets) + bucket];// bucketBase[b]
            uint slot   = atomicAdd(bucketCountData[bucket], 1u);
            if (slot >= cap) {
                atomicAdd(bucketCountData[uint(u_nBuckets)], 1u);  // overflowCount
            } else {
                visibleIds[base + slot] = i;
            }
        }
    }
#else
    // C1a debug path: write per-actor visibility result.
    visibilityResults[i] = visible ? 1u : 0u;

    // Accumulate totals via atomic operations (safe across the workgroup).
    if (visible)
        atomicAdd(gpuVisibleCount, 1u);
    else
        atomicAdd(gpuCulledCount, 1u);
#endif  // GPU_CULL_C1B_INDIRECT
}
