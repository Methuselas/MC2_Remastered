// shaders/gpu_driven_water.comp — Phase C Stage 1
//
// Cull/pack pass for water quads. One invocation per entry in the per-frame
// quadList window (u_windowCount entries in windowIdx[]).
//
// For each quad:
//   1. Fetch the static WaterRecipe from binding 0.
//   2. Fetch per-vertex lightRGB/fogRGB from Phase 1's lighting SSBO at binding 1.
//   3. Reproject the water surface (world XY at u_waterElevation + waveOurCos lift) through
//      u_terrainMVP to obtain per-vertex screen-space z — mirrors quad.cpp:953-1201 wz.
//   4. Apply the per-triangle pz-valid gate (wz ∈ [0,1)) — mirrors the gate in
//      WaterStream::UploadAndBindThinRecords (gos_terrain_water_stream.cpp:427-451).
//   5. Allocate an output slot via atomicAdd on GpuDrivenBucketHeader.visibleCount.
//   6. Pack a WaterThinRecord byte-identical to the CPU pack loop.
//
// Struct layouts are LOCKSTEP with C++ counterparts (verified by grep at write-time):
//   WaterRecipe              — gos_terrain_water_stream.h:47-70    (64 B, alignas(16))
//   WaterThinRecord          — gos_terrain_water_stream.h:91-97    (48 B, alignas(16))
//   GpuTerrainLightingOutput — gos_terrain_lighting.h:56-59        ( 8 B, alignas(4))
//
// #version 430 is prepended by host-side program builder — do NOT add it here.
//
// Bindings:
//   0 — WaterRecipe[]              (input, static per-quad recipe)
//   1 — GpuTerrainLightingOutput[] (input, Phase 1 per-vertex lightRGB/fogRGB)
//   2 — uint[]                     (input, per-frame quadList window: recipe indices)
//   3 — WaterThinRecord[]          (output, packed thin records)
//   6 — GpuDrivenBucketHeader      (coherent, atomicAdd on visibleCount)
//
// Uniforms:
//   u_windowCount    — number of entries in windowIdx[]
//   u_maxThinRecords — capacity of thin[] output array (overflow guard)
//   u_waterElevation — Terrain::waterElevation (float)
//   u_frameCos       — Terrain::frameCos; per-vertex wave Z-lift for exact pz parity
//   u_mapSide        — realVerticesMapSide (uint); used to compute adjacent-row vNums
//   u_terrainMVP     — row-major 4×4 terrain MVP (uploaded GL_FALSE).
//                      See memory/terrain_mvp_gl_false.md: GL_FALSE + row-major +
//                      GLSL column-major mat4 → terrainMVP * vec4(pos,1) is correct.

#include <include/terrain_depth_bias.hglsl>  // single-source WATER_DEPTH_FUDGE_FAST (gate-only here)

layout(local_size_x = 64) in;

// ---------------------------------------------------------------------------
// WaterRecipe — lockstep with gos_terrain_water_stream.h:47-70 (64 B, alignas(16))
//
//   Per-vertex world XY (32 B):
//     float v0x, v0y;   // offset  0
//     float v1x, v1y;   // offset  8
//     float v2x, v2y;   // offset 16
//     float v3x, v3y;   // offset 24
//   Per-vertex elevation (16 B):
//     float v0e, v1e, v2e, v3e; // offset 32
//   Indices and packed fields (16 B):
//     uint  quadIdx;     // offset 48 — top-left vertexNum = mapX + mapY * mapSide
//     uint  flags;       // offset 52 — bit0=uvModeBottomLeft, bit1=hasDetail
//     uint  terrainTypes;// offset 56 — terrainType per corner, packed v0..v3 in bytes
//     uint  waterBits;   // offset 60 — water flags per corner, packed v0..v3 in bytes
// ---------------------------------------------------------------------------
struct WaterRecipe {
    float v0x, v0y;
    float v1x, v1y;
    float v2x, v2y;
    float v3x, v3y;
    float v0e, v1e, v2e, v3e;
    uint  quadIdx;
    uint  flags;
    uint  terrainTypes;
    uint  waterBits;
};

// Flag bits matching kFlagBitUvModeBottomLeft / kFlagBitHasDetail in the header.
const uint kFlagBitUvModeBottomLeft = 0x1u;

// ---------------------------------------------------------------------------
// WaterThinRecord — lockstep with gos_terrain_water_stream.h:91-97 (48 B, alignas(16))
//
//   uint recipeIdx;              // offset  0
//   uint flags;                  // offset  4  bit0=pzTri1Valid, bit1=pzTri2Valid
//   uint pad0_, pad1_;           // offset  8  (match C++ _pad0, _pad1)
//   uint lightRGB0..3;           // offset 16
//   uint fogRGB0..3;             // offset 32
// ---------------------------------------------------------------------------
struct WaterThinRecord {
    uint recipeIdx;
    uint flags;
    uint pad0_;
    uint pad1_;
    uint lightRGB0, lightRGB1, lightRGB2, lightRGB3;
    uint fogRGB0,   fogRGB1,   fogRGB2,   fogRGB3;
};

// pz flag bits matching kWaterThinFlagPzTri1Valid / kWaterThinFlagPzTri2Valid.
const uint kWaterThinFlagPzTri1Valid = 0x1u;
const uint kWaterThinFlagPzTri2Valid = 0x2u;

// ---------------------------------------------------------------------------
// GpuDrivenBucketHeader — 16 B std430. Trailing-underscore pads per project rule.
// ---------------------------------------------------------------------------
struct GpuDrivenBucketHeader {
    uint visibleCount;
    uint pad0_;
    uint pad1_;
    uint pad2_;
};

// ---------------------------------------------------------------------------
// GpuTerrainLightingOutput — lockstep with gos_terrain_lighting.h:56-59 (8 B std430).
//   uint lightRGB;  // offset 0
//   uint fogRGB;    // offset 4
// One entry per terrain vertex, indexed by vertexNum = mapY*mapSide + mapX.
// ---------------------------------------------------------------------------
struct GpuTerrainLightingOutput {
    uint lightRGB;
    uint fogRGB;
};

// ---------------------------------------------------------------------------
// SSBO bindings
// ---------------------------------------------------------------------------
layout(std430, binding = 0) readonly  buffer Recipes  { WaterRecipe              recipes[];  };
layout(std430, binding = 1) readonly  buffer Lighting  { GpuTerrainLightingOutput lighting[]; };
layout(std430, binding = 2) readonly  buffer Window    { uint                     windowIdx[]; };
layout(std430, binding = 3) writeonly buffer Thin      { WaterThinRecord          thin[];      };
layout(std430, binding = 6) coherent  buffer Header    { GpuDrivenBucketHeader    hdr;         };

// ---------------------------------------------------------------------------
// Uniforms.
// 'uniform uint' crashes this engine's shader compile (memory/uniform_uint_crash.md);
// use int + cast where the value is passed from C++ as GLint.
// ---------------------------------------------------------------------------
uniform float u_waterElevation;
uniform float u_frameCos;          // Terrain::frameCos — per-vertex wave Z-lift for pz gate
uniform int   u_windowCount;
uniform int   u_maxThinRecords;
uniform int   u_mapSide;           // Terrain::realVerticesMapSide
uniform mat4  u_worldToClipGL;  // world -> GL clip (kAxisSwapMC2toGL * worldToClip)
// WATER-FULL-RECIPE-GPU-TIMER-SPIKE-0: when u_fullRecipeMode != 0, gl_GlobalInvocationID
// IS the recipe index over the whole world-indexed recipe set (u_windowCount carries
// recipeCount in this mode), and the shader applies the water-eligibility predicate
// (mirror terrain.cpp narrow-walk fast path) since the full recipe set is unfiltered.
// u_shoreExt = MapData::alphaDepth*0.5 (or 15.0 fallback). Default 0 = legacy window mode.
uniform int   u_fullRecipeMode;
uniform float u_shoreExt;

// ---------------------------------------------------------------------------
// terrainTypeToMaterial — replicates terrainTypeToMaterialLocal() in
// gos_terrain_water_stream.cpp:92-100. Must stay in sync with that table.
// ---------------------------------------------------------------------------
uint terrainTypeToMaterial(uint tt) {
    if (tt == 3u  || tt == 8u  || tt == 9u  || tt == 12u) return 1u; // Grass
    if (tt == 2u  || tt == 4u)                             return 2u; // Dirt
    if (tt == 10u || tt == 13u || tt == 14u || tt == 15u ||
        tt == 16u || tt == 17u || tt == 18u || tt == 19u) return 3u; // Concrete
    return 0u; // Rock
}

// ---------------------------------------------------------------------------
// waveOurCos — per-vertex frameCos sign, mirroring legacyWaveOurCos() in
// gos_terrain_water_stream.cpp. waterBits bit 7 of each byte selects sign:
//   bit7 set → -frameCos, clear → +frameCos  (quad.cpp:689-700)
// ---------------------------------------------------------------------------
float waveOurCos(uint vWaterBits) {
    return ((vWaterBits & 0x80u) != 0u) ? -u_frameCos : u_frameCos;
}

// ---------------------------------------------------------------------------
// projectWaterClip — project world-space (wx, wy, waterElev + waveZ) through
// u_worldToClipGL and return the raw clip-space vec4 (pre-divide).
// Mirrors quad.cpp:953-1201 water projection setup, including the frameCos
// wave Z-lift applied before projection (quad.cpp:689-700).
// vWaterBits is the per-vertex byte from WaterRecipe.waterBits.
// Post-F1: clip.w > 0 for in-front per kAxisSwapMC2toGL polarity fold
// (addendum-rclipw-polarity.md). Admission via pzOk(clip) uses
// ZERO_TO_ONE depth-only test; no x/y plane tests added (spec §4.4).
// ---------------------------------------------------------------------------
vec4 projectWaterClip(float wx, float wy, uint vWaterBits) {
    float elev = u_waterElevation + waveOurCos(vWaterBits);
    return u_worldToClipGL * vec4(wx, wy, elev, 1.0);
}

// ---------------------------------------------------------------------------
// pzOk — ZERO_TO_ONE admission gate (spec §4.4).
// Water depth bias (WATER_DEPTH_FUDGE_FAST) mirrors the thin VS which applies
// it pre-divide: clip.z += FUDGE * clip.w. Gate must agree.
// ---------------------------------------------------------------------------
bool pzOk(vec4 clip) {
    if (clip.w <= 1e-4) return false;
    float biasedZ = clip.z + WATER_DEPTH_FUDGE_FAST * clip.w;
    return biasedZ >= 0.0 && biasedZ < clip.w;
}

// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------
void main() {
    uint id = uint(gl_GlobalInvocationID.x);
    if (id >= uint(u_windowCount)) return;   // u_windowCount = dispatch bound (window count OR recipeCount in full mode)

    // Window mode: the window array carries recipe indices (CPU resolved top-left
    // vertexNum → recipeIdx via g_vertexNumToRecipe). Full-recipe mode (SPIKE):
    // id IS the recipe index over the whole world-indexed recipe set.
    uint recipeIdx = (u_fullRecipeMode != 0) ? id : windowIdx[id];
    WaterRecipe r  = recipes[recipeIdx];
    if (u_fullRecipeMode != 0) {
        // Eligibility predicate — mirror terrain.cpp narrow-walk fast path
        // (waterFlagged || submergedSand). The recipe set is unfiltered (every
        // map quad), so the GPU must filter here instead of trusting a CPU window.
        uint w0 = (r.waterBits      ) & 0xFFu;
        uint w1 = (r.waterBits >>  8) & 0xFFu;
        uint w2 = (r.waterBits >> 16) & 0xFFu;
        uint w3 = (r.waterBits >> 24) & 0xFFu;
        bool waterFlagged = ((w0 | w1 | w2 | w3) & 1u) != 0u;
        float thr = u_waterElevation + u_shoreExt;
        bool submergedSand = !waterFlagged &&
            (r.v0e < thr || r.v1e < thr || r.v2e < thr || r.v3e < thr);
        if (!(waterFlagged || submergedSand)) return;
    }

    // -----------------------------------------------------------------------
    // Per-vertex water-surface projection and pz-valid check.
    // Mirrors UploadAndBindThinRecords (gos_terrain_water_stream.cpp:427-451).
    // -----------------------------------------------------------------------
    // Extract per-vertex waterBits bytes (v0 in lowest byte, mirroring terrainTypes packing).
    uint wb0 = (r.waterBits      ) & 0xFFu;
    uint wb1 = (r.waterBits >>  8) & 0xFFu;
    uint wb2 = (r.waterBits >> 16) & 0xFFu;
    uint wb3 = (r.waterBits >> 24) & 0xFFu;

    // F1 Stage A: projectWaterClip uses u_worldToClipGL (true GL clip).
    // pzOk uses ZERO_TO_ONE clip-space test (spec §4.4).
    vec4 wc0 = projectWaterClip(r.v0x, r.v0y, wb0);
    vec4 wc1 = projectWaterClip(r.v1x, r.v1y, wb1);
    vec4 wc2 = projectWaterClip(r.v2x, r.v2y, wb2);
    vec4 wc3 = projectWaterClip(r.v3x, r.v3y, wb3);

    bool ok0 = pzOk(wc0);
    bool ok1 = pzOk(wc1);
    bool ok2 = pzOk(wc2);
    bool ok3 = pzOk(wc3);

    // uvMode from recipe flags bit 0: 0 = BOTTOMRIGHT, 1 = BOTTOMLEFT.
    bool isBottomLeft = (r.flags & kFlagBitUvModeBottomLeft) != 0u;

    bool pzTri1, pzTri2;
    if (!isBottomLeft) {
        // BOTTOMRIGHT: tri1=(v0,v1,v2), tri2=(v0,v2,v3)
        // Matches UploadAndBindThinRecords: if (q.uvMode == BOTTOMRIGHT) { pzTri1 = ok0&&ok1&&ok2; pzTri2 = ok0&&ok2&&ok3; }
        pzTri1 = ok0 && ok1 && ok2;
        pzTri2 = ok0 && ok2 && ok3;
    } else {
        // BOTTOMLEFT: tri1=(v0,v1,v3), tri2=(v1,v2,v3)
        // Matches UploadAndBindThinRecords: else { pzTri1 = ok0&&ok1&&ok3; pzTri2 = ok1&&ok2&&ok3; }
        pzTri1 = ok0 && ok1 && ok3;
        pzTri2 = ok1 && ok2 && ok3;
    }

    // Drop entire quad if both triangles fail the pz gate (matching CPU: ++pzDropCount; continue).
    if (!pzTri1 && !pzTri2) return;

    // -----------------------------------------------------------------------
    // Resolve the four corner vertexNums for lighting SSBO lookup.
    // Corner ordering from gos_terrain_water_stream.cpp:190-193:
    //   v0 = (mx,   my)     top-left  → vertexNum = quadIdx
    //   v1 = (mx+1, my)     top-right → vertexNum = quadIdx + 1
    //   v2 = (mx+1, my+1)   bot-right → vertexNum = quadIdx + mapSide + 1
    //   v3 = (mx,   my+1)   bot-left  → vertexNum = quadIdx + mapSide
    // quadIdx = mx + my * mapSide (gos_terrain_water_stream.cpp:248).
    // -----------------------------------------------------------------------
    uint ms  = uint(u_mapSide);
    uint vn0 = r.quadIdx;
    uint vn1 = r.quadIdx + 1u;
    uint vn2 = r.quadIdx + ms + 1u;
    uint vn3 = r.quadIdx + ms;

    // -----------------------------------------------------------------------
    // Allocate output slot via atomicAdd on the coherent bucket header.
    // -----------------------------------------------------------------------
    uint outSlot = atomicAdd(hdr.visibleCount, 1u);
    if (outSlot >= uint(u_maxThinRecords)) return;

    // -----------------------------------------------------------------------
    // Material lookup for fogRGB low-byte patch.
    // Mirrors UploadAndBindThinRecords lines 471-478:
    //   const uint m0 = terrainTypeToMaterialLocal(q.vertices[0]->pVertex->terrainType);
    //   tr.fogRGB0 = (q.vertices[0]->fogRGB & 0xFFFFFF00u) | m0;
    // terrainTypes field packs per-vertex terrainType in bytes (v0 in lowest byte).
    // -----------------------------------------------------------------------
    uint mtl0 = terrainTypeToMaterial((r.terrainTypes      ) & 0xFFu);
    uint mtl1 = terrainTypeToMaterial((r.terrainTypes >>  8) & 0xFFu);
    uint mtl2 = terrainTypeToMaterial((r.terrainTypes >> 16) & 0xFFu);
    uint mtl3 = terrainTypeToMaterial((r.terrainTypes >> 24) & 0xFFu);

    // -----------------------------------------------------------------------
    // Pack and write the thin record.
    // Mirrors UploadAndBindThinRecords lines 453-479:
    //   WaterThinRecord tr{};
    //   tr.recipeIdx = it->second;
    //   uint flags = 0;
    //   if (pzTri1) flags |= kWaterThinFlagPzTri1Valid;
    //   if (pzTri2) flags |= kWaterThinFlagPzTri2Valid;
    //   tr.flags = flags;
    //   tr.lightRGB0 = q.vertices[0]->lightRGB; ...
    //   tr.fogRGB0   = (q.vertices[0]->fogRGB & 0xFFFFFF00u) | m0; ...
    // -----------------------------------------------------------------------
    WaterThinRecord tr;
    tr.recipeIdx = recipeIdx;

    uint pzFlags = 0u;
    if (pzTri1) pzFlags |= kWaterThinFlagPzTri1Valid;
    if (pzTri2) pzFlags |= kWaterThinFlagPzTri2Valid;
    tr.flags = pzFlags;

    tr.pad0_ = 0u;
    tr.pad1_ = 0u;

    tr.lightRGB0 = lighting[vn0].lightRGB;
    tr.lightRGB1 = lighting[vn1].lightRGB;
    tr.lightRGB2 = lighting[vn2].lightRGB;
    tr.lightRGB3 = lighting[vn3].lightRGB;

    tr.fogRGB0 = (lighting[vn0].fogRGB & 0xFFFFFF00u) | mtl0;
    tr.fogRGB1 = (lighting[vn1].fogRGB & 0xFFFFFF00u) | mtl1;
    tr.fogRGB2 = (lighting[vn2].fogRGB & 0xFFFFFF00u) | mtl2;
    tr.fogRGB3 = (lighting[vn3].fogRGB & 0xFFFFFF00u) | mtl3;

    thin[outSlot] = tr;
}
