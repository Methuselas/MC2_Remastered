// SLICE 3b: shared cliff displacement. Included by terrain_lod_chunk.tese AND
// (Task 3) shadow_terrain.tese so main + shadow surfaces are identical by
// construction.
//
// P        = interpolated world pos (up = +Z in this space; confirmed against
//            terrain_lod_chunk.frag smoothTerrainNormal -> normalize(vec3(...,1))
//            and the cliff test abs(macroNz)==abs(N.z)).
// N        = geometric (away-from-cliff) face normal, unit, +Z-ish up.
// edgeFade = [0,1], 0 at chunk/LOD boundary -> 1 interior (skirt-crack policy;
//            Task 2 feeds the real value, Task 1 passes 1.0).
// camDist  = camera ground distance for the near-field fade.
// Returns the displaced P.
//
// The displacement is DIRECTIONAL VERTICAL FLUTING: sharp vertical grooves down
// the face (columnar striation, Cliffs-of-Moher target), plus a little fbm
// break-up. It is slope-masked (only steep faces move), crest-faded (the plateau
// top edge stays crisp), camera-distance-faded, and edge-faded (crack-free).
uniform float u_cliffAmp;        // max outward displacement (wu)
uniform float u_cliffFluteFreq;  // grooves per wu (columnar spacing)
uniform float u_cliffFluteSharp; // 1..4 groove contrast
uniform float u_cliffDetail;     // fbm detail amplitude fraction [0,1]
uniform vec2  u_cliffSlope;      // (lo,hi) abs(N.z): 0 below lo, full above hi (i.e. flatter)
uniform float u_cliffCrestFade;  // wu of crest fade (0 at top edge -> 1 below)
uniform vec2  u_cliffDistFade;   // (near,far) wu camera-distance fade band
uniform float u_cliffFootY;      // world height (Z) of the face foot (or <0 = auto/skip)

float cd_hash(vec2 p){ p=fract(p*vec2(127.1,311.7)); p+=dot(p,p+34.5); return fract(p.x*p.y); }
float cd_noise(vec2 p){ vec2 i=floor(p),f=fract(p); f=f*f*(3.0-2.0*f);
    return mix(mix(cd_hash(i),cd_hash(i+vec2(1,0)),f.x),
               mix(cd_hash(i+vec2(0,1)),cd_hash(i+vec2(1,1)),f.x),f.y); }
float cd_fbm(vec2 p){ float a=0.5,s=0.0; for(int i=0;i<4;i++){s+=a*cd_noise(p);p*=2.03;a*=0.5;} return s; }

vec3 cliffDisplace(vec3 P, vec3 N, float edgeFade, float camDist){
    // steep = 1 on a vertical wall (abs(N.z) small), 0 on flat ground (abs(N.z)
    // near 1). smoothstep(lo,hi,abs(N.z)) is 0 at abs(N.z)<=lo and 1 at >=hi, so
    // (1 - that) is 1 on steep faces and 0 on flat ground -> the slope mask.
    float slopeT = smoothstep(u_cliffSlope.x, u_cliffSlope.y, abs(N.z));
    float steep  = 1.0 - slopeT;
    if (steep <= 0.0) return P;

    // Fluting axis: horizontal, perpendicular to the face down-direction. dFace is
    // world-down (0,0,-1) projected onto the face plane; `across` runs horizontally
    // along the face so grooves run vertically down the wall.
    vec3 dn    = vec3(0.0, 0.0, -1.0);
    vec3 dFace = normalize(dn - N * dot(dn, N) + vec3(1e-5));
    vec3 across = normalize(cross(N, dFace));

    float u = dot(P, across);                 // groove coordinate across the face
    float flute = pow(0.5 + 0.5 * cos(u * u_cliffFluteFreq * 6.28318), u_cliffFluteSharp);
    // fbm break-up so the grooves are not perfectly periodic.
    float detail = cd_fbm(vec2(u, dot(P, dFace)) * u_cliffFluteFreq * 2.0);
    float h = mix(flute, detail, u_cliffDetail);   // grooves, softened by detail

    // Crest lock: keep the sharp plateau->cliff TOP EDGE crisp. TWO guards, both
    // conservative (bias toward the LOWER part of the face; never round the top):
    //   (1) The slope mask already zeroes displacement on the near-flat plateau
    //       above the crest and ramps it in only as the surface steepens.
    //   (2) When a face foot height is provided (u_cliffFootY >= 0), fade the
    //       displacement to 0 within u_cliffCrestFade world units BELOW the foot
    //       so the very base blends into flat ground, and (belt-and-suspenders)
    //       taper the very top of the ramp-in band so the crisp top edge is never
    //       pushed out. Without a foot signal we key ONLY off the slope band and
    //       additionally fade out the UPPER part of the transition (slopeT near
    //       hi) so the plateau lip stays put.
    // TODO(crest): the ideal signal is per-vertex height-above-foot, which the TES
    //   does not have cheaply. Task 5 tunes u_cliffCrestFade / footY against the
    //   money shot; if the top edge ever rounds, lower amp or raise crestFade —
    //   this function must NOT displace the crisp lip outward.
    float crest;
    if (u_cliffFootY >= 0.0) {
        // 0 at/below the foot, ramping to 1 one crestFade band above it (relief
        // grows away from the base up the face, then the slope mask handles the top).
        crest = clamp((P.z - u_cliffFootY) / max(u_cliffCrestFade, 1.0), 0.0, 1.0);
    } else {
        // No foot signal: taper the TOP of the ramp-in band. slopeT near hi means
        // "just tipping from flat into steep" = the crest lip -> keep it crisp.
        // Bias relief toward the fully-steep lower face.
        crest = steep;   // == 1 - slopeT; already small near the lip, full on the wall
    }

    float distFade = 1.0 - smoothstep(u_cliffDistFade.x, u_cliffDistFade.y, camDist);
    float amp = u_cliffAmp * steep * crest * edgeFade * distFade;
    return P + N * (h * amp);
}
