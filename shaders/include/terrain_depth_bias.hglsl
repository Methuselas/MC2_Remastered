// GLSL sibling of mclib/terrain_depth_bias.h -- keep LOCKSTEP (byte-equal
// values, same commit). Full rationale + the two-water-regime explanation
// (FAST vs RASTER) and the post-matrix-share co-planar bias design live in
// that C++ header.
//
// REVERSE-Z [near->1, far->0] regime, GEQUAL compare (larger NDC z wins).
// Every signed bias INVERTS vs the old forward-Z/LEQUAL convention so the
// tie-break invariants are preserved. Lockstep with the C++ header (signs
// and magnitudes byte-equal).
//
// Post-matrix-share design (Fix B): water and overlays/decals project through
// the bit-identical baked terrain MVP (symmetric mirror). They are co-planar
// in world space; depth ordering is maintained by two small, oppositely-signed
// epsilons off the shared terrain reference -- NOT by divergent projection
// compensation.
//
//   OVERLAY_DEPTH_BIAS > 0 > WATER_DEPTH_BIAS   (reverse-Z / GEQUAL)
//   TERRAIN + WATER_DEPTH_BIAS < TERRAIN < TERRAIN + OVERLAY_DEPTH_BIAS
//   (all three negative; TERRAIN_DEPTH_FUDGE = -0.002)
//
//   WATER_DEPTH_BIAS   < 0: water strictly LOSES the shoreline GL_GEQUAL tie
//                           (preserves v0.3 staircase-scar invariant).
//   OVERLAY_DEPTH_BIAS > 0: decals/overlays strictly WIN the GEQUAL tie over
//                           terrain (replaces the removed host
//                           glPolygonOffset(-1,-1)).
//
// RASTER regime (WATER_DEPTH_FUDGE_RASTER) ALSO flips for reverse-Z; the
// legacy CPU-raster water + inverseProjectZ path is reconciled at the
// coordinate-transform fence seam, NOT by keeping a constant un-flipped.
// The Fix-B-era "do NOT touch RASTER" instruction is SUPERSEDED by
// reverse-Z (design Section 9).
//
// Note: FAST and RASTER currently resolve to the same absolute value
// (-0.0025) by coincidence -- the co-planar epsilon (WATER_DEPTH_BIAS
// -0.0005) happens to equal the RASTER delta. They remain SEPARATE named
// constants because their future change trajectories differ.
//
// Hard bound: |water absolute| (|TERRAIN + WATER_DEPTH_BIAS| = 0.0025) <
// 0.004 (2*|TERRAIN|). Proven lake-bottom punch-through threshold; see C++
// header.
#ifndef TERRAIN_DEPTH_BIAS_HGLSL
#define TERRAIN_DEPTH_BIAS_HGLSL
// TERRAIN-DEPTH-BIAS-OWNERSHIP-1: terrain opaque now writes TRUE depth (0). The
// old -0.002 (net -0.004 via VS+FS / 2x chunk) recessed terrain by a CONSTANT
// NDC offset, which under reverse-Z is a world-depth band that GROWS
// hyperbolically with distance -> distant terrain sat tens-to-hundreds of units
// behind true depth, so every opaque object on it (trees, rocks, turrets,
// generators, buildings, mechs) won the depth test and poked through. With
// terrain at true depth, objects (which write true depth) occlude correctly at
// all ranges. The co-planar layers below keep SMALL relative epsilons off true
// terrain (distance-independent NDC tie-breaks). Layered contract, reverse-Z /
// GEQUAL (larger NDC z = nearer = wins), all relative to true terrain (0):
//   terrain 0 < VEG < OVERLAY < OBJECT < WATER(surface)
// - VEG/OVERLAY win over bare ground; OBJECT (props/buildings/turrets/mechs) sits
//   ABOVE overlays so it does NOT sink into cement/road transition tiles, yet is
//   tiny enough (0.0001) that its reverse-Z world band is sub-visible (no
//   show-through). WATER surface sits slightly ahead so a lake wins over its
//   (deeper) lake-bottom terrain — matches the old net (+0.00025 vs terrain).
const float TERRAIN_DEPTH_FUDGE      = 0.0;       // true opaque depth (was -0.002; net -0.004)
const float VEG_DEPTH_BIAS           = 0.00003;   // > 0 veg wins over ground, < OVERLAY
const float OVERLAY_DEPTH_BIAS       = 0.00005;   // > 0 decals/cement win over terrain & veg
const float OBJECT_DEPTH_BIAS        = 0.0001;    // > OVERLAY: props/buildings/mechs sit on top of cement; tiny -> no distance show-through
const float WATER_DEPTH_BIAS         = 0.00025;   // > 0 water surface wins over (deeper) lake-bottom terrain (old net was +0.00025)
const float WATER_DEPTH_FUDGE_RASTER = 0.00025;   // RASTER regime: same surface bias (intro water visible)
const float WATER_DEPTH_FUDGE_FAST   = 0.00025;   // FAST regime: water surface ahead of true terrain
#endif
