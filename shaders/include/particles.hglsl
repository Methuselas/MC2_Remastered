// shaders/include/particles.hglsl
//
// Particle SSBO record — std430 mirror of mc2::particles::GpuParticle in
// mclib/particles/spec.h. Per plan v5 §5.4 (v2 MAJOR-4 fold-in), this
// header carries the offset cross-reference comments; the C++ side carries
// the compile-time enforcement (per-field offsetof static_asserts). Any
// edit MUST update both files in the same atomic commit.
//
// Total size: 64 bytes (std430). Aligned to 16-byte vec4 boundaries so
// vec3 reads do not straddle.
//
// C++ offset -> field cross-reference (kept in lockstep with spec.h):
//   offset  0: vec3   position    (+ 4B pad to vec4 boundary)
//   offset 16: vec4   color       (straight RGBA (R,G,B,A — not premultiplied))
//   offset 32: vec3   velocity    (+ 4B kind_flags to complete vec4)
//   offset 44: uint   kind_flags  ([0]=is_head, [1-3]=reserved, [4-7]=kind, [8-31]=reserved)
//   offset 48: float  lifetime    (seconds)
//   offset 52: float  age         (seconds)
//   offset 56: float  size        (world-space radius)
//   offset 60: uint   atlasIndex  (gos_TextureHandle cast to uint32; resolved to GLuint at flush time)

struct Particle {
    vec4  position;    // .xyz = world position; .w = pad
    vec4  color;       // straight RGBA (R,G,B,A — not premultiplied)
    vec3  velocity;    // world delta/sec
    uint  kind_flags;  // [7:4]=kind (0-15), [0:0]=is_head — offset 44
    float lifetime;
    float age;
    float size;
    uint  atlasIndex;  // gos_TextureHandle cast to uint32; resolved to GLuint at flush time
};
