// shaders/include/view_uniforms.hglsl
//
// GLSL std430 mirror of RenderCore::ViewUniforms.
// SHADER-SCHEMA-2: ABI locked. Do not change field order or types
// without updating RenderCore/ViewUniforms.h and regenerating goldens.
//
// C++ authority: RenderCore/ViewUniforms.h
// ABI gate: cmake --build build64 --target shader_schema
//
// Not yet bound in runtime shaders. Included by the reflection fixture
// shaders/fixtures/view_uniforms_contract.frag to lock the ABI.

// 144-byte per-frame view/projection record.
struct ViewUniforms {
    mat4 worldToClipGL;    //   0 — world → GL clip
    mat4 worldToViewGL;    //  64 — world → view
    vec4 cameraWorldPos;   // 128 — world-space camera position
};  // size = 144 bytes in std430

#ifdef MC2_USE_VIEW_UNIFORMS
// Runtime UBO binding. Keep in sync with RenderCore::kViewUniformsBinding.
// The shader_reflect ABI fixture may use a separate contract-only block.
layout(binding = 3, std140) uniform ViewUniformsBlock {
    mat4 u_worldToClipGL;
    mat4 u_worldToViewGL;
    vec4 u_cameraWorldPos;
};
// anonymous block — names visible directly in shader scope
#endif
