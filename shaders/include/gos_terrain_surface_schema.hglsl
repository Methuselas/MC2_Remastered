// shaders/include/gos_terrain_surface_schema.hglsl
//
// [TERRAIN_SURFACE] continuous-surface producer -- GLSL std430 schema MIRROR.
//
// LOCKSTEP (load-bearing, memory/cpp_glsl_ubo_struct_lockstep.md): this file is
// the hand-mirrored GLSL counterpart of the C++ schema header
//   GameOS/gameos/gos_terrain_surface_schema.h
// It MUST be edited in the SAME commit as that header and carry byte-equal
// std430 layout. PR-1 landed the C++ side (no shader consumed the surface yet);
// PR-2 lands this mirror together with the indexed-surface VS that reads it
// (plan PR-2 = "Indexed-surface VS + std430 lockstep schema rotation").
//
// std430 packing (verified against the C++ static_assert/offsetof pins):
//   TerrainSurfaceVertex    : 32 B = vec4 pos + vec4 normal (offsets 0, 16)
//   TerrainSurfaceTile      : 32 B = uvec4(wp0..wp3) + vec4(uvExt) (offsets 0,16)
//   index buffer            : flat uint[] (4 B stride), 6 indices / cell
//   TerrainSurfaceAdjacency : 16 B = uvec4 (PR-1 generates; PR-3 consumes)
//
// Plan : docs/superpowers/plans/2026-05-18-terrain-continuous-surface-producer-plan.md
// Design: docs/superpowers/specs/2026-05-18-terrain-continuous-surface-producer-design.md
//         Section 1.3 (SSBO schema), Section 2 (per-fragment WorldPos material).

#ifndef GOS_TERRAIN_SURFACE_SCHEMA_HGLSL
#define GOS_TERRAIN_SURFACE_SCHEMA_HGLSL

// 1. Surface vertex SSBO -- one position+normal per map-stable vertexNum,
//    de-duplicated from the dense recipe corners. 32 B std430 (two vec4).
//    Mirror of C++ TerrainSurfaceVertex (gos_terrain_surface_schema.h:41-50):
//      float px,py,pz,_ppad;  (offset 0)   -> vec4 pos
//      float nx,ny,nz,_npad;  (offset 16)  -> vec4 normal
struct TerrainSurfaceVertex {
    vec4 pos;     // xyz = world-space position; w = 0 pad
    vec4 normal;  // xyz = vertex normal;        w = 0 pad
};

// 2. Per-tile material table -- EVOLVED from TerrainQuadRecipe, indexed by the
//    cell index (PR-2 uses the per-fragment WorldPos->tile bucket in the frag;
//    the surface VS only forwards WorldPos -- design Section 2 NC1: NO tile /
//    cement / atlas decision is moved to a vertex/varying). 32 B std430.
//    Mirror of C++ TerrainSurfaceTile (gos_terrain_surface_schema.h:66-69):
//      uint wp0,wp1,wp2,wp3;          (offset 0)   -> uvec4 wp
//      float minU,minV,maxU,maxV;     (offset 16)  -> vec4  uvExt
struct TerrainSurfaceTile {
    uvec4 wp;     // wp0=packed mats, wp1=uvMode, wp2=nodeId, wp3=cement word
    vec4  uvExt;  // minU, minV, maxU, maxV
};

// 4. Per-edge adjacency / LOD-band SSBO -- mission-static neighbor cell
//    indices (kSurfaceNoNeighbor == 0xFFFFFFFF at the map edge). PR-1
//    GENERATES it; the PR-3 band/seam stage CONSUMES it. Declared here for
//    lockstep completeness; PR-2's VS does not read it. 16 B std430 (uvec4).
//    Mirror of C++ TerrainSurfaceAdjacency (gos_terrain_surface_schema.h:103-105).
struct TerrainSurfaceAdjacency {
    uvec4 nbr;    // x=top, y=right, z=bottom, w=left
};

// Two triangles per quad cell (mirror of C++ kSurfaceIndicesPerCell).
const uint kSurfaceIndicesPerCell = 6u;
const uint kSurfaceNoNeighbor     = 0xFFFFFFFFu;

#endif // GOS_TERRAIN_SURFACE_SCHEMA_HGLSL
