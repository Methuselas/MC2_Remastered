// Shared map-edge haze helper.
// Fades the last ~one-tile band of terrain to sky colour so the hard
// map boundary / magenta void is hidden without re-enabling global fog.
//
// NOTE: bare float/vec3 types only — NO PREC qualifier.  This header may be
// included before any #define PREC ... in the including shader.

const vec3 EDGE_HAZE_SKY = vec3(0.58, 0.65, 0.75);

float edgeHazeAmount(vec2 worldXY, float halfMap) {
    return smoothstep(halfMap - 256.0, halfMap - 32.0, max(abs(worldXY.x), abs(worldXY.y)));
}
