// gos_terrain_lighting.comp — Phase 1 Stage 2: terrain lighting GPU compute.
//
// Stage 2: full lighting math matching CPU quad.cpp:1266-1891 per-vertex block.
// Output is written to outputs[] and compared via Parity_CompareFrame — CPU path
// remains authoritative for visual rendering until Stage 3.
//
// #version 430 is injected by the C++ loader — do NOT add it here.
// Bindings:
//   0 — GpuTerrainVertexInput[]    (input, per-vertex geometry + flags + hazeFactor)
//   1 — GpuTerrainLight[]          (input, per-frame terrain light list, index >= 2)
//   2 — GpuTerrainLightingOutput[] (output, lightRGB + fogRGB per vertex)
//
// Uniforms (locations resolved at runtime via glGetUniformLocation — no layout qualifiers):
//   u_numVertices      — int   (total vertices; dispatch range guard)
//   u_numLights        — int   (lights[] count from eye->getNumTerrainLights() minus first 2)
//   u_sunLightDir      — vec3  (eye->lightDirection, already normalized)
//   u_lightRed/Green/Blue    — int  (eye->lightRed/Green/Blue as 0-255)
//   u_ambientRed/Green/Blue  — int  (eye->ambientRed/Green/Blue as 0-255)
//   u_baseVertexColorR/G/B   — int  (BaseVertexColor >> 16/8/0 & 0xff)
//   u_rainLightLevel   — float (TerrainQuad::rainLightLevel)
//   u_lighteningLevel  — int   (TerrainQuad::lighteningLevel)
//   u_fogStart/Full    — float (eye->fogStart / eye->fogFull)
//   u_useFog           — int   (useFog ? 1 : 0)
//   u_rendererSW       — int   (Environment.Renderer == 3 ? 1 : 0)
//   g_playAreaBounds   — vec4  ((-m,-m,m,m); m = worldUnitsMapSide/2 - worldUnitsPerVertex*2)
//   u_cameraWorldPos   — vec3  (swizzled camera origin; matches terrain.cpp:1417-1419)
//   g_minHazeDistance  — float (Camera::MinHazeDistance)
//   g_maxClipDistance  — float (Camera::MaxClipDistance)
//   g_distanceFactor   — float (Camera::DistanceFactor)
//
// Note: 'uniform uint' + glUniform1ui crashes the project's shader_builder on this
// driver (uniform reflection table). All integer uniforms use 'uniform int' + glUniform1i.
// Note: explicit layout(location=N) is NOT used — AMD RX 7900 XTX doesn't reliably
// honor explicit locations for compute uniforms; use glGetUniformLocation exclusively.

// --- begin terrain_lighting_shared.hglsl ---
// (inlined by tl_build_terrain_lighting_program)
// --- end terrain_lighting_shared.hglsl ---

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer VertexInputs  { GpuTerrainVertexInput vertices[]; };
layout(std430, binding = 1) readonly  buffer LightInputs   { GpuTerrainLight lights[];         };
layout(std430, binding = 2) writeonly buffer LightOutputs  { GpuTerrainLightingOutput outputs[]; };

uniform int   u_numVertices;
uniform int   u_numLights;
uniform vec3  u_sunLightDir;
uniform int   u_lightRed;
uniform int   u_lightGreen;
uniform int   u_lightBlue;
uniform int   u_ambientRed;
uniform int   u_ambientGreen;
uniform int   u_ambientBlue;
uniform int   u_baseVertexColorR;
uniform int   u_baseVertexColorG;
uniform int   u_baseVertexColorB;
uniform float u_rainLightLevel;
uniform int   u_lighteningLevel;
uniform float u_fogStart;
uniform float u_fogFull;
uniform int   u_useFog;
uniform int   u_rendererSW;
// Step 7 (VPL retirement): inline-worldPos hazeFactor. Plain uniforms, no
// layout qualifier (matches refactor 05e73ab AMD-safe glGetUniformLocation
// convention); all float/vec per memory/uniform_uint_crash.md (no uniform uint).
uniform vec4  g_playAreaBounds;
uniform vec3  u_cameraWorldPos;
uniform float g_minHazeDistance;
uniform float g_maxClipDistance;
uniform float g_distanceFactor;
// Visible-window dispatch range: first vertex in [packMinVN,packMaxVN].
// The C++ side dispatches (packMaxVN-packMinVN+1) invocations with this offset,
// limiting GPU work to the ~200x200 visible window instead of the full terrain.
uniform int   u_vertexOffset;

// getLightChannel mirrors Camera::getLightRed/Green/Blue (camera.cpp:3065-3110).
// Formula: if (intensity > 0) result = clamp(int(lightChan * intensity + ambientChan), 0, 255)
//          else result = ambientChan
// All inputs are uint 0-255 as packed by PackAndDispatch.
uint getLightChannel(float intensity, uint lightChan, uint ambientChan) {
    if (intensity > 0.0) {
        int r = int(float(lightChan) * intensity + float(ambientChan));
        if (r >= 255) return 255u;
        if (r < 0)    return 0u;
        return uint(r);
    }
    return ambientChan;
}

// GetFalloff mirrors TG_Light::GetFalloff (mclib/tgl.h:261-275).
// Returns true (falloff in range) and writes falloff; false = out of range.
// falloffParam on GpuTerrainLight carries closeDistance.
// lights[i] carries farDistance and oneOverDistance indirectly via a second
// param slot — but GpuTerrainLight only has one falloffParam field.
// RESOLUTION: lights[i].falloffParam = closeDistance.
// farDistance and oneOverDistance are uploaded in lights[i].color.w (not
// available) — actually we upload all three in the light struct's second
// falloffParam. See gos_terrain_lighting.cpp for the extended struct approach.
//
// ACTUAL APPROACH: GpuTerrainLight has falloffParam (scalar) and color (vec3).
// We pack: falloffParam = closeDistance, color.x/y/z = R/G/B as 0..1 float.
// farDistance and oneOverDistance are NOT in the struct.
// SOLUTION: pack farDistance as a second value via lights[] extended fields
// using the existing 32B struct layout:
//   position[3], lightType(uint), color[3], falloffParam(float)
//   = 12 + 4 + 12 + 4 = 32B
// We need farDistance and oneOverDistance too. Since we only have one float
// left (falloffParam), we pack:
//   falloffParam = closeDistance (already)
// And add a separate "falloff range" SSBO? No — we extend the light struct.
//
// DESIGN DECISION: extend GpuTerrainLight with farDistance + oneOverDistance
// packed into the color[] fields differently is not possible (color[] is R/G/B).
//
// REAL SOLUTION: the falloffParam is closeDistance. We pass farDistance and
// oneOverDistance via a SEPARATE uniform array or by extending the struct.
// Since struct extension requires lockstep changes (memory/cpp_glsl_ubo_struct_lockstep.md),
// we extend GpuTerrainLight to include farDistance and oneOverDistance:
//   REVISED struct (48B):
//     position[3] + lightType = 16B
//     color[3] + falloffParam = 16B (falloffParam = closeDistance)
//     farDistance + oneOverDistance + pad[2] = 16B
// This requires struct extension in both C++ and GLSL.
//
// BUT: for Stage 2 parity we want minimal struct churn. Alternative: encode
// falloffParam = farDistance - closeDistance (i.e., the range), and pass
// closeDistance as second param.
//
// SIMPLEST CORRECT APPROACH for Stage 2:
// Pack the full TG_Light data by reusing the existing 32B struct differently:
//   lights[i].position = world position of light
//   lights[i].lightType = GPU light type
//   lights[i].color = R/G/B float (normalized 0..1)
//   lights[i].falloffParam = closeDistance  <-- already there
// Missing: farDistance, oneOverDistance.
//
// SOLUTION: extend GpuTerrainLight to 48B (add farDistance + oneOverDistance).
// This is a lockstep change. We do it now.
// The GLSL struct below matches the extended C++ struct in gos_terrain_lighting.h.

// The extended struct (now 48B) is declared in terrain_lighting_shared.hglsl
// which is inlined above. The inlined version must match.

// NOTE: The GLSL struct GpuTerrainLight is declared in the inlined shared header.
// If it already has farDistance + oneOverDistance, use them directly.
// If not (Stage 1 compat), we use falloffParam only and skip out-of-range check.
// For Stage 2 correctness, we MUST have farDistance.

// ACTUAL Stage 2 approach (since we're extending the struct):
// GpuTerrainLight (Stage 2 extended, 48B):
//   vec3 position; uint lightType;       // 16B
//   vec3 color; float closeDistance;     // 16B (falloffParam renamed to closeDistance)
//   float farDistance; float oneOverDistance; float _pad1; float _pad2;  // 16B

// GetFalloff — implemented with full TG_Light fields from the extended struct.
bool GetFalloff(uint lightIdx, float length, out float falloff) {
    float closeDistance   = lights[lightIdx].closeDistance;
    float farDistance     = lights[lightIdx].farDistance;
    float oneOverDistance = lights[lightIdx].oneOverDistance;

    if (length <= closeDistance) {
        falloff = 1.0;
        return true;
    }
    if (length >= farDistance) {
        return false;
    }
    falloff = (farDistance - length) * oneOverDistance;
    return true;
}

// GetApproximateLength mirrors Stuff::Point3D::GetApproximateLength (vector3d.hpp:414):
// In non-ASM builds: SqrtApproximate = sqrt (scalar.hpp:109).
// So GetApproximateLength = sqrt(x*x + y*y + z*z).
float GetApproximateLength(vec3 v) {
    return sqrt(dot(v, v));
}

// float2long mirrors mathfunc.h:115: long(val) = truncation toward zero.
uint float2long_u(float v) {
    return uint(int(v));
}

void main() {
    // Offset by packMinVN so each invocation maps to a vertex in [packMinVN,packMaxVN].
    uint vn = gl_GlobalInvocationID.x + uint(u_vertexOffset);
    if (vn >= uint(u_numVertices)) return;

    GpuTerrainVertexInput v = vertices[vn];

    // Mirror quad.cpp:1280: if (Environment.Renderer != 3) — software renderer skip
    // When u_rendererSW == 1, use defaults: lightRGB = white (0xFFFFFFFF), fogRGB defaults.
    uint lightr = 255u, lightg = 255u, lightb = 255u;
    uint specR  = 0u,   specG  = 0u,   specB  = 0u;

    if (u_rendererSW == 0) {
        // --- Sun lighting ---
        // quad.cpp:1283: lightIntensity = vertices[0]->pVertex->vertexNormal * eye->lightDirection
        float lightIntensity = dot(v.normal, u_sunLightDir);

        // quad.cpp:1285-1289: shadow clamp
        bool hasShadow = (v.flags & GPU_VERT_SHADOW) != 0u;
        if (hasShadow && lightIntensity > 0.2) {
            lightIntensity = 0.2;
        }

        // quad.cpp:1291-1293: getLightR/G/B (camera.cpp:3065-3110)
        lightr = getLightChannel(lightIntensity, uint(u_lightRed),   uint(u_ambientRed));
        lightg = getLightChannel(lightIntensity, uint(u_lightGreen), uint(u_ambientGreen));
        lightb = getLightChannel(lightIntensity, uint(u_lightBlue),  uint(u_ambientBlue));

        // quad.cpp:1295-1308: BaseVertexColor add-and-clamp
        if (u_baseVertexColorR != 0 || u_baseVertexColorG != 0 || u_baseVertexColorB != 0) {
            lightr = min(lightr + uint(u_baseVertexColorR), 255u);
            lightg = min(lightg + uint(u_baseVertexColorG), 255u);
            lightb = min(lightb + uint(u_baseVertexColorB), 255u);
        }

        // quad.cpp:1310-1315: rainLightLevel dampen
        if (u_rainLightLevel < 1.0) {
            lightr = uint(float(lightr) * u_rainLightLevel);
            lightb = uint(float(lightb) * u_rainLightLevel);
            lightg = uint(float(lightg) * u_rainLightLevel);
        }

        // quad.cpp:1317-1320: lightning
        if (u_lighteningLevel > 0) {
            specR = specG = specB = uint(u_lighteningLevel);
        }

        // quad.cpp:1325-1370: per-light loop (lights indexed from 2, matching "first two factored in")
        // Shader receives only lights >= 2 from CPU packing (PackAndDispatch skips lights 0 and 1).
        for (uint i = 0u; i < uint(u_numLights); i++) {
            uint lt = lights[i].lightType;
            if (lt == TG_LIGHT_POINT_GPU || lt == TG_LIGHT_SPOT_GPU || lt == TG_LIGHT_TERRAIN_GPU) {
                // quad.cpp:1338-1342: vertexToLight = vertex.xyz - light.position
                vec3 vertexPos = vec3(v.xy.x, v.xy.y, v.elevation);
                vec3 vtl = vertexPos - lights[i].position;
                float length = GetApproximateLength(vtl);
                float falloff = 1.0;

                if (GetFalloff(i, length, falloff)) {
                    // quad.cpp:1349-1353: color * falloff
                    float red   = lights[i].color.r * 255.0 * falloff;
                    float green = lights[i].color.g * 255.0 * falloff;
                    float blue  = lights[i].color.b * 255.0 * falloff;

                    specR = min(specR + uint(red),   255u);
                    specG = min(specG + uint(green),  255u);
                    specB = min(specB + uint(blue),   255u);
                }
            }
        }
    }

    // quad.cpp:1373: lightRGB = lightb + (lightr<<16) + (lightg<<8) + (0xff<<24)
    // BGRA in memory (mc2_argb_packing.md): stored as 0xAABBGGRR in uint
    // BUT the CPU writes: lightb + (lightr<<16) + (lightg<<8) + (0xff<<24)
    // = (0xff<<24) | (lightr<<16) | (lightg<<8) | lightb
    // = 0xAARRGGBB in hex — alpha=0xff, red=lightr, green=lightg, blue=lightb
    uint lightRGB_out = (0xFFu << 24) | (lightr << 16) | (lightg << 8) | lightb;
    outputs[vn].lightRGB = lightRGB_out;

    // quad.cpp:1374: fogRGB = (0xff<<24) + (specR<<16) + (specG<<8) + specB  (default, before fog)
    uint fogRGB_out = (0xFFu << 24) | (specR << 16) | (specG << 8) | specB;

    // --- Fog (quad.cpp:1376-1426) ---
    uint fogResult = 0xFFu;

    if (u_rendererSW == 0 && u_useFog != 0) {
        float elev = v.elevation;
        if (elev < u_fogStart) {
            float fogFactor = u_fogStart - elev;
            if (fogFactor < 0.0 || (u_fogStart == u_fogFull)) {
                fogResult = 0xFFu;
            } else {
                fogFactor /= (u_fogStart - u_fogFull);
                if (fogFactor <= 1.0) {
                    fogFactor = fogFactor * fogFactor;
                    fogFactor = 1.0 - fogFactor;
                    fogFactor *= 256.0;
                } else {
                    fogFactor = 256.0;
                }
                // float2long = truncation (long(val))
                fogResult = uint(int(fogFactor));
            }
        }
        // else fogResult stays 0xff
        fogRGB_out = (fogResult << 24) | (specR << 16) | (specG << 8) | specB;
    }

    // Step 7 (VPL retirement): hazeFactor inline from worldPos. Replaces SSBO
    // v.hazeFactor (VPL CPU write retired in Step 8c). CPU used GetApproximateLength
    // post length-preserving camera-frame xform; exact length() is the parity-correct
    // upgrade (binary clamp identical when MinHaze==MaxClip stock).
    // outsidePlayArea with bounds (-m,-m,m,m) == CPU !IsGameSelectTerrainPosition
    // (terrain.cpp:687-700) exactly. CPU ||drawTerrainGrid debug bypass intentionally
    // dropped (debug-only path, no production effect).
    vec3 hpos = vec3(v.xy.x, v.xy.y, v.elevation);
    float hazeFactor;
    bool outsidePlayArea = (hpos.x <= g_playAreaBounds.x) || (hpos.x >= g_playAreaBounds.z) ||
                           (hpos.y <= g_playAreaBounds.y) || (hpos.y >= g_playAreaBounds.w);
    if (outsidePlayArea) { hazeFactor = 1.0; }
    else {
        float distanceToEye = length(hpos - u_cameraWorldPos);
        if      (distanceToEye > g_maxClipDistance) hazeFactor = 1.0;
        else if (distanceToEye > g_minHazeDistance) hazeFactor = (distanceToEye - g_minHazeDistance) * g_distanceFactor;
        else                                        hazeFactor = 0.0;
    }
    if (hazeFactor != 0.0) {
        float fogFactor = 1.0 - hazeFactor;
        uint distFog = uint(int(fogFactor * 255.0));
        if (distFog < fogResult) {
            fogResult = distFog;
        }
        fogRGB_out = (fogResult << 24) | (specR << 16) | (specG << 8) | specB;
    }

    outputs[vn].fogRGB = fogRGB_out;
}
