// gpu_cull_block_rollup.comp — Track C slice C1b: C1-RB block-active rollup.
//
// ORs per-actor visibility bits into a per-terrain-block visibility SSBO.
// Consumers (C3 routing etc.) use blockVisBits[] to determine which terrain
// blocks have any GPU-visible actors this frame.
//
// One invocation per actor record. Reads the per-actor visibility bit written
// by the cull shader, then atomicOr's the corresponding block's visibility.
//
// Q12 sync:
//   Caller issues GL_SHADER_STORAGE_BARRIER_BIT after indirect-ready barrier
//   before dispatching this kernel, and GL_SHADER_STORAGE_BARRIER_BIT after
//   this kernel before C3 consumers read blockVisBits[].
//
// #version 430 is injected by the C++ loader — do NOT add it here.

layout(local_size_x = 64) in;

// ---------------------------------------------------------------------------
// GpuActorRecord: mirror of gpu_cull_record.h (std430, 64 B per element).
// LOCKSTEP: must match C++ struct and gpu_cull.comp exactly.
// ---------------------------------------------------------------------------
struct GpuActorRecord {
    vec3     worldCenter;
    float    boundingRadius;
    vec3     worldAabbMin;
    uint     category;
    vec3     worldAabbMax;
    uint     flags;
    uint     actorId;
    uint     prevVisibilityBit;
    uint     consumerFlags;
    uint     blockIdx;          // terrain block index for C1-RB rollup
};

struct GpuActorRecordHeader {
    uint recordCount;
    uint recordCapacity;
    uint visibleCount;
    uint _pad0;
};

// Binding 8: substrate SSBO (same slot as cull dispatch).
layout(std430, binding = 8) readonly buffer RecordsBuf {
    GpuActorRecordHeader hdr;
    GpuActorRecord recs[];
};

// Binding 12: per-actor visibility bits (1=admitted, 0=culled).
// Written by gpu_cull.comp when GPU_CULL_C1B_INDIRECT is defined.
layout(std430, binding = 12) readonly buffer ActorVis {
    uint actorVisBits[];
};

// Binding 13: per-block visibility SSBO. One uint per terrain block.
// OR-accumulated across actors in block. Reset per-frame by C++ via
// glClearNamedBufferSubData before cull dispatch.
layout(std430, binding = 13) coherent buffer BlockVis {
    uint blockVisBits[];
};

// Uniform: number of records this frame.
uniform int u_recordCount;
// C1b temporal-superset: this frame's stamp (== s_cullFrameIdx, lockstep
// with the cull program's uFrameStamp). 'uniform uint' crashes this
// engine's compiler (gpu_cull.comp note) — declare int, cast at use.
uniform int uFrameStamp;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u_recordCount)) return;
    if (actorVisBits[i] == 0u) return;
    uint blk = recs[i].blockIdx;
    // C1b temporal-superset (R3): stamp this block with the CURRENT frame
    // index. atomicMax (not atomicOr/store) so concurrent same-block
    // writers converge to the max stamp. uint() cast is mandatory — there
    // is no atomicMax(uint[], int) GLSL overload; an uncast call is a
    // rollup compile-fail = silent stale shader = green smoke on a dead
    // feature.
    atomicMax(blockVisBits[blk], uint(uFrameStamp));
}
