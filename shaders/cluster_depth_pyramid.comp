// cluster_depth_pyramid.comp  (CLUSTER-DEPTH-PYRAMID-NATIVE-1)
//
// MC2-native depth-tile pyramid substrate. One workgroup reduces one screen
// tile of the sampleable scene depth texture down to a single (min,max) pair,
// stored into an RG32F image: R = numeric MIN depth, G = numeric MAX depth.
//
// REVERSED-Z NOTE: MC2 renders reversed-Z (near ~= 1.0, far ~= 0.0). This pass
// deliberately stores the *numeric* min and max of the raw depth samples and
// makes NO assumption about which is "near". A future clustered-cull consumer
// must interpret semantically: the NEAREST surface in a tile is the numeric
// MAX (channel G) and the FARTHEST is the numeric MIN (channel R). Storing both
// raw extents keeps that choice with the consumer, not baked in here.
//
// No #version line here on purpose — the C++ builder prepends "#version 430\n"
// plus a "#define TILE_SIZE N\n" so the local size matches the C++ dispatch.
// (Project rule: never put #version in a shader file.)

// TILE_SIZE is injected by the C++ side (32 on the AMD GL 4.3 target; see the
// builder for the floor-fallback rationale). Guard so a standalone compile
// still has a value.
#ifndef TILE_SIZE
#define TILE_SIZE 32
#endif

layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE, local_size_z = 1) in;

// Input: the resolved, sampleable scene depth (DEPTH24_STENCIL8). Sampled as a
// plain sampler2D — the depth component reads back in [0,1].
layout(binding = 0) uniform sampler2D u_sceneDepth;

// Output: per-tile (min,max) image. R = min, G = max.
layout(binding = 0, rg32f) uniform writeonly image2D u_tileMinMax;

// Full scene-depth dimensions in texels (the tile grid is ceil(dim/TILE_SIZE)).
uniform ivec2 u_depthSize;

// Shared reduction scratch: one float per invocation in the workgroup.
shared float s_min[TILE_SIZE * TILE_SIZE];
shared float s_max[TILE_SIZE * TILE_SIZE];

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    uint  li = gl_LocalInvocationIndex;

    // Out-of-range invocations (right/bottom edge tiles) contribute identity
    // extremes so they never affect the min/max of in-range samples.
    float d;
    bool inRange = (px.x < u_depthSize.x) && (px.y < u_depthSize.y);
    if (inRange) {
        d = texelFetch(u_sceneDepth, px, 0).r;
        s_min[li] = d;
        s_max[li] = d;
    } else {
        s_min[li] = 1.0;   // identity for min (depth is in [0,1])
        s_max[li] = 0.0;   // identity for max
    }

    barrier();

    // Tree reduction over the flat workgroup index. TILE_SIZE*TILE_SIZE is a
    // power of two (32*32=1024 or 16*16=256), so a clean halving reduction.
    for (uint stride = (TILE_SIZE * TILE_SIZE) >> 1u; stride > 0u; stride >>= 1u) {
        if (li < stride) {
            s_min[li] = min(s_min[li], s_min[li + stride]);
            s_max[li] = max(s_max[li], s_max[li + stride]);
        }
        barrier();
    }

    if (li == 0u) {
        // One texel out per workgroup == one tile.
        imageStore(u_tileMinMax, ivec2(gl_WorkGroupID.xy),
                   vec4(s_min[0], s_max[0], 0.0, 0.0));
    }
}
