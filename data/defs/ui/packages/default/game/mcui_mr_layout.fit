    layer = "salvage_area.metadata"
    legacyUiVariant = "salvage_area"
    aliasOverride = "metadata"
    sourceControlType = "SalvageAreaStatics"
    rect = "0,0,0,0"
    legacyLocalRect = "0,0,0,0"
    legacyRectSource = "xywh"
    visible = false
}

