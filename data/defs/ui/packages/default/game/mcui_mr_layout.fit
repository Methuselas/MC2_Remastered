// MC2R ImGui FIT generated from legacy UI FIT.
// Source: data/defs/ui/legacy/game/MCUI_MR_Layout.fit
// Legacy files remain source truth only; edit the generated ImGui FIT.

GuiPage {
    key = "game.mcui_mr_layout"
    title = "Game Mcui Mr Layout"
    sourceLegacyFit = "data/defs/ui/legacy/game/MCUI_MR_Layout.fit"
    sourceSystem = "game"
    sourceScreen = "mcui_mr_layout"
    sourceKind = "legacy_screen"
    layout = "absolute"
    coordinateSpace = "screen_absolute"
    localWidth = 800
    // RESULTS-SQUISH-1: converter took the page extent from ONE promotion
    // slide-in element authored offscreen (y->1326); every on-screen widget of
    // all four sub-areas lives in 0..600. 1326 made PageScale sy=displayH/1326
    // squash the whole AAR into the top of the screen. Design space is 800x600;
    // the outlier element clips, exactly as legacy did.
    localHeight = 600
    mountOffset = "0,0"
    editableSource = "generated_imgui_only"
    overlayGameOS = true
    renderMode = "gameos_overlay"
    backgroundPolicy = "transparent_overlay"
}

GuiMetadata {
    key = "game.mcui_mr_layout.metadata.metadata"
    pageKey = "game.mcui_mr_layout"
    legacySection = "SalvageAreaStatics"
    legacyContext = "MISSION RESULTS AREA- | four parts: Salvage Area, Pilot Review, Promotion Gadget Left, and Promotion Gadget Right | each part is broken into five sections: statics, rects, buttons, text, and misc. (animations, etc)"
