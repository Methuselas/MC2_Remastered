 * UPDATED BY: Methuselas
 * UPDATED: 2026-05-23
 *
 * CHANGES:
 * - Registered legacy_imgui editor pages and converted MFC dialog pages.
 * - Marks MFC as extraction source only; FIT/ImGui is the replacement target.
 ***************************************************************/

UiReplacementManifest {
    key = "editor.ui.replacement"
    title = "Editor UI Replacement"
    target = "fit_imgui"
    mfcStatus = "extraction_source_only"
    notes = "Load these pages in the UI Editor; do not build new runtime work around MFC."
}

UiReplacementSource {
    key = "editor.legacy_imgui.editorcursors"
    sourceKind = "legacy_gameos_fit"
