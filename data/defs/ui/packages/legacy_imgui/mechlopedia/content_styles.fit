// Shared Mechlopedia dynamic content text styles.
// These styles are used by the Viewer ImGui content binding pass.
// Font names resolve through data/defs/ui/packages/legacy_imgui/shared/fonts.fit.

MechlopediaContentStyle {
    role = "list"
    font = "Agency Bold"
    fontSize = 14
    bold = false
    italic = false
    uppercase = true
    wrap = false
    colorArgb = "0xffff8a00"
    selectedColorArgb = "0xffffffff"
    lineSpacing = 2
    paddingX = 6
    paddingY = 3
    scrollbarWidth = 14
}

