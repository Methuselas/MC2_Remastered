    helpDescLegacyId = 26076
    helpDescKey = "legacy.mc2res.26076"
    helpDescText = "LAN BROWSER     In this screen, you can review the games currently running on your local area network, join an existing game, or host a new game. Games can be sorted by clicking any column heading. A selected game is white, games that can be joined are orange, and games that are not available for selection are gray."
