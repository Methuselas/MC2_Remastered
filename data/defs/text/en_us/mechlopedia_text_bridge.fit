String {
    key = "mechlopedia.building.light_wall.description"
    text = "A Light Wall prevents vehicles and 'Mechs from direct entry onto a base, but it can be destroyed with repeated salvos from energy or ballistic weaponry. A Light Wall is not tall enough to block the line of sight of Heavy and Assault 'Mechs."
    legacyId = 45420
