String {
    key = "mechlopedia.component.011_medium_jump_jet.description"
    text = "The advantages of deploying a Jump Jet-equipped 'Mech should be considered before any mission.\n\nScout 'Mechs can acquire excellent vantage points for observing enemy installations or battle team movements by vaulting to high ground from the leeward side.\n\nHaving a jump 'Mech in any weight class can help with both dogfights in open terrain and assault/siege attacks. In dogfights, fire-support 'Mechs can grab high ground before foot-bound 'Mechs and serially destroy enemy 'Mechs. 'Mechs on the valley floor, for example, would already be engaged with the jumper's battlemates and could offer diminished defensive fire. Such a jump 'Mech can turn any face-off beneath it into a two-on-one fight with a swivel of its torso.\n\nIn a base assault or siege maneuver, jumpers can hurdle base walls and capture interior structures such as turret and gate controls. Without a jumper âMech on the team, the others have to use prolonged barrages to \"open the door.\""
    paragraphCount = 4
    paragraph0 = "The advantages of deploying a Jump Jet-equipped 'Mech should be considered before any mission."
    paragraph1 = "Scout 'Mechs can acquire excellent vantage points for observing enemy installations or battle team movements by vaulting to high ground from the leeward side."
    paragraph2 = "Having a jump 'Mech in any weight class can help with both dogfights in open terrain and assault/siege attacks. In dogfights, fire-support 'Mechs can grab high ground before foot-bound 'Mechs and serially destroy enemy 'Mechs. 'Mechs on the valley floor, for example, would already be engaged with the jumper's battlemates and could offer diminished defensive fire. Such a jump 'Mech can turn any face-off beneath it into a two-on-one fight with a swivel of its torso."
    paragraph3 = "In a base assault or siege maneuver, jumpers can hurdle base walls and capture interior structures such as turret and gate controls. Without a jumper âMech on the team, the others have to use prolonged barrages to \"open the door.\""
    legacyId = 34010
    legacySymbol = "IDS_COMPENCYCLO11"
    source = "mechlopedia"
    sourceKey = "component.10.encyclopedia"
    originalKey = "mechlopedia.component.011_medium_jump_jet.description"
    mechlopediaType = "component"
    role = "description"
    groupKey = "011_medium_jump_jet"
    groupName = "011 Medium Jump Jet"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

