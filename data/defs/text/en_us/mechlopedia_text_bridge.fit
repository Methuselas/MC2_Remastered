String {
    key = "mechlopedia.building.prison.description"
    text = "A Prison houses prisoners of war. Captured 'Mech pilots make up most of the inmate population, and capturing prisons can at times liberate 'Mech pilots who, out of gratitude, will make themselves available for your subsequent missions."
    legacyId = 45431
    legacySymbol = "IDS_BUILDING_ENCYCLO31"
