String {
    key = "mechlopedia.component.111_clan_ultra_medium_autocannon.description"
    text = "Clan Ultra Autocannons use mechanical principles similar to those of Ultra Autocannons, but advanced Clan engineering and materials produce even better performance. Overall rate of fire is increased over that of Ultra Autocannons.\n\nThe Light Autocannon fires shells 30 mm or larger and is effective out to long range. Used primarily on vehicles and tanks, the Light Autocannon occasionally sees duty mounted on 'Mechs designed to eliminate smaller, fast-moving threats.\n\nBelow-average armor penetration capability limits the Light Autocannon's effectiveness against 'Mechs."
    paragraphCount = 3
    paragraph0 = "Clan Ultra Autocannons use mechanical principles similar to those of Ultra Autocannons, but advanced Clan engineering and materials produce even better performance. Overall rate of fire is increased over that of Ultra Autocannons."
    paragraph1 = "The Light Autocannon fires shells 30 mm or larger and is effective out to long range. Used primarily on vehicles and tanks, the Light Autocannon occasionally sees duty mounted on 'Mechs designed to eliminate smaller, fast-moving threats."
    paragraph2 = "Below-average armor penetration capability limits the Light Autocannon's effectiveness against 'Mechs."
    legacyId = 34110
    legacySymbol = "IDS_COMPENCYCLO111"
    source = "mechlopedia"
    sourceKey = "component.110.encyclopedia"
    originalKey = "mechlopedia.component.111_clan_ultra_medium_autocannon.description"
    mechlopediaType = "component"
    role = "description"
    groupKey = "111_clan_ultra_medium_autocannon"
    groupName = "111 Clan Ultra Medium Autocannon"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

