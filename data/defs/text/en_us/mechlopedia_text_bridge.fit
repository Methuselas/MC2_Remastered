    groupName = "Starslayer"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

String {
    key = "mechlopedia.mech.thor.description"
    text = "Often employed by the Clanners of Jade Falcon, the Thor is a favorite among aggressive mechwarriors who require a 'Mech capable of closing quickly and finishing an opponent. Possessing a powerful engine and jump capable, the Thor performs its duties easily with the aid of an Ultra Heavy Autocannon and Streak Short-Range Missiles.\n\nThe Thor sees use in numerous roles by commanders, from fire support to shock trooper. But in all of its configurations, the Thor is known for excellent mobility and relentless weapon fire. "
    paragraphCount = 2
    paragraph0 = "Often employed by the Clanners of Jade Falcon, the Thor is a favorite among aggressive mechwarriors who require a 'Mech capable of closing quickly and finishing an opponent. Possessing a powerful engine and jump capable, the Thor performs its duties easily with the aid of an Ultra Heavy Autocannon and Streak Short-Range Missiles."
    paragraph1 = "The Thor sees use in numerous roles by commanders, from fire support to shock trooper. But in all of its configurations, the Thor is known for excellent mobility and relentless weapon fire."
