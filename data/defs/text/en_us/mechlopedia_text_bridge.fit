    role = "description"
    groupKey = "urbanmech"
    groupName = "Urbanmech"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

String {
    key = "mechlopedia.mech.vulture.name"
    text = "VULTURE"
    legacyId = 28908
    legacySymbol = "IDS_MECH_VULTURE"
    source = "mechlopedia"
    sourceKey = "unit.mech.vulture"
