String {
    key = "mechlopedia.component.026_vehicle_ferro_fibrous_armor.description"
    text = "The base armor on a 'Mech may be enhanced by adding additional armor plating. Each armor component adds 32 points of armor divided among all of a 'Mech's locations such as the arms, legs, head, torso, and back.\n\nExtra armor is often incorporated into designs for 'Mechs used for frontline assaults, in order to draw enemy fire away from the lightly armored support 'Mechs.\n\nSeveral commanders have noted that heavy armor works well in conjunction with short-range weapons. The extra protection allows the 'Mech to survive initial enemy volleys until it can work its way into short range, where it can then take apart enemies unable to fire at short distances.\n\nThere is limited surface area on a 'Mech available for armor, so the maximum armor capacity of any 'Mech is determined by its size."
    paragraphCount = 4
    paragraph0 = "The base armor on a 'Mech may be enhanced by adding additional armor plating. Each armor component adds 32 points of armor divided among all of a 'Mech's locations such as the arms, legs, head, torso, and back."
    paragraph1 = "Extra armor is often incorporated into designs for 'Mechs used for frontline assaults, in order to draw enemy fire away from the lightly armored support 'Mechs."
    paragraph2 = "Several commanders have noted that heavy armor works well in conjunction with short-range weapons. The extra protection allows the 'Mech to survive initial enemy volleys until it can work its way into short range, where it can then take apart enemies unable to fire at short distances."
    paragraph3 = "There is limited surface area on a 'Mech available for armor, so the maximum armor capacity of any 'Mech is determined by its size."
    legacyId = 34025
    legacySymbol = "IDS_COMPENCYCLO26"
    source = "mechlopedia"
    sourceKey = "component.25.encyclopedia"
    originalKey = "mechlopedia.component.026_vehicle_ferro_fibrous_armor.description"
    mechlopediaType = "component"
    role = "description"
    groupKey = "026_vehicle_ferro_fibrous_armor"
    groupName = "026 Vehicle Ferro-Fibrous Armor"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

