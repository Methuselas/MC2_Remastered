String {
    key = "mechlopedia.mech.catapult.name"
    text = "CATAPULT"
    legacyId = 28925
    legacySymbol = "IDS_MECH_CATAPULT"
    source = "mechlopedia"
    sourceKey = "unit.mech.catapult"
