String {
    key = "mechlopedia.building.short_pipe.description"
    text = "Short Pipes crisscross several battle theaters. All sides stand to suffer from the loss of fuel transport, but the web of pipelines and other transport alternatives is labyrinthine, and all sides seem able to withstand the loss of some pipelines.\n\nThe intriguing aspect to the presence of Short Pipes is their unintended utility as spare ordnance on the field; lure opponents within range of the collateral damage of a pipe, and then blast the pipe for a crude incendiary device."
    paragraphCount = 2
    paragraph0 = "Short Pipes crisscross several battle theaters. All sides stand to suffer from the loss of fuel transport, but the web of pipelines and other transport alternatives is labyrinthine, and all sides seem able to withstand the loss of some pipelines."
    paragraph1 = "The intriguing aspect to the presence of Short Pipes is their unintended utility as spare ordnance on the field; lure opponents within range of the collateral damage of a pipe, and then blast the pipe for a crude incendiary device."
    legacyId = 45411
    legacySymbol = "IDS_BUILDING_ENCYCLO11"
    source = "mechlopedia"
    sourceKey = "object.building.encyclo11"
    originalKey = "mechlopedia.building.short_pipe.description"
    mechlopediaType = "building"
    role = "description"
    groupKey = "short_pipe"
    groupName = "Short Pipe"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

