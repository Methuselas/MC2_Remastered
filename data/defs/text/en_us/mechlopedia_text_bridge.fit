String {
    key = "mechlopedia.building.large_fuel_tank.description"
    text = "Large Fuel Tanks dot several battle theaters. All sides in the battle for Carver V have taken great care to ensure deep redundancies in their fuel storage systems, so almost any fuel tank you encounter on the field is certain to be an attractive target with no consequences for you or your employers.\n\nThe intriguing aspect to the presence of Large Fuel Tanks is their unintended utility as spare ordnance on the field; lure opponents within range of the collateral damage of a tank, and then blast the tank for a crude incendiary device."
    paragraphCount = 2
    paragraph0 = "Large Fuel Tanks dot several battle theaters. All sides in the battle for Carver V have taken great care to ensure deep redundancies in their fuel storage systems, so almost any fuel tank you encounter on the field is certain to be an attractive target with no consequences for you or your employers."
    paragraph1 = "The intriguing aspect to the presence of Large Fuel Tanks is their unintended utility as spare ordnance on the field; lure opponents within range of the collateral damage of a tank, and then blast the tank for a crude incendiary device."
    legacyId = 45401
    legacySymbol = "IDS_BUILDING_ENCYCLO1"
    source = "mechlopedia"
    sourceKey = "object.building.encyclo1"
    originalKey = "mechlopedia.building.large_fuel_tank.description"
    mechlopediaType = "building"
    role = "description"
    groupKey = "large_fuel_tank"
    groupName = "Large Fuel Tank"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

