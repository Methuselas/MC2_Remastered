    key = "mechlopedia.component.136_clan_streak_sr_missile_6.description"
    text = "The Clan Streak SRM Pack is identical to the standard Streak SRM Pack, except it is constructed with typical high-quality Clan engineering and materials, resulting in a better firing rate."
