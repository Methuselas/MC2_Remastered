String {
    key = "mechlopedia.component.105_machine_gun.description"
    text = "Gauss Rifles are electromagnetic weapons that fire solid projectiles at high velocities. Using electromagnetic rails to accelerate a low-profile slug made of conducting material, the Gauss Rifle delivers massive kinetic energy at long ranges. Because it fires without chemical combustion, Gauss Rifles generate less heat than autocannons and missiles."
    legacyId = 34104
    legacySymbol = "IDS_COMPENCYCLO105"
    source = "mechlopedia"
