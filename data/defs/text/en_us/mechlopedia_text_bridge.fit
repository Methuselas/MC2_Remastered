String {
    key = "mechlopedia.component.141_er_large_laser.description"
    text = "The Large Laser is a larger and more powerful version of the standard Laser. Firing a more coherent beam, the Larger Laser has better range and damage.\n\nThis weapon is a staple for both tanks and 'Mechs and can be found anywhere in the Inner Sphere."
    paragraphCount = 2
    paragraph0 = "The Large Laser is a larger and more powerful version of the standard Laser. Firing a more coherent beam, the Larger Laser has better range and damage."
    paragraph1 = "This weapon is a staple for both tanks and 'Mechs and can be found anywhere in the Inner Sphere."
