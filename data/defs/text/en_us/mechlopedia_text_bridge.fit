String {
    key = "mechlopedia.building.gate_control.description"
    text = "A Gate Control links to one or more gates, determining whether they open for friendly units or remain closed for enemy units. Gate Controls serve as the secondary target in base attacks; Turret Controls are always the first priority. Capture of a Gate Control changes the alignment of all the linked gates to the alignment of the capturing unit. Destruction of a Gate Control deactivates all of the linked gates.\n\nDestroying a Gate Control Generator leaves linked gates stuck in their position at the time the Gate Control was destroyed: Closed gates will stay closed, and open gates will remain open.\n\n'Mechs equipped with jump jets can vault into bases, capture the Gate Control, and open the gates for other units."
    paragraphCount = 3
    paragraph0 = "A Gate Control links to one or more gates, determining whether they open for friendly units or remain closed for enemy units. Gate Controls serve as the secondary target in base attacks; Turret Controls are always the first priority. Capture of a Gate Control changes the alignment of all the linked gates to the alignment of the capturing unit. Destruction of a Gate Control deactivates all of the linked gates."
    paragraph1 = "Destroying a Gate Control Generator leaves linked gates stuck in their position at the time the Gate Control was destroyed: Closed gates will stay closed, and open gates will remain open."
    paragraph2 = "'Mechs equipped with jump jets can vault into bases, capture the Gate Control, and open the gates for other units."
    legacyId = 45402
    legacySymbol = "IDS_BUILDING_ENCYCLO2"
    source = "mechlopedia"
    sourceKey = "object.building.encyclo2"
    originalKey = "mechlopedia.building.gate_control.description"
    mechlopediaType = "building"
    role = "description"
    groupKey = "gate_control"
    groupName = "Gate Control"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

String {
    key = "mechlopedia.building.gauss_turret.name"
    text = "Gauss Turret"
    legacyId = 30323
    legacySymbol = "IDS_OBJECT_323"
    source = "mechlopedia"
    sourceKey = "object.323"
    originalKey = "mechlopedia.building.gauss_turret.name"
    mechlopediaType = "building"
    role = "name"
    groupKey = "gauss_turret"
    groupName = "Gauss Turret"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

String {
    key = "mechlopedia.building.gauss_turret.description"
    text = "Troublesome when encountered during missions, the Gauss Turret locks on targets from long range and, when enjoying a direct line of sight, can lay waste to Light 'Mechs with one shot and significantly reduce the armor of larger 'Mechs. This turret is encountered only in Davion territories.\n\nGauss Turrets are effective at great distances and produce immense violence when they find their target. They often start damaging approaching 'Mechs before the opposing pilots even know they are there. They are most easily defeated at close range unless your 'Mech team can call in an airstrike or respond with a Gauss Rifle of its own. If they can be captured, Gauss Turrets offer a great strategic advantage to the MechCommander with large territories under control.\n\nA group of Gauss Turrets depends on a Turret Generator and a Turret Control to function. Destroy the generator to cripple the turrets, or capture the control to align the turrets with your own team."
    paragraphCount = 3
    paragraph0 = "Troublesome when encountered during missions, the Gauss Turret locks on targets from long range and, when enjoying a direct line of sight, can lay waste to Light 'Mechs with one shot and significantly reduce the armor of larger 'Mechs. This turret is encountered only in Davion territories."
    paragraph1 = "Gauss Turrets are effective at great distances and produce immense violence when they find their target. They often start damaging approaching 'Mechs before the opposing pilots even know they are there. They are most easily defeated at close range unless your 'Mech team can call in an airstrike or respond with a Gauss Rifle of its own. If they can be captured, Gauss Turrets offer a great strategic advantage to the MechCommander with large territories under control."
    paragraph2 = "A group of Gauss Turrets depends on a Turret Generator and a Turret Control to function. Destroy the generator to cripple the turrets, or capture the control to align the turrets with your own team."
    legacyId = 45427
    legacySymbol = "IDS_BUILDING_ENCYCLO27"
    source = "mechlopedia"
    sourceKey = "object.building.encyclo27"
    originalKey = "mechlopedia.building.gauss_turret.description"
    mechlopediaType = "building"
    role = "description"
    groupKey = "gauss_turret"
    groupName = "Gauss Turret"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

