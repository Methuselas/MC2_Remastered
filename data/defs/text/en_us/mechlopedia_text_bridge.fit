String {
    key = "mechlopedia.mech.zeus.description"
    text = "Despite an accelerated prototype cycle and early battle deployment, the Zeus has proven from its first tours of duty to be one of the most versatile of Assault-class 'Mechs. House Steiner requested an 80-ton unit with hit-and-run capability, and these BattleMechs rolled off the production line 3 years later literally to defend the very factories where the first ones were made.\n\nDesigned to lay down continual barrages of missile and energy weapons fire, the Zeus houses one of the best heat dissipation systems found in any 'Mech. The effectiveness of the initial design has carried the Zeus through history with relatively little change. The current Zeus models still bear the PPC and Long-Range Missiles of its predecessor.\n\nLinked for years with the Lyran Commonwealth, the Zeus still sees extensive duty under House Steiner."
    paragraphCount = 3
    paragraph0 = "Despite an accelerated prototype cycle and early battle deployment, the Zeus has proven from its first tours of duty to be one of the most versatile of Assault-class 'Mechs. House Steiner requested an 80-ton unit with hit-and-run capability, and these BattleMechs rolled off the production line 3 years later literally to defend the very factories where the first ones were made."
    paragraph1 = "Designed to lay down continual barrages of missile and energy weapons fire, the Zeus houses one of the best heat dissipation systems found in any 'Mech. The effectiveness of the initial design has carried the Zeus through history with relatively little change. The current Zeus models still bear the PPC and Long-Range Missiles of its predecessor."
    paragraph2 = "Linked for years with the Lyran Commonwealth, the Zeus still sees extensive duty under House Steiner."
    legacyId = 28951
    legacySymbol = "IDS_MECH_ZEUS2"
    source = "mechlopedia"
    sourceKey = "unit.mech.zeus2"
    originalKey = "mechlopedia.mech.zeus.description"
    mechlopediaType = "mech"
    role = "description"
    groupKey = "zeus"
    groupName = "Zeus"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

