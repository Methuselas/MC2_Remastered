String {
    key = "mechlopedia.component.104_gauss_rifle.description"
    text = "Improvements in the design of the feed mechanisms and advanced materials allow Ultra Autocannons to sustain a higher cyclic firing rate over conventional autocannons. Firing the same caliber ammunition, Ultra Autocannons net a significant increase in damage potential as well as cost.\n\nThe Light Autocannon fires shells 30 mm or larger and is effective out to long range. Used primarily on vehicles and tanks, the Light Autocannon occasionally sees duty mounted on 'Mechs designed to eliminate smaller, fast-moving threats.\n\nBelow-average armor penetration capability limits the Light Autocannon's effectiveness against 'Mechs."
    paragraphCount = 3
    paragraph0 = "Improvements in the design of the feed mechanisms and advanced materials allow Ultra Autocannons to sustain a higher cyclic firing rate over conventional autocannons. Firing the same caliber ammunition, Ultra Autocannons net a significant increase in damage potential as well as cost."
    paragraph1 = "The Light Autocannon fires shells 30 mm or larger and is effective out to long range. Used primarily on vehicles and tanks, the Light Autocannon occasionally sees duty mounted on 'Mechs designed to eliminate smaller, fast-moving threats."
    paragraph2 = "Below-average armor penetration capability limits the Light Autocannon's effectiveness against 'Mechs."
    legacyId = 34103
    legacySymbol = "IDS_COMPENCYCLO104"
    source = "mechlopedia"
    sourceKey = "component.103.encyclopedia"
    originalKey = "mechlopedia.component.104_gauss_rifle.description"
    mechlopediaType = "component"
    role = "description"
    groupKey = "104_gauss_rifle"
    groupName = "104 Gauss Rifle"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

