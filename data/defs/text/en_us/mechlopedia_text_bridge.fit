String {
    key = "mechlopedia.component.161_thunderbolt_missile.description"
    text = "The Long Tom Cannon is a smaller version of the heavy artillery piece. This version can be mounted on a 'Mech chassis, although only the largest 'Mechs have enough payload space to accommodate one.\n\nThe Long Tom lobs high-explosive shells indirectly at targets, clearing any intervening obstacles. The shell itself inflicts high levels of damage to everything within a large radius.\n\nAlthough a powerful weapon, the Long Tom has been cited as the cause of numerous friendly fire casualties on the battlefield. Commanders are advised to be judicious when employing this dangerous device."
    paragraphCount = 3
    paragraph0 = "The Long Tom Cannon is a smaller version of the heavy artillery piece. This version can be mounted on a 'Mech chassis, although only the largest 'Mechs have enough payload space to accommodate one."
    paragraph1 = "The Long Tom lobs high-explosive shells indirectly at targets, clearing any intervening obstacles. The shell itself inflicts high levels of damage to everything within a large radius."
    paragraph2 = "Although a powerful weapon, the Long Tom has been cited as the cause of numerous friendly fire casualties on the battlefield. Commanders are advised to be judicious when employing this dangerous device."
    legacyId = 34160
    legacySymbol = "IDS_COMPENCYCLO161"
    source = "mechlopedia"
    sourceKey = "component.160.encyclopedia"
    originalKey = "mechlopedia.component.161_thunderbolt_missile.description"
    mechlopediaType = "component"
    role = "description"
    groupKey = "161_thunderbolt_missile"
    groupName = "161 Thunderbolt Missile"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

