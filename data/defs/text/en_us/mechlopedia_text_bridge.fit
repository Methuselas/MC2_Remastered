String {
    key = "mechlopedia.building.resource_building.description"
    text = "When a Resource Building is captured, resource points are earned, which can than be exchanged for tactical support. Resource points can only be used in the current mission and are not saved for use in any subsequent missions."
    legacyId = 45414
    legacySymbol = "IDS_BUILDING_ENCYCLO14"
