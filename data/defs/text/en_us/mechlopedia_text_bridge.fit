String {
    key = "mechlopedia.component.131_clan_lr_missile_15.description"
    text = "The Clan Long-Range Missile Rack launches twice as many missile salvos as the standard LRM Rack while fitting in the same payload space. Advanced construction and lightweight materials found in many Clan weapons are evident in this device.\n\nThis weapon is found in many Clan 'Mech designs, a testament to its effectiveness."
    paragraphCount = 2
    paragraph0 = "The Clan Long-Range Missile Rack launches twice as many missile salvos as the standard LRM Rack while fitting in the same payload space. Advanced construction and lightweight materials found in many Clan weapons are evident in this device."
    paragraph1 = "This weapon is found in many Clan 'Mech designs, a testament to its effectiveness."
    legacyId = 34130
    legacySymbol = "IDS_COMPENCYCLO131"
    source = "mechlopedia"
