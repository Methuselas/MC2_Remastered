String {
    key = "mechlopedia.component.155_flamer_array.description"
    text = "The Particle Projection Cannon, or PPC, fires bolts consisting mainly of high-energy protons or ions. Unlike laser weapons, the PPC is able to deliver both kinetic and thermal energy, resulting in excellent penetration power against armor.\n\nAn impressive example of advanced Clan engineering, the Clan ER PPC is effective to long range and can maintain a higher firing rate than the standard PPC. Although prohibitively expensive, this weapon remains a favorite among elite Clan MechWarriors."
    paragraphCount = 2
    paragraph0 = "The Particle Projection Cannon, or PPC, fires bolts consisting mainly of high-energy protons or ions. Unlike laser weapons, the PPC is able to deliver both kinetic and thermal energy, resulting in excellent penetration power against armor."
    paragraph1 = "An impressive example of advanced Clan engineering, the Clan ER PPC is effective to long range and can maintain a higher firing rate than the standard PPC. Although prohibitively expensive, this weapon remains a favorite among elite Clan MechWarriors."
    legacyId = 34154
    legacySymbol = "IDS_COMPENCYCLO155"
    source = "mechlopedia"
    sourceKey = "component.154.encyclopedia"
    originalKey = "mechlopedia.component.155_flamer_array.description"
