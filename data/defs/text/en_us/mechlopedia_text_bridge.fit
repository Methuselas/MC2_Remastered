String {
    key = "mechlopedia.building.sensor_control.description"
    text = "A Sensor Control manages a network of Sensor Towers, which relay sensor data on the enemy to Headquarters or directly to 'Mechs in the field.\n\nCapture an enemy Sensor Control to align the towers with your team, depriving foes of their intelligence channels and boosting the effectiveness of your own reconnaissance."
    paragraphCount = 2
    paragraph0 = "A Sensor Control manages a network of Sensor Towers, which relay sensor data on the enemy to Headquarters or directly to 'Mechs in the field."
