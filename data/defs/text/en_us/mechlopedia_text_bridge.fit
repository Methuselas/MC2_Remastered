String {
    key = "mechlopedia.component.100_light_autocannon.description"
    text = "Mechanically identical to the Gauss Rifle, the Light Gauss Rifle's main advantage is in its lightweight construction and compact size. This comes at the expense of firing a smaller projectile, which inflicts less damage than the standard Gauss Rifle."
