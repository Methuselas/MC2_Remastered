String {
    key = "mechlopedia.component.113_clan_gauss_rifle.description"
    text = "Improvements in the design of the feed mechanisms and advanced materials allow Ultra Autocannons to sustain a higher cyclic firing rate over conventional autocannons. Firing the same caliber ammunition, Ultra Autocannons net a significant increase in damage potential as well as cost.\n\nAlso called the AC/20, the Heavy Autocannon is a short-range weapon that fires large-caliber shells between 80 and 120 mm. Although bulky, expensive, and difficult to mount, the Heavy Autocannon overcomes all its faults by delivering extreme damage and excels at disabling heavily armored targets.\n\nFound primarily on larger 'Mechs, the Heavy Autocannon is only suited for anti-'Mech operations, as any other use is considered overkill."
    paragraphCount = 3
    paragraph0 = "Improvements in the design of the feed mechanisms and advanced materials allow Ultra Autocannons to sustain a higher cyclic firing rate over conventional autocannons. Firing the same caliber ammunition, Ultra Autocannons net a significant increase in damage potential as well as cost."
    paragraph1 = "Also called the AC/20, the Heavy Autocannon is a short-range weapon that fires large-caliber shells between 80 and 120 mm. Although bulky, expensive, and difficult to mount, the Heavy Autocannon overcomes all its faults by delivering extreme damage and excels at disabling heavily armored targets."
    paragraph2 = "Found primarily on larger 'Mechs, the Heavy Autocannon is only suited for anti-'Mech operations, as any other use is considered overkill."
    legacyId = 34112
    legacySymbol = "IDS_COMPENCYCLO113"
    source = "mechlopedia"
    sourceKey = "component.112.encyclopedia"
    originalKey = "mechlopedia.component.113_clan_gauss_rifle.description"
    mechlopediaType = "component"
    role = "description"
    groupKey = "113_clan_gauss_rifle"
    groupName = "113 Clan Gauss Rifle"
    migrationState = "phase3_shared_mechlopedia_text_bridge"
}

