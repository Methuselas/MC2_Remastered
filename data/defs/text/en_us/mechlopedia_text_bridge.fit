String {
    key = "mechlopedia.vehicle.shilone_bomber.name"
    text = "Shilone Bomber"
    legacyId = 45391
    legacySymbol = "IDS_SHILONE"
    source = "mechlopedia"
    sourceKey = "unclassified.shilone"
    originalKey = "mechlopedia.vehicle.shilone_bomber.name"
