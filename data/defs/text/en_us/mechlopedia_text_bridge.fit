String {
    key = "mechlopedia.vehicle.harasser.description"
    text = "The Harasser more than lives up to its name, striking quickly and unleashing missile fire before many 'Mechs can react. If it enters the field of battle undetected, it can introduce a great deal of mayhem for its 20 tons.\n\nWhen moving at full throttle, it is difficult for most vehicles and even most 'Mechs to gain target lock on the Harasser. It is best caught at long range before it can begin its strafing runs, when one shot from a heavy weapon can penetrate its light armor and obliterate the vehicle."
    paragraphCount = 2
    paragraph0 = "The Harasser more than lives up to its name, striking quickly and unleashing missile fire before many 'Mechs can react. If it enters the field of battle undetected, it can introduce a great deal of mayhem for its 20 tons."
    paragraph1 = "When moving at full throttle, it is difficult for most vehicles and even most 'Mechs to gain target lock on the Harasser. It is best caught at long range before it can begin its strafing runs, when one shot from a heavy weapon can penetrate its light armor and obliterate the vehicle."
    legacyId = 45209
    legacySymbol = "IDS_VEHICLE_DESCRIPTION_9"
    source = "mechlopedia"
    sourceKey = "unit.vehicle.description.9"
    originalKey = "mechlopedia.vehicle.harasser.description"
