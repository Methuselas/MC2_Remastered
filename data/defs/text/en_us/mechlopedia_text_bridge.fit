String {
    key = "mechlopedia.building.lookout_tower.description"
    text = "A Lookout Tower augments the battle readiness of a Turret Control. Crippling a Lookout Tower may severely hamper a control's turrets for long-range targeting. Without a Lookout Tower, intelligence reports indicate that turrets may depend exclusively on line-of-sight target acquisition."
    legacyId = 45408
    legacySymbol = "IDS_BUILDING_ENCYCLO8"
    source = "mechlopedia"
