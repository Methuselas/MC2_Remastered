String {
    key = "mechlopedia.vehicle.vtol.description"
    text = "Placeholder text:  The VTOL is a large flying transport capable of carrying the Repair Vehicle and other units summoned for reinforcements and repair.  It has a large bay door that opens and allows vehicles to roll out.  VTOLs may be destroyed either during travel or on the ground.  If the VTOL is destroyed while the summoned vehicle is rolling out then the vehicle is destroyed as well.  If the VTOL is destroyed after the summoned vehicle has rolled out, the vehicle is not affected by the VTOL's destruction."
    legacyId = 45223
    legacySymbol = "IDS_VEHICLE_DESCRIPTION_23"
    legacyKey = "legacy.mc2res.45223"
    source = "mechlopedia"
    sourceKey = "unit.vehicle.description.23"
    originalKey = "mechlopedia.vehicle.vtol.description"
    originalSource = "mc2res"
    sourceFile = "data/defs/text/en_us/Mechlopedia/vehicles.fit"
    legacySourceFile = "data/defs/text/en_us/units.fit"
