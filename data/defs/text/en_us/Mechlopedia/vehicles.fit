String {
    key = "mechlopedia.vehicle.legion.description"
    text = "With prototyped weapons already deep into beta testing on live battlefields, the Legion offers armored cavalry divisions the chance to go toe to toe with 'Mechs. Heavily armored and bristling with heavy long-range weapons, the Legion is unlike any other vehicle in the combat theater.\n\nA distinctive target, the Legion is also a formidable foe. It announces its presence with authority via the long-range Gauss Rifle, and by the time 'Mechs are upon it their armor is already depleted. Then the Legion can open fire with SRMs (short range missiles) and its short-range Lasers.\n\nThe Legion is not a difficult vehicle to overtake on the chase, but if it takes high ground and maintains the element of surprise it is a more than worthy adversary for any 'Mech."
    paragraphCount = 3
    paragraph0 = "With prototyped weapons already deep into beta testing on live battlefields, the Legion offers armored cavalry divisions the chance to go toe to toe with 'Mechs. Heavily armored and bristling with heavy long-range weapons, the Legion is unlike any other vehicle in the combat theater."
    paragraph1 = "A distinctive target, the Legion is also a formidable foe. It announces its presence with authority via the long-range Gauss Rifle, and by the time 'Mechs are upon it their armor is already depleted. Then the Legion can open fire with SRMs (short range missiles) and its short-range Lasers."
    paragraph2 = "The Legion is not a difficult vehicle to overtake on the chase, but if it takes high ground and maintains the element of surprise it is a more than worthy adversary for any 'Mech."
    legacyId = 45207
    legacySymbol = "IDS_VEHICLE_DESCRIPTION_7"
    legacyKey = "legacy.mc2res.45207"
    source = "mechlopedia"
    sourceKey = "unit.vehicle.description.7"
    originalKey = "mechlopedia.vehicle.legion.description"
    originalSource = "mc2res"
