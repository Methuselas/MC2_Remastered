String {
    key = "mechlopedia.mech.anubis.description"
    text = "House Liao deploys the Anubis, one of the fastest 'Mechs in production, as a scout. The Anubis is well equipped for skirmish tactics, using its Jump Jets and Long-Range Missiles to soften enemy forces from a safe distance.\n\nThe Anubis is not an effective choice for extended combat, but it can exact harsh retribution on commanders foolhardy enough to ignore it."
    paragraphCount = 2
    paragraph0 = "House Liao deploys the Anubis, one of the fastest 'Mechs in production, as a scout. The Anubis is well equipped for skirmish tactics, using its Jump Jets and Long-Range Missiles to soften enemy forces from a safe distance."
