String {
    key = "mechlopedia.mech.razorback.description"
    text = "The Razorback serves as a scout 'Mech for Steiner forces throughout the Inner Sphere. Fast and jump capable, this unit combines mobility with enough firepower to hold its own against other Light-class 'Mechs.\n\nTypically seen in advance of the main forces, the Razorback tracks enemies with its sensor equipment and directs the more powerful units toward their targets. It also serves as a base infiltration unit,  jumping over base walls to capture vulnerable control buildings inside, thus weakening the base for the main assault."
    paragraphCount = 2
    paragraph0 = "The Razorback serves as a scout 'Mech for Steiner forces throughout the Inner Sphere. Fast and jump capable, this unit combines mobility with enough firepower to hold its own against other Light-class 'Mechs."
    paragraph1 = "Typically seen in advance of the main forces, the Razorback tracks enemies with its sensor equipment and directs the more powerful units toward their targets. It also serves as a base infiltration unit,  jumping over base walls to capture vulnerable control buildings inside, thus weakening the base for the main assault."
