String {
    key = "mechlopedia.component.007_heat_sink.description"
    text = "The Adams OA-34 Heat Sink is indispensable for any 'Mech with energy or heavy ballistic weapons, both of which produce heat. Heat can interfere with engine and sensor systems as well as climate-control systems in the cockpit, so taking care of this during logistics is your only option.\n\nAdding heat sinks, or better yet multiple heat sinks, to your 'Mech configuration will alleviate the heat problem. After firing multiple salvos, not only are cannon and gun barrels scorched, but laser acceleration housings are near molten and auxiliary systems are taxed. The combination of these factors is known as the heat capacity of a 'Mech, and heat sinks increase that heat capacity.\n\nWith heat sinks, that excess energy accumulates much more slowly."
    paragraphCount = 3
    paragraph0 = "The Adams OA-34 Heat Sink is indispensable for any 'Mech with energy or heavy ballistic weapons, both of which produce heat. Heat can interfere with engine and sensor systems as well as climate-control systems in the cockpit, so taking care of this during logistics is your only option."
    paragraph1 = "Adding heat sinks, or better yet multiple heat sinks, to your 'Mech configuration will alleviate the heat problem. After firing multiple salvos, not only are cannon and gun barrels scorched, but laser acceleration housings are near molten and auxiliary systems are taxed. The combination of these factors is known as the heat capacity of a 'Mech, and heat sinks increase that heat capacity."
    paragraph2 = "With heat sinks, that excess energy accumulates much more slowly."
    legacyId = 34006
    legacySymbol = "IDS_COMPENCYCLO7"
    legacyKey = "legacy.mc2res.34006"
    source = "mechlopedia"
    sourceKey = "component.6.encyclopedia"
    originalKey = "mechlopedia.component.007_heat_sink.description"
    originalSource = "mc2res"
    sourceFile = "data/defs/text/en_us/Mechlopedia/weapons_components.fit"
    legacySourceFile = "data/defs/text/en_us/component_descriptions.fit"
    originalCategory = "component_descriptions"
    mechlopediaType = "component"
    role = "description"
    groupKey = "007_heat_sink"
    groupName = "007 Heat Sink"
    codeReference = "code/mechlopedia.cpp:752-760 + code/logisticscomponent.cpp:init"
    notes = "Component helpStringID / encyclopedia text; current mapping follows legacy IDS_COMPENCYCLO offset."
    migrationState = "phase3_shared_mechlopedia_text"
}

