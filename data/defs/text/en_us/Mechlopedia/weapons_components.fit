String {
    key = "mechlopedia.component.124_srm_pack.description"
    text = "The Swarm LRM Rack is essentially a standard LRM Rack firing special Swarm munitions. Swarm missiles do not detonate on target like normal missiles. Instead, their warheads separate and scatter, damaging anything within their area of effect.\n\nSwarms are extremely useful against groups of enemies, especially in close formation. However, since the warheads separate before actually hitting their target, high-speed 'Mechs can move out of a Swarm's effect radius without being damaged. Similarly, airborne targets such as helicopters cannot be hit by the scattering warheads."
    paragraphCount = 2
    paragraph0 = "The Swarm LRM Rack is essentially a standard LRM Rack firing special Swarm munitions. Swarm missiles do not detonate on target like normal missiles. Instead, their warheads separate and scatter, damaging anything within their area of effect."
    paragraph1 = "Swarms are extremely useful against groups of enemies, especially in close formation. However, since the warheads separate before actually hitting their target, high-speed 'Mechs can move out of a Swarm's effect radius without being damaged. Similarly, airborne targets such as helicopters cannot be hit by the scattering warheads."
    legacyId = 34123
    legacySymbol = "IDS_COMPENCYCLO124"
    legacyKey = "legacy.mc2res.34123"
    source = "mechlopedia"
    sourceKey = "component.123.encyclopedia"
    originalKey = "mechlopedia.component.124_srm_pack.description"
    originalSource = "mc2res"
    sourceFile = "data/defs/text/en_us/Mechlopedia/weapons_components.fit"
    legacySourceFile = "data/defs/text/en_us/component_descriptions.fit"
    originalCategory = "component_descriptions"
    mechlopediaType = "component"
    role = "description"
    groupKey = "124_srm_pack"
    groupName = "124 SRM Pack"
    codeReference = "code/mechlopedia.cpp:752-760 + code/logisticscomponent.cpp:init"
    notes = "Component helpStringID / encyclopedia text; current mapping follows legacy IDS_COMPENCYCLO offset."
