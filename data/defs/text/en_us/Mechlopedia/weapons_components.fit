String {
    key = "mechlopedia.component.114_machine_gun_array.description"
    text = "Clan Gauss Rifles function on the same principles as the standard Gauss Rifle, accelerating a solid slug along electromagnetic rails to high velocities. Clan engineering improvements over the standard Gauss Rifle can be seen in the power induction system and load mechanisms, resulting in a better firing rate."
    legacyId = 34113
    legacySymbol = "IDS_COMPENCYCLO114"
    legacyKey = "legacy.mc2res.34113"
    source = "mechlopedia"
    sourceKey = "component.113.encyclopedia"
    originalKey = "mechlopedia.component.114_machine_gun_array.description"
    originalSource = "mc2res"
    sourceFile = "data/defs/text/en_us/Mechlopedia/weapons_components.fit"
    legacySourceFile = "data/defs/text/en_us/component_descriptions.fit"
