String {
    key = "mechlopedia.component.121_lr_missile_15.description"
    text = "The Inner Sphere Long-Range Missile (LRM) Rack fires missiles that can clear intervening obstacles. LRMs, when deployed as the only weaponry on a 'Mech or vehicle, can be defeated when opponents rush inside their minimum range, but when line of sight is blocked by base walls or landforms, few other weapons are so effective at finding their targets."
    legacyId = 34120
    legacySymbol = "IDS_COMPENCYCLO121"
    legacyKey = "legacy.mc2res.34120"
    source = "mechlopedia"
    sourceKey = "component.120.encyclopedia"
