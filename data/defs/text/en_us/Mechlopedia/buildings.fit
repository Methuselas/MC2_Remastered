String {
    key = "mechlopedia.building.small_fuel_tank.description"
    text = "Small Fuel Tanks dot several battle theaters. All sides in the battle for Carver V have taken great care to ensure deep redundancies in their fuel storage systems, so almost any fuel tank you encounter on the field is certain to be an attractive target with no consequences for you or your employers.\n\nThe intriguing aspect to the presence of Small Fuel Tanks is their unintended utility as spare ordnance on the field; lure opponents within range of the collateral damage of a tank, and then blast the tank for a crude incendiary device."
    paragraphCount = 2
    paragraph0 = "Small Fuel Tanks dot several battle theaters. All sides in the battle for Carver V have taken great care to ensure deep redundancies in their fuel storage systems, so almost any fuel tank you encounter on the field is certain to be an attractive target with no consequences for you or your employers."
    paragraph1 = "The intriguing aspect to the presence of Small Fuel Tanks is their unintended utility as spare ordnance on the field; lure opponents within range of the collateral damage of a tank, and then blast the tank for a crude incendiary device."
    legacyId = 45433
    legacySymbol = "IDS_BUILDING_ENCYCLO33"
    legacyKey = "legacy.mc2res.45433"
    source = "mechlopedia"
    sourceKey = "object.building.encyclo33"
    originalKey = "mechlopedia.building.small_fuel_tank.description"
    originalSource = "mc2res"
    sourceFile = "data/defs/text/en_us/Mechlopedia/buildings.fit"
    legacySourceFile = "data/defs/text/en_us/objects.fit"
    originalCategory = "objects"
    mechlopediaType = "building"
    role = "description"
    groupKey = "small_fuel_tank"
    groupName = "Small Fuel Tank"
