    legacyId = 45318
    legacySymbol = "IDS_PERONSALITY_DESCRIPTION2"
    legacyKey = "legacy.mc2res.45318"
    source = "mechlopedia"
    sourceKey = "lore.peronsality.description2"
    originalKey = "mechlopedia.personality.captain_jason_cho.description"
    originalSource = "mc2res"
    sourceFile = "data/defs/text/en_us/Mechlopedia/personalities.fit"
