{
  "schema_v": 1,
  "description": "MC2 telemetry tag registry v1. Maps every known [TAG vN] bracket to its kind, owning doc, oracle fields that must be zero, and an optional modder-facing error template. Authoritative spec: docs/superpowers/strategy/telemetry-oracle-cockpit-architecture.md S13.1.",
  "tags": [
    {
      "tag": "MECH_MATERIAL_GPU",
      "version": 1,
      "kind": "oracle",
      "gate": true,
      "oracle_fields_must_be_zero": ["mismatches"],
      "counter_fields": ["mechs", "mismatches"],
      "doc": "docs/oracle-dynamic-pipeline-gate.md",
      "notes": "Mech paint / team-color GPU path self-check. Emitted per-session-end (atexit). mismatches=0 means the fast GPU path and CPU reference agree on every mech draw."
    },
    {
      "tag": "MATERIAL_GPU",
      "version": 4,
      "kind": "oracle",
      "gate": true,
      "oracle_fields_must_be_zero": ["mismatches"],
      "counter_fields": ["emitted", "mismatches"],
      "doc": "docs/oracle-dynamic-pipeline-gate.md",
      "notes": "Material / texture bind GPU path self-check. Emitted per-session-end."
    },
    {
      "tag": "TEX_RESOLVE",
      "version": 1,
      "kind": "oracle",
      "gate": true,
      "oracle_fields_must_be_zero": ["mismatches", "oob"],
      "counter_fields": ["mismatches", "oob"],
      "doc": "docs/oracle-dynamic-pipeline-gate.md",
      "notes": "Texture-handle resolution self-check. oob=out-of-bounds slot access. Both must stay 0."
    },
    {
      "tag": "RENDER_SNAPSHOT",
      "version": 3,
      "kind": "oracle",
      "gate": true,
      "oracle_fields_must_be_zero": ["count_mismatch", "pkt_mismatch", "meta_mismatch", "fallback"],
      "counter_fields": ["count_mismatch", "pkt_mismatch", "meta_mismatch", "fallback", "using_snapshot"],
      "doc": "docs/oracle-dynamic-pipeline-gate.md",
      "notes": "Static-prop snapshot render correctness. using_snapshot=1 required. All four mismatch fields must be 0."
    },
    {
      "tag": "VISIBILITY",
      "version": 1,
      "kind": "oracle",
      "gate": true,
      "oracle_fields_must_be_zero": [],
      "oracle_fields_must_be_one": ["mech_valid", "sp_valid", "view_valid"],
      "counter_fields": ["mech_valid", "sp_valid", "view_valid"],
      "doc": "docs/oracle-dynamic-pipeline-gate.md",
      "notes": "Visibility culling validity flags. All three _valid flags must be 1."
    },
    {
      "tag": "TERRAIN_INDIRECT_PARITY",
      "version": 1,
      "kind": "oracle",
      "gate": true,
      "oracle_fields_must_be_zero": ["total_mismatches"],
      "counter_fields": ["total_mismatches"],
      "doc": "docs/oracle-dynamic-pipeline-gate.md",
      "notes": "Terrain indirect draw parity check between legacy and GPU-indirect paths. Must not break across dynamic-pipeline slices."
    },
    {
      "tag": "FX_COUNT",
      "version": 1,
      "kind": "counter",
      "gate": false,
      "counter_fields": ["total", "rDust", "lDust", "jump", "lBoom", "rBoom", "critSmoke", "smoke", "wake", "heliDust", "rArmSmoke", "lArmSmoke"],
      "event_kinds": ["init", "shutdown"],
      "doc": "docs/oracle-dynamic-pipeline-gate.md",
      "notes": "GOSFX draw-attempt counts across the 11 Mech3DAppearance::render() sites. Requires MC2_FX_COUNT_LOG=1. All zeros expected in idle 30s smokes (fly-through, no mech combat). Non-zero baseline requires mc2_17 at >= 150s.",
      "modder_text": "Effect draw counts (FX_COUNT) are zero in idle smoke runs and non-zero only when mechs are actively fighting (mc2_17 at 150s+). A site unexpectedly dropping to zero after an S2+ slice indicates an effect regression."
    },
    {
      "tag": "SCREENSHOT",
      "version": 1,
      "kind": "event",
      "gate": false,
      "counter_fields": ["frame", "path", "width", "height"],
      "event_kinds": ["capture"],
      "doc": "docs/oracle-dynamic-pipeline-gate.md",
      "notes": "Pixel oracle screenshot capture event. Emitted by gameosmain.cpp when MC2_SCREENSHOT_AT_FRAME=N triggers. Reads offscreen post-process scene FBO (RGBA16F) via glReadPixels -> TGA. Appears as a single event per run."
    },
    {
      "tag": "SNAPSHOT_BRIDGE_COMPARE",
      "version": 1,
      "kind": "oracle",
      "gate": false,
      "oracle_fields_must_be_zero": ["immutableMismatch", "rowCountMismatch", "hasCullMismatch"],
      "counter_fields": ["path", "regGen", "cullVer", "rowCount", "oracleCount", "rowCountMismatch", "immutableMismatch", "hasCullMismatch"],
      "doc": "docs/tier1_env_vars.md",
      "notes": "Static-prop snapshot bridge compare oracle. Requires MC2_STATIC_PROP_SNAPSHOT_BRIDGE_COMPARE=1. Emitted per frame with path=DIRTY|CLEAN. gate=false: advisory only until promoted per cockpit promotion rule."
    },
    {
      "tag": "FASTPATH_DROP",
      "version": 0,
      "kind": "event",
      "gate": false,
      "counter_fields": ["frame", "transition", "reason"],
      "doc": "docs/tier1_env_vars.md",
      "notes": "Terrain fast-path drop event (mclib/terrain.cpp). Unversioned tag (tag_v=0). Emitted on each fast-path state transition with reason. Env-gated diagnostic. Appears in Event Timeline.",
      "modder_text": "FASTPATH_DROP means the terrain renderer fell back from the optimized path. This is a diagnostic event; it does not cause visual regression. If you see repeated drops, check terrain complexity and LOD settings."
    },
    {
      "tag": "OBJBATCHER",
      "version": 1,
      "kind": "counter",
      "gate": false,
      "counter_fields": ["frames", "event"],
      "event_kinds": ["summary", "legacy_toggle_blocked"],
      "doc": "docs/tier1_env_vars.md",
      "notes": "Object batcher summary counter. event=summary emits per-period frame counts. event=legacy_toggle_blocked emits when a runtime toggle is rejected (gameosmain.cpp:389). Informational; no oracle fields.",
      "modder_text": "OBJBATCHER legacy_toggle_blocked means the object batcher could not switch to legacy mode at runtime. This is informational and does not affect gameplay or rendering."
    },
    {
      "tag": "GPU_CULL",
      "version": 1,
      "kind": "event",
      "gate": false,
      "counter_fields": ["event", "fallback_n2", "fallback_conservative", "readback_stale_reset"],
      "event_kinds": ["readback_ok", "lifecycle_snapshot", "motion_tolerance", "fallback_n2", "fallback_conservative", "readback_stale_reset"],
      "doc": "docs/tier1_env_vars.md",
      "notes": "GPU cull readback diagnostics (gos_static_prop_batcher.cpp). Most events require MC2_GPU_CULL_READBACK_TRACE=1. readback_stale_reset is unconditional (signals real error: 10-frame miss -> slot abandon). Appears in Event Timeline."
    },
    {
      "tag": "SPFLUSH_COST_SPLIT",
      "version": 1,
      "kind": "counter",
      "gate": false,
      "counter_fields": ["event", "submit_loop", "inst_build", "map_lookup", "color_fill", "actor_record", "world_to_block", "substrate_append", "baseinstance_upload", "invalidates", "registrations", "rebuilds", "light_writes"],
      "event_kinds": ["summary"],
      "doc": "docs/tier1_env_vars.md",
      "notes": "StaticPropRegistryFlush RDTSC cost-split decomposition. Requires MC2_STATIC_PROP_FLUSH_COST_SPLIT=1. Emits event=summary every 10 frames with per-bucket ns averages. Feeds Counter Trends panel and budget tracking.",
      "modder_text": "SPFLUSH_COST_SPLIT is a performance diagnostic for the static prop flush path. Values are per-bucket nanosecond averages. Elevated submit_loop or inst_build ns may indicate a complex or dense prop scene."
    },
